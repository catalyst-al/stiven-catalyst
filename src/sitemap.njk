---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{#- A page that asks not to be indexed (the shelf) stays out of the sitemap too. -#}
{%- if (item.url and item.url.endsWith(".html") or item.url and item.url.endsWith("/")) and not item.data.noindex %}
{#- A page without a date of its own would carry the time of the checkout that built it, which changes
    on every deploy; only content with a real date (essays, notes, projects, reflections) says when it changed. -#}
{#- A publication (an issue, the special edition, a treatise volume, in any language) says when its text last changed
    on main (online.json, from scripts/online-dates.mjs), by the slug of its address. -#}
{%- set slug = item.url.split("/").pop() | replace(".html", "") %}
  <url><loc>{{ item.url | absoluteUrl }}</loc>{% if online[slug] and "/magazine/" in item.url %}<lastmod>{{ online[slug].modified }}</lastmod>{% elif item.data.date or "/content/" in item.inputPath %}{% set editedDay = edited[item.inputPath | replace("./", "")] %}<lastmod>{{ editedDay if (editedDay and editedDay > (item.date | isoDate)) else (item.date | isoDate) }}</lastmod>{% endif %}</url>
{%- endif %}
{%- endfor %}
</urlset>

  "advice": {
    "overproduction": {
      "meaning": "U përgatit ose u nxor më shumë sesa morën mysafirët. Është humbja më e madhe dhe më e parandalueshme e bufesë.",
      "moves": [
        "Pesho mbetjet e bufesë sipas artikullit për një javë dhe cakto sasitë sipas parashikimit të mysafirëve.",
        "Në orën e fundit mbush me tava më të vogla, në vend që çdo tavë të mbahet plot deri në mbyllje.",
        "Bie dakord me kuzhinën për orën e fundit të mbushjes për çdo artikull dhe shkruaje në planin e bufesë."
      ],
      "question": "Cilin artikull e mbushim kur mysafirët e fundit kanë ngrënë tashmë?"
    },
    "spoilage": {
      "meaning": "Malli u prish para se të përdorej: ruajtja, temperatura ose rotacioni nuk u mbajtën.",
      "moves": [
        "Kontrollo sot temperaturat e frigoriferëve dhe radhën first in, first out në rafte.",
        "Porosit mallin e ndjeshëm në dorëzime më të vogla e më të shpeshta.",
        "Vendos në çdo paketim të hapur datën kur u hap."
      ],
      "question": "Ku priti malli shumë gjatë, dhe pse?"
    },
    "expiry": {
      "meaning": "Malli skadoi në stok: u porosit më shumë sesa u përdor, ose stoku i vjetër nuk u përdor i pari.",
      "moves": [
        "Krahaso sasitë e porositura me përdorimin real të katër javëve të fundit.",
        "Vendos një kontroll javor të datave për raftet me datat më të shkurtra.",
        "Oferoja mallin afër datës së skadimit me kohë kuzhinës ose një banke ushqimore."
      ],
      "question": "Pse u porosit kjo sasi, dhe kush e pa datën që po afronte?"
    },
    "damage": {
      "meaning": "Malli ose materialet u dëmtuan gjatë trajtimit: në pranim, në magazinë, në transport ose në lavanderi.",
      "moves": [
        "Shëno ku ndodh dëmi në rrjedhë dhe kontrolloje në dorëzimin e ardhshëm.",
        "Bie dakord me furnitorin për rregullin e reklamimit: dëmi i gjetur në pranim kthehet, nuk fshihet nga stoku.",
        "Tregoji ekipit mënyrën e saktë të ruajtjes dhe lëvizjes së artikujve që dëmtohen më shpesh."
      ],
      "question": "Në cilin hap ndodh dëmi, dhe çfarë do ta ndalonte?"
    },
    "wrongOrder": {
      "meaning": "U porosit ose u dorëzua diçka që nuk duhej: porosi e dyfishtë, artikull i gabuar ose sasi e gabuar.",
      "moves": [
        "Sqaro kush porosit çfarë, dhe që një person e miraton çdo porosi.",
        "Krahaso dorëzimin me porosinë në pranim dhe refuzo atë që nuk është porositur.",
        "Shkruaje rastin për takimin me furnitorin."
      ],
      "question": "Si mund ta kishte parë gabimin një person i dytë para se të vinte malli?"
    },
    "leftovers": {
      "meaning": "Ushqim që mysafirët e morën, por nuk e hëngrën. Madhësia e pjatave, porcionet dhe mënyra si shtrohet bufeja ndikojnë.",
      "moves": [
        "Provo pjata ose porcione më të vogla te artikujt që mbeten më shpesh në pjata.",
        "Vendos një tabelë të vogël te bufeja: merrni sa herë të doni.",
        "Pesho mbetjet në pjata për një javë dhe krahaso para dhe pas."
      ],
      "question": "Cilët artikuj kthehen më shpesh në pjata, dhe pse merren?"
    },
    "quality": {
      "meaning": "Malli ose gatimet nuk e plotësuan standardin dhe u refuzuan: një gatim i djegur, një dorëzim i shtypur, një pecetë me njolla.",
      "moves": [
        "Shëno për çdo refuzim pse nuk e plotësoi standardin.",

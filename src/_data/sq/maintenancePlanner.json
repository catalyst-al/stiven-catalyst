  "advice": {
    "breakdown": {
      "meaning": "E njëjta pajisje kritike ndalet herë pas here: çdo prishje kushton minutat e ndalesës dhe pakot që mbeten pas saj. Riparimet rregullojnë simptomën; shkaku mbetet aty.",
      "moves": [
        "Çoje prishjen e fundit te 5 Whys me teknikun që e riparoi, sa detajet janë ende të freskëta.",
        "Shiko planin e kësaj pajisjeje: mungon një detyrë, është shumë e rrallë, apo u krye vonë para ndalesave?",
        "Bini dakord për një kundërmasë me përgjegjës dhe afat, dhe ndiqe pajisjen për 30 ditë pas saj."
      ],
      "question": "Çfarë pamë në ditët para ndalesës së fundit, dhe kush e pa i pari?"
    },
    "overdue": {
      "meaning": "Një detyrë në një pajisje kritike e ka kaluar afatin. Çdo ditë që pret, rritet rreziku i një ndalese ose i një inspektimi të dështuar, dhe një kontroll ligjor i vonuar mund të thotë që pajisja nuk duhet përdorur.",
      "moves": [
        "Planifikoje detyrën këtë javë: një orar, një person ose furnitorin, dhe pjesët.",
        "Nëse është kontroll ligjor, vendos sot nëse pajisja mund të punojë deri atëherë, dhe shkruaje vendimin.",
        "Gjej pse mbeti pas: pa orar, pa datë nga furnitori, pa përgjegjës, dhe rregullo edhe këtë."
      ],
      "question": "Kush e ka këtë detyrë, dhe çfarë e pengoi të kryhej në afatin e saj?"
    },
    "none": {
      "meaning": "Asgjë kritike nuk është vonë, dhe asnjë pajisje kritike nuk prishet herë pas here. Mbaje ritmin.",
      "moves": [
        "Printo listën e punës të hënën dhe jepi çdo detyre përgjegjësin.",
        "Regjistro çdo detyrë ditën që kryhet, me foto aty ku ka rëndësi.",
        "Regjistro çdo prishje, edhe të shkurtrat: ato tregojnë ku planit i mungon një detyrë."
      ],
      "question": "Cila pajisje do të na dëmtonte më shumë po të ndalej sot, dhe a është plani i saj i duhuri?"
    }
  },
  "tips": [
    [
      "Një plan për çdo pajisje.",
      "Shto çdo pajisje me kodin, zonën dhe rëndësinë, dhe merr detyrat tipike të llojit të saj. Vendos datën kur u krye çdo detyrë për herë të fundit, që afatet e para të jenë të sakta."
    ],
    [
      "Data ose orë.",
      "Një detyrë ka afat pas ditësh, javësh, muajsh ose vitesh, ose pas orëve të punës, cila të vijë e para. Regjistro leximet e numëratorit dhe planifikuesi e lëviz datën sipas përdorimit të vërtetë."
    ],
    [
      "Regjistroje ditën që kryhet.",
      "E kryer, e shtyrë me arsye, ose një prishje me kohën e ndalesës: çdo regjistrim e lëviz planin. Skano kodin mbi pajisje për ta zgjedhur menjëherë."
    ],
    [
      "Zbatimi, me ndershmëri.",
      "Një detyrë llogaritet në kohë kur kryhet deri në afat, ose brenda një të dhjetës së intervalit (jo më shumë se 7 ditë). Një detyrë e shtyrë që kryhet vonë llogaritet prapë si e vonuar."
    ],
    [
      "A për kritike.",
      "Detyrat e vonuara në pajisjet A dhe prishjet e përsëritura shkojnë te lista e veprimeve; shkaqet shkojnë te Pareto, një prishje e vetme te 5 Whys."
    ]
  ],

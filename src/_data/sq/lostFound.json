  "advice": {
    "Dhoma e mysafirit": {
      "meaning": "Shumica e sendeve mbeten në dhomë: karikuesit në prizë, rrobat pas derës, gjërat në sirtarin e komodinës dhe në kasafortë. Mbrëmjen më parë mysafiri është ende në hotel; të nesërmen është në aeroport.",
      "moves": [
        "Në çdo check-out pyet: \"I keni marrë të gjitha, edhe nga kasaforta dhe prizat?\", dhe shkruaje te mbajtësja e kartës së dhomës.",
        "Pastrimi i dhomave kontrollon kasafortën, sirtarët, prizat dhe pas derës para se të hiqen çarçafët, dhe i çon sendet në recepsion brenda së njëjtës orë.",
        "Telefonoji ose shkruaji mysafirit të dhomës po atë ditë: mysafiri që merret para fluturimit e merr sendin me vete, ai që merret pas paguan postën."
      ],
      "question": "Në cilin vend të dhomës gjetëm më shumë sende këtë muaj, dhe a e përmend pyetja e check-out-it?"
    },
    "Restoranti / bari": {
      "meaning": "Syze, shalle, telefona dhe lodra në mëngjes dhe në bar: mysafiri ngrihet me nxitim për transferin. Numri i tavolinës është i vetmi tregues se kush ishte.",
      "moves": [
        "Shëno tavolinën dhe orën te sendi; në mëngjes tavolina shpesh lidhet me dhomën përmes planit të tavolinave.",
        "Ekipi i shërbimit i çon sendet në recepsion në fund të çdo shërbimi, jo në fund të javës.",
        "Vendos një shportë të vogël \"Gjetët diçka?\" te dalja e restorantit, që zbrazet në regjistër dy herë në ditë."
      ],
      "question": "Kush në ekipin e shërbimit përgjigjet për sendet e një shërbimi, dhe kur arrijnë ato në recepsion?"
    },
    "Holli / recepsioni": {
      "meaning": "Bateri të jashtme, pasaporta dhe çanta mbeten te banaku ose në divane ndërsa mysafiri pret taksinë ose transferin. Shumë nga këta mysafirë janë ende në hotel ose në aeroport një orë më vonë.",
      "moves": [
        "Kontrollo banakun, divanet dhe pikat e karikimit në çdo ndërrim turni dhe regjistro çfarë ka aty.",
        "Një pasaportë ose letërnjoftim i gjetur te banaku krahasohet së pari me mbërritjet dhe largimet e ditës.",
        "Mbaj oraret e transferit dhe të taksive pranë regjistrit: një mysafir që sapo u largua mund të gjendet ende në terminal."
      ],
      "question": "Cilat sende nga banaku mund të ishin kthyer brenda së njëjtës orë, dhe çfarë e pengoi?"
    },
    "Autobusi i transferit": {
      "meaning": "Dokumentet dhe portofolat rrëshqasin nga xhepat në transfer. Kanë vlerë të lartë dhe duan vendim të shpejtë, sepse pronari shpesh është gati të fluturojë.",
      "moves": [
        "Shoferi kontrollon ndenjëset pas çdo udhëtimi dhe telefonon menjëherë recepsionin kur gjen një dokument ose portofol.",
        "Shëno orën e udhëtimit te sendi; lista e mysafirëve të atij udhëtimi është rruga më e shpejtë te pronari.",
        "Bie dakord me zyrën e sendeve të gjetura të aeroportit si dorëzohen dokumentet e gjetura në transfer."
      ],
      "question": "Sa kohë i duhet një pasaporte të gjetur në transfer për të arritur në kasafortë, dhe kush e telefonon mysafirin?"
    },
    "default": {
      "meaning": "Një zonë jep shumicën e sendeve të gjetura. Aty një kontroll i thjeshtë para se mysafiri të largohet kursen më shumë telefonata, pako dhe vend në raft.",
      "moves": [
        "Shto një kontroll me një rresht në rutinën e asaj zone: shiko, çoje në recepsion, regjistroje.",
        "Çoji sendet në recepsion brenda një ore, me vendin dhe orën të shkruara mbi to.",
        "Shiko sërish zonën pas katër javësh: më pak sende të gjetura aty është rezultati që synohet."
      ],
      "question": "Çfarë do ta bënte mysafirin ta merrte sendin me vete para se të largohet nga kjo zonë?"
    }
  },
  "tips": [

  "noDemand": {
    "name": "Pa kërkesë",
    "policy": "Asnjë kërkesë në gjithë periudhën: kontrollo për stok të vjetruar, ktheje te furnitori, shite me ulje ose fshije nga bilanci, dhe blloko artikullin nga riporosia automatike."
  },
  "focus": {
    "reorder": {
      "meaning": "Këta artikuj kanë më pak stok se kërkesa e pritur gjatë kohës së furnizimit plus stoku i sigurisë për nivelin e shërbimit të zgjedhur. Pa një porosi tani, ka gjasa të mbarojnë para dërgesës së radhës.",
      "moves": [
        "Porosit sot artikujt A dhe kërko nga furnitori konfirmimin e datës së dërgesës.",
        "Kontrollo stokun para porosisë: një regjistrim i harruar ose një gabim numërimi e bën artikullin të duket i pakët.",
        "Për një artikull që mbetet shpesh pa stok, kontrollo kohën e furnizimit dhe kërkesën pas pikës së tij të riporosisë."
      ],
      "question": "Cili prej tyre do të ndalonte një porosi klienti ose një linjë nëse mbaron këtë javë?"
    },
    "slotting": {
      "meaning": "Artikujt AX dhe AY janë artikujt me vlerë të lartë e kërkesë të parashikueshme: u takojnë vendet më të mira të marrjes dhe kontrolli më i ngushtë.",
      "moves": [
        "Vendos artikujt AX dhe AY më të marrë në zonën e artë, në lartësinë e belit dhe më afër dërgesës.",
        "Numëro artikujt A çdo muaj dhe fillo me ata AX.",
        "Shqyrto artikujt CZ: prodhim sipas porosisë, porosi sipas kërkesës ose heqje nga lista."
      ],
      "question": "Cili artikull i shpejtë merret ende nga fundi i magazinës?"
    },
    "dead": {
      "meaning": "Artikujt pa asnjë kërkesë në gjithë periudhën zënë prapë kapital, hapësirë dhe kohë numërimi.",
      "moves": [
        "Bëj listën e artikujve pa kërkesë me vlerën e stokut dhe paraqite te prokurimi.",
        "Vendos për secilin: kthim, shitje me ulje, përdorim diku tjetër ose fshirje nga bilanci.",
        "Bllokoji nga riporosia automatike derisa të merret vendimi."
      ],
      "question": "Kush vendos çfarë ndodh me stokun që nuk ka lëvizur për një vit?"
    }
  },
  "tips": [
    [
      "Dymbëdhjetë muaj ose më shumë.",
      "Merr për çdo artikull të paktën 12 muaj ose 26 javë kërkesë: me më pak periudha koeficienti i variacionit nuk është i besueshëm dhe sezonet nuk duken."
    ],
    [
      "Kërkesa, jo hyrjet.",
      "Merr atë që morën klientët ose linjat (daljet, marrjet, shitjet), jo atë që erdhi. Një periudhë pa kërkesë është 0, jo boshllëk: lëre qelizën bosh ose shkruaj 0."
    ],
    [
      "Kufijtë janë marrëveshje.",
      "80/95 % për ABC dhe një koeficient variacioni 0,5/1,0 për XYZ janë më të përhapurit. Të tjerë përdorin 70/90 % ose 75/95 % për ABC, dhe 0,25/0,5 ose 0,2/0,5 për XYZ. Zgjidh një grup dhe mbaje, që klasat të krahasohen nga muaji në muaj."
    ],
    [
      "Stoku i sigurisë supozon kërkesë normale.",
      "Për artikujt Z dhe pjesët e këmbimit kërkesa vjen me hope, ndaj formula është vetëm orientim: përdor min/maks, porosi sipas kërkesës ose një model Poisson."
    ],
    [
      "Krahaso me pozicionin e stokut.",
      "Pika e riporosisë vlen për stokun në magazinë plus porositë e hapura minus porositë e prapambetura. Nëse ka porosi të hapura, shtoji në kolonën e stokut para importit."
    ],
    [
      "Niveli i shërbimit është për cikël.",
      "95 % do të thotë afërsisht një mungesë në njëzet cikle rimbushjeje, jo 95 % e sasisë së dorëzuar. Shumë magazina u japin artikujve A një nivel më të lartë se artikujve C."
    ]
  ],

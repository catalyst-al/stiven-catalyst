  "text": {
    "tool": "Andon Log",
    "csv": "andon-log",
    "liveLegend": "Call for help now",
    "liveNote": "Choose the station, then tap the reason. The timer runs on this device's clock; open calls stay here after a reload until they are solved.",
    "entryLegend": "Log a call after the fact",
    "entryNote": "The date is the day of the call: after midnight, the new day, as in the other logs. A time that is earlier on the clock than the call is read as the next day.",
    "responderPlaceholder": "e.g. Team lead",
    "notePlaceholder": "e.g. Sensor 3 on the conveyor dirty, cleaned",
    "pasteRow": "One row per call",
    "pastePlaceholder": "2026-10-14\tEarly\tPicking\tMissing material\t07:12\t07:14\t07:21\tTeam lead\tno\t\tPick face A-12 empty",
    "empty": "No calls in the log yet.",
    "allAreas": "All stations",
    "allReasons": "All reasons",
    "targetNote": "The targets and the escalation minutes are examples to start from, not a standard: agree your own with the team and post them where the calls are made."
  },

  "advice": {
    "quality": {
      "meaning": "Doubts about the goods or the order: the work waits until someone decides.",
      "moves": [
        "Give the team lead clear rules to decide on the spot: photo, hold area, release.",
        "Put the most frequent doubts on a one-point lesson with pictures of good and bad.",
        "Send the confirmed defects back to goods-in or the supplier the same day."
      ],
      "question": "Which decision did the operator wait for, and could the rule be at the station?"
    },
    "material": {
      "meaning": "Most calls are for material that should already be there: the replenishment signal comes too late or not at all.",
      "moves": [
        "Set a minimum at each pick face and replenish at the minimum, not when it is empty.",
        "Walk the last five calls with the replenishment driver and see where the signal was lost.",
        "Keep labels, pallets and packing material on a kanban with a visible reorder point."
      ],
      "question": "What told us the location was running empty, and why did it come after the picker got there?"
    },
    "machine": {
      "meaning": "Equipment stops the work: the fix is quick once help is there, but the same faults come back.",
      "moves": [
        "List the repeat faults by machine and give the top one a root-cause check with maintenance.",
        "Add the first checks to the start of the shift: chargers, conveyor sensors, printer heads.",
        "Keep the spare parts for the three most frequent faults at the line, with a minimum stock."
      ],
      "question": "Which fault have we fixed more than twice this month, and what would stop it for good?"
    },
    "safety": {
      "meaning": "Safety calls stop the work for a good reason; each one is a chance to remove a hazard before it hurts someone.",
      "moves": [
        "Treat every safety call as a near miss: mark it on the safety cross and look at the cause.",
        "Remove the hazard before the area starts again, and confirm it on the next walk.",
        "Tell the next shift at the start of the shift what happened and what changed."
      ],
      "question": "What would have removed this hazard before anyone had to call?"
    },
    "people": {
      "meaning": "Calls for people: a question, a gap in the staffing, or someone who does not know the task yet.",
      "moves": [
        "Check the skills matrix for the stations with the most calls and train a second person.",
        "Plan breaks and staffing against the hours when the calls peak.",
        "Answer the most frequent question once, on a card at the station."
      ],
      "question": "What did the person need to know that was not at the station?"
    },
    "it": {
      "meaning": "Scanners, printers or the system stop the floor, and nobody on the floor can fix them.",
      "moves": [
        "Agree a response time with IT for a line stop and post the number at every station.",
        "Keep charged spare scanners and a spare label printer at the shift desk.",
        "Write a one-page fallback for when the WMS is down: paper pick list, labels by hand."
      ],
      "question": "What can the floor do in the first five minutes while IT is on the way?"
    },
    "other": {
      "meaning": "Calls that fit no category: read their notes to see whether a new category is needed.",
      "moves": [
        "Read the notes of these calls and group them.",
        "Add a category when one group keeps coming back.",
        "Ask the callers what would have made the call unnecessary."
      ],
      "question": "What do these calls have in common?"
    },
    "default": {
      "meaning": "The reason with the most calls is where help is needed most often.",
      "moves": [
        "Read the notes of the calls for this reason and group them.",
        "Agree one countermeasure with the team and give it an owner and a date.",
        "Check in two weeks whether the calls for this reason have gone down."
      ],
      "question": "What would have made these calls unnecessary?"
    }
  },
  "tips": [
    [
      "Call at the first doubt.",
      "An andon call is not a complaint. A call early is cheaper than a stop later; the log shows where help is slow, not who called."
    ],
    [
      "Press Help arrived when someone is there.",
      "Time to respond runs from the call to help on site; time to solve runs to the moment the work runs again."
    ],
    [
      "Agree the escalation with the team.",
      "Who is called after how many minutes: the defaults are examples. Set your own and post them at the board."
    ],
    [
      "Look at the hours, not only the reasons.",
      "The heat map shows when calls pile up: the start of a shift, before the trucks leave, after the breaks."
    ]
  ],

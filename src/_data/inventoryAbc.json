  "cells": {
    "AX": {
      "name": "High value, steady",
      "policy": "Tight control: forecast from the history, replenish often in small lots (kanban, JIT or vendor-managed), keep the safety stock low and review it monthly.",
      "slot": "golden zone, waist height, nearest dispatch"
    },
    "AY": {
      "name": "High value, variable",
      "policy": "Close control with the trend and season in the forecast; review the safety stock monthly and agree the peaks with the supplier.",
      "slot": "golden zone, nearest dispatch"
    },
    "AZ": {
      "name": "High value, erratic",
      "policy": "Do not stock on speculation: order to demand or to a firm project, agree short lead times, and keep a small, reviewed safety stock only where a stock-out stops the operation.",
      "slot": "secure, easy-to-reach locations near the golden zone"
    },
    "BX": {
      "name": "Medium value, steady",
      "policy": "Automatic replenishment at the reorder point or a fixed review cycle, with a moderate safety stock.",
      "slot": "fast-mover zone next to the golden zone"
    },
    "BY": {
      "name": "Medium value, variable",
      "policy": "Periodic review with a seasonal forecast and a normal safety stock; check the parameters each quarter.",
      "slot": "standard racking, middle levels"
    },
    "BZ": {
      "name": "Medium value, erratic",
      "policy": "Order on demand where the lead time allows; otherwise min/max with a small buffer, reviewed each quarter.",
      "slot": "standard racking"
    },
    "CX": {
      "name": "Low value, steady",
      "policy": "Keep it simple: large order quantities, two-bin or kanban, few orders a year and as little administration as possible.",
      "slot": "standard racking, or two-bin at the point of use"
    },
    "CY": {
      "name": "Low value, variable",
      "policy": "A generous safety stock is cheap here: order rarely and in large lots, and spend no planning time on it.",
      "slot": "upper levels or the back of the warehouse"
    },
    "CZ": {
      "name": "Low value, erratic",
      "policy": "Consider make-to-order, ordering on demand or delisting; do not hold a safety stock by formula.",
      "slot": "upper levels or the back of the warehouse"
    }
  },
  "noDemand": {
    "name": "No demand",
    "policy": "No demand in the whole period: check for obsolete stock, return it to the supplier, sell it off or write it off, and block the SKU from automatic reordering."
  },
  "focus": {
    "reorder": {
      "meaning": "These SKUs hold less than the demand expected over their lead time plus the safety stock for the chosen service level. Without an order now they are likely to run out before the next delivery.",
      "moves": [
        "Order the A SKUs today and confirm the delivery date with the supplier.",
        "Check the stock figure before ordering: a missed booking or a count error can make a SKU look short.",
        "For a SKU that runs short again and again, check its lead time and the demand behind its reorder point."
      ],
      "question": "Which of these would stop a customer order or a line if it ran out this week?"
    },
    "slotting": {
      "meaning": "AX and AY SKUs are the high-value movers with predictable demand: they deserve the best pick faces and the tightest control.",
      "moves": [
        "Move the most picked AX and AY SKUs into the golden zone, at waist height and nearest dispatch.",
        "Count the A SKUs every month and start with the AX ones.",
        "Review the CZ SKUs: make-to-order, order on demand or delist."
      ],
      "question": "Which fast mover is still picked from the far end of the warehouse?"
    },
    "dead": {
      "meaning": "SKUs without any demand in the whole period still tie up capital, space and counting time.",
      "moves": [
        "List the SKUs without demand with their stock value and show the list to purchasing.",
        "Agree for each one: return, sell off, use elsewhere or write off.",
        "Block them from automatic reordering until the decision is made."
      ],
      "question": "Who decides what happens to stock that has not moved for a year?"
    }
  },
  "tips": [
    [
      "Twelve months or more.",
      "Use at least 12 months or 26 weeks of demand per SKU: with fewer periods the CV is unreliable and the seasons stay invisible."
    ],
    [
      "Demand, not receipts.",
      "Use what customers or lines took (issues, picks, sales), not what arrived. A period without demand is a 0, not a gap: leave the cell empty or write 0."
    ],
    [
      "The cut-offs are conventions.",
      "80/95 % for ABC and a CV of 0.5/1.0 for XYZ are the most common. Others use 70/90 % or 75/95 % for ABC, and a CV of 0.25/0.5 or 0.2/0.5 for XYZ. Pick one set and keep it, so the classes compare from month to month."
    ],
    [
      "Safety stock assumes normal demand.",
      "For Z SKUs and spare parts the demand is lumpy, so the formula is only a guide: use min/max, order on demand or a Poisson model there."
    ],
    [
      "Compare with the inventory position.",
      "The reorder point is meant for stock on hand plus open orders minus backorders. If orders are open, add them to the stock column before you import."
    ],
    [
      "The service level is per cycle.",
      "95 % means a stock-out in about one replenishment cycle in twenty, not 95 % of the units delivered. Many stores give A SKUs a higher level than C SKUs."
    ]
  ],

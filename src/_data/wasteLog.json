  "advice": {
    "overproduction": {
      "meaning": "More was prepared or put out than the guests took. It is the largest and the most preventable loss of a buffet.",
      "moves": [
        "Weigh the buffet waste by item for one week and set the batch sizes from the covers forecast.",
        "Refill in smaller trays in the last hour instead of keeping every tray full until closing.",
        "Agree the cut-off time for each refill with the kitchen and write it on the buffet plan."
      ],
      "question": "Which item do we refill after the last guests have already eaten?"
    },
    "spoilage": {
      "meaning": "Goods went off before use: storage, temperature or rotation did not hold.",
      "moves": [
        "Check the fridge temperatures and the first-in, first-out order on the shelves today.",
        "Order delicate goods in smaller, more frequent deliveries.",
        "Give each opened pack a label with the date it was opened."
      ],
      "question": "Where did the goods wait too long, and why?"
    },
    "expiry": {
      "meaning": "Goods passed their date in stock: more was ordered than used, or older stock was not used first.",
      "moves": [
        "Compare the order quantities with the real use of the last four weeks.",
        "Put a weekly date check on the shelves with the shortest dates.",
        "Offer goods close to their best-before date to the kitchen or to a food bank in time."
      ],
      "question": "Why was this quantity ordered, and who saw the date coming?"
    },
    "damage": {
      "meaning": "Goods or equipment were damaged in handling: at goods-in, in storage, in transport or in the laundry.",
      "moves": [
        "Note where in the flow the damage happens and check it at the next delivery.",
        "Agree the claim rule with the supplier: damage found at goods-in goes back, it is not written off.",
        "Show the team the correct way to store and move the items that break most."
      ],
      "question": "At which step does the damage happen, and what would stop it?"
    },
    "wrongOrder": {
      "meaning": "Something was ordered or delivered that was not needed: a double order, a wrong item or a wrong quantity.",
      "moves": [
        "Check who orders what, and that one person approves each order.",
        "Check the delivery against the order at goods-in, and refuse what was not ordered.",
        "Write the case down for the supplier review."
      ],
      "question": "How could a second person have seen the mistake before the goods arrived?"
    },
    "leftovers": {
      "meaning": "Food the guests took but did not eat. It is shaped by plate sizes, portions and how the buffet is laid out.",
      "moves": [
        "Try smaller plates or smaller portions of the items most left on plates.",
        "Put a small sign at the buffet: take as often as you like.",
        "Weigh the plate waste for a week and compare before and after."
      ],
      "question": "Which items come back most on the plates, and why are they taken?"
    },
    "quality": {
      "meaning": "Goods or dishes did not meet the standard and were rejected: a burnt batch, a bruised delivery, a stained napkin.",
      "moves": [
        "Write down why each reject failed the standard.",
        "Check the recipe, the holding time or the delivery specification behind the most frequent reject.",
        "Agree with the supplier what is returned and credited."
      ],
      "question": "What failed the standard, and where did it start?"
    },
    "other": {
      "meaning": "The reason is not one of the usual ones. A large share of other means the reasons need a closer look.",
      "moves": [
        "Read the notes of these entries and group them.",
        "Add a reason to the list if one keeps coming back.",
        "Take the largest item to 5 Whys."
      ],
      "question": "What do these entries have in common?"
    },
    "default": {
      "meaning": "One reason gives most of the lost value. Removing its cause saves more than handling each entry well.",
      "moves": [
        "Take the top reason to 5 Whys with the team that owns it.",
        "Agree one change with an owner and a date in the Action Tracker.",
        "Compare the value per day with the target again in four weeks."
      ],
      "question": "What would have to change so that this waste does not happen at all?"
    }
  },
  "tips": [
    [
      "Weigh it, do not guess.",
      "A scale at the buffet and in the kitchen is the start: the log is only as good as the weights in it."
    ],
    [
      "Value it at purchase cost.",
      "Quantity × unit cost gives the value. Use what the goods cost to buy, from your invoices, so the figure holds up."
    ],
    [
      "Enter the covers of the day.",
      "Grams per cover makes a full Saturday and a quiet Tuesday comparable. Days without covers are left out of that figure."
    ],
    [
      "A night shift after midnight",
      "logs on the new day, as in the other logs: the date is the day the waste was found."
    ],
    [
      "Prevention first.",
      "Donated and composted is better than residual waste, but the waste that is never made saves the most."
    ]
  ],

{
  "storageKey": "sc-site-compare",
  "periods": [
    {
      "key": "last7",
      "label": "Last 7 days"
    },
    {
      "key": "last30",
      "label": "Last 30 days"
    },
    {
      "key": "thisMonth",
      "label": "This month"
    },
    {
      "key": "lastMonth",
      "label": "Last month"
    }
  ],
  "groups": {
    "quality": "Quality",
    "delivery": "Delivery",
    "equipment": "Equipment and maintenance",
    "workplace": "Workplace",
    "safety": "Safety",
    "actions": "Actions and improvement",
    "hotel": "Hotel"
  },
  "kpis": {
    "damageRate": {
      "label": "Damage rate",
      "detail": "{units} damaged of {volume}",
      "sample": "{n} units"
    },
    "damageUnits": {
      "label": "Damaged units"
    },
    "incompleteRate": {
      "label": "Incomplete rate",
      "detail": "{units} incomplete of {volume}",
      "sample": "{n} orders"
    },
    "incompleteUnits": {
      "label": "Incomplete orders"
    },
    "onTime": {
      "label": "Routes on time",
      "detail": "{late} late of {routes}",
      "sample": "{n} routes"
    },
    "lateRoutes": {
      "label": "Late routes"
    },
    "oee": {
      "label": "OEE (all machines)",
      "detail": "{entries} shifts · machines: {machines}",
      "sample": "{n} shifts"
    },
    "fiveS": {
      "label": "5S average score",
      "detail": "audits: {audits}",
      "sample": "{n} audits"
    },
    "accidents": {
      "label": "Accidents"
    },
    "firstAid": {
      "label": "First aid cases"
    },
    "nearMisses": {
      "label": "Near misses and unsafe acts"
    },
    "daysSince": {
      "label": "Days since the last accident"
    },
    "openActions": {
      "label": "Open actions"
    },
    "overdueActions": {
      "label": "Overdue actions"
    },
    "kaizenDone": {
      "label": "Kaizen ideas done"
    },
    "pm": {
      "label": "PM compliance",
      "detail": "{onTime} of {scheduled} on time",
      "sample": "{n} tasks due"
    },
    "pmOverdue": {
      "label": "Overdue maintenance tasks"
    },
    "firstPass": {
      "label": "Rooms passed first time",
      "detail": "{firstPass} of {first}",
      "sample": "{n} rooms"
    },
    "complaintsPer100": {
      "label": "Complaints per 100 occupied room nights",
      "detail": "{complaints} of {nights} room nights",
      "sample": "{n} room nights"
    },
    "complaints": {
      "label": "Guest complaints"
    }
  },
  "prompt": {
    "title": "What the best site does differently",
    "lead": "{best} leads on “{kpi}”: {bestValue}, against {worstValue} at {worst}.",
    "ask": "Go and see before you compare people: walk {best}'s floor with the lead of {worst}, write down what they do differently in a Gemba Walk, and put the practice that travels on the Kaizen Board.",
    "none": "The sites have no rate in common for this period yet. Update them, or choose a longer period."
  },
  "summary": {
    "title": "Site comparison",
    "ranking": "Ranking"
  },
  "tips": [
    [
      "Ask for the read-only code.",
      "Each site makes it in Team Sync (box “All your work in one file” → “Create a read-only code”) and sends it to you. You read its shared tools; you do not join the team and cannot change anything."
    ],
    [
      "Never a team code.",
      "The six words let whoever holds them change a team's work. This page refuses them and does not keep them."
    ],
    [
      "Update every Monday.",
      "“Update all sites” reads each site's latest team copy and keeps only the figures. A site that changed its code has to send you its new read-only code."
    ],
    [
      "Compare rates, then go and see.",
      "Rates and averages are ranked; counts are not, because they grow with the size of a site. The best site on a rate is where to learn, not a verdict on the others."
    ]
  ],

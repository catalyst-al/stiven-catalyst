  "advice": {
    "breakdown": {
      "meaning": "Dieselbe kritische Anlage steht immer wieder: Jede Störung kostet die Minuten des Stillstands und die Pakete, die sich dahinter stauen. Reparaturen beheben das Symptom; die Ursache bleibt.",
      "moves": [
        "Nehmen Sie die letzte Störung mit dem Techniker, der sie behoben hat, in die 5 Whys, solange die Details frisch sind.",
        "Prüfen Sie den Plan dieser Anlage: Fehlt eine Aufgabe, ist sie zu selten, oder wurde sie vor den Stillständen zu spät erledigt?",
        "Vereinbaren Sie eine Gegenmaßnahme mit Verantwortlichem und Termin, und beobachten Sie die Anlage danach 30 Tage lang."
      ],
      "question": "Was haben wir in den Tagen vor dem letzten Stillstand gesehen, und wer hat es zuerst gesehen?"
    },
    "overdue": {
      "meaning": "Eine Aufgabe an einer kritischen Anlage ist über ihrem Termin. Mit jedem Tag wächst das Risiko eines Stillstands oder einer nicht bestandenen Prüfung, und eine überfällige Prüfpflicht kann bedeuten, dass die Anlage nicht benutzt werden darf.",
      "moves": [
        "Planen Sie die Aufgabe in dieser Woche ein: ein Zeitfenster, eine Person oder den Lieferanten, und die Teile.",
        "Ist es eine Prüfpflicht, entscheiden Sie heute, ob die Anlage bis dahin laufen darf, und halten Sie die Entscheidung schriftlich fest.",
        "Finden Sie heraus, warum sie liegen geblieben ist: kein Zeitfenster, kein Termin beim Lieferanten, niemand verantwortlich, und beheben Sie auch das."
      ],
      "question": "Wem gehört diese Aufgabe, und was hat verhindert, dass sie zum Termin erledigt wurde?"
    },
    "none": {
      "meaning": "Nichts Kritisches ist überfällig, und keine kritische Anlage fällt immer wieder aus. Halten Sie den Rhythmus.",
      "moves": [
        "Drucken Sie am Montag die Arbeitsliste und geben Sie jeder Aufgabe einen Verantwortlichen.",
        "Erfassen Sie jede Aufgabe an dem Tag, an dem sie erledigt ist, mit einem Foto, wo es zählt.",
        "Erfassen Sie jede Störung, auch die kurzen: Sie zeigen, wo dem Plan eine Aufgabe fehlt."
      ],
      "question": "Welche Anlage würde uns am meisten schaden, wenn sie heute ausfällt, und stimmt ihr Plan?"
    }
  },
  "tips": [
    [
      "Ein Plan für jede Anlage.",
      "Erfassen Sie jede Anlage mit Kennung, Bereich und Kritikalität, und übernehmen Sie die typischen Aufgaben ihres Typs. Tragen Sie ein, wann jede Aufgabe zuletzt erledigt wurde, damit die ersten Fälligkeiten stimmen."
    ],
    [
      "Datum oder Stunden.",
      "Eine Aufgabe ist nach Tagen, Wochen, Monaten oder Jahren fällig oder nach Betriebsstunden, je nachdem, was zuerst kommt. Erfassen Sie Zählerstände, und der Planer verschiebt den Termin nach der tatsächlichen Nutzung."
    ],
    [
      "Am Tag der Erledigung erfassen.",
      "Erledigt, verschoben mit Grund oder eine Störung mit ihrer Ausfallzeit: Jeder Eintrag bewegt den Plan. Scannen Sie die Kennung an der Anlage, um sie sofort zu wählen."
    ],
    [
      "Ehrliche Erfüllung.",
      "Eine Aufgabe gilt als pünktlich, wenn sie bis zum Fälligkeitsdatum erledigt ist oder innerhalb eines Zehntels ihres Intervalls (höchstens 7 Tage). Eine verschobene Aufgabe, die zu spät erledigt wird, zählt trotzdem als verspätet."
    ],
    [
      "A für kritisch.",
      "Überfällige Aufgaben an A-Anlagen und wiederholte Störungen gehen in die Maßnahmenliste; die Ursachen gehen in Pareto, eine einzelne Störung in die 5 Whys."
    ]
  ],

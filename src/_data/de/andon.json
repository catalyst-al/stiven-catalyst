  "advice": {
    "quality": {
      "meaning": "Zweifel an der Ware oder am Auftrag: Die Arbeit wartet, bis jemand entscheidet.",
      "moves": [
        "Geben Sie der Teamleitung klare Regeln, um vor Ort zu entscheiden: Foto, Sperrfläche, Freigabe.",
        "Stellen Sie die häufigsten Zweifel in einer Einpunktlektion mit Bildern von Gut und Schlecht dar.",
        "Melden Sie bestätigte Fehler noch am selben Tag an den Wareneingang oder den Lieferanten zurück."
      ],
      "question": "Auf welche Entscheidung hat der Mitarbeiter gewartet, und könnte die Regel an der Station hängen?"
    },
    "material": {
      "meaning": "Die meisten Rufe gelten Material, das schon da sein sollte: Das Nachschubsignal kommt zu spät oder gar nicht.",
      "moves": [
        "Legen Sie an jedem Pickplatz einen Mindestbestand fest und füllen Sie beim Minimum nach, nicht erst, wenn er leer ist.",
        "Gehen Sie die letzten fünf Rufe mit dem Nachschubfahrer ab und sehen Sie, wo das Signal verloren ging.",
        "Führen Sie Etiketten, Paletten und Packmaterial über ein Kanban mit sichtbarem Meldebestand."
      ],
      "question": "Was hat uns gezeigt, dass der Platz leer wird, und warum kam es erst, als der Kommissionierer schon dort war?"
    },
    "machine": {
      "meaning": "Geräte halten die Arbeit an: Die Behebung geht schnell, sobald Hilfe da ist, aber dieselben Störungen kommen wieder.",
      "moves": [
        "Listen Sie die wiederkehrenden Störungen je Gerät auf und lassen Sie die häufigste mit der Instandhaltung auf die Ursache prüfen.",
        "Nehmen Sie die ersten Prüfungen in den Schichtbeginn auf: Ladegeräte, Sensoren am Förderband, Druckköpfe.",
        "Halten Sie die Ersatzteile für die drei häufigsten Störungen an der Linie vor, mit Mindestbestand."
      ],
      "question": "Welche Störung haben wir diesen Monat mehr als zweimal behoben, und was würde sie dauerhaft abstellen?"
    },
    "safety": {
      "meaning": "Sicherheitsrufe halten die Arbeit aus gutem Grund an; jeder ist eine Gelegenheit, eine Gefahr zu beseitigen, bevor jemand verletzt wird.",
      "moves": [
        "Behandeln Sie jeden Sicherheitsruf als Beinaheunfall: Tragen Sie ihn ins Sicherheitskreuz ein und suchen Sie die Ursache.",
        "Beseitigen Sie die Gefahr, bevor der Bereich wieder anläuft, und bestätigen Sie es beim nächsten Rundgang.",
        "Sagen Sie der nächsten Schicht zu Schichtbeginn, was passiert ist und was sich geändert hat."
      ],
      "question": "Was hätte diese Gefahr beseitigt, bevor jemand rufen musste?"
    },
    "people": {
      "meaning": "Rufe nach Personal: eine Frage, eine Lücke in der Besetzung oder jemand, der die Aufgabe noch nicht kennt.",
      "moves": [
        "Prüfen Sie die Qualifikationsmatrix für die Stationen mit den meisten Rufen und lernen Sie eine zweite Person an.",
        "Planen Sie Pausen und Besetzung nach den Stunden, in denen die Rufe am häufigsten sind.",
        "Beantworten Sie die häufigste Frage einmal, auf einer Karte an der Station."
      ],
      "question": "Was musste die Person wissen, das nicht an der Station zu finden war?"
    },
    "it": {
      "meaning": "Scanner, Drucker oder das System halten die Fläche an, und niemand auf der Fläche kann sie reparieren.",
      "moves": [
        "Vereinbaren Sie mit der IT eine Reaktionszeit für einen Linienstopp und hängen Sie die Nummer an jeder Station aus.",
        "Halten Sie geladene Ersatzscanner und einen Ersatz-Etikettendrucker am Schichtbüro bereit.",
        "Schreiben Sie eine einseitige Notfallregel für den Ausfall des LVS: Pickliste auf Papier, Etiketten von Hand."
      ],
      "question": "Was kann die Fläche in den ersten fünf Minuten tun, während die IT unterwegs ist?"
    },
    "other": {
      "meaning": "Rufe, die in keine Kategorie passen: Lesen Sie die Notizen, um zu sehen, ob eine neue Kategorie nötig ist.",
      "moves": [
        "Lesen Sie die Notizen dieser Rufe und fassen Sie sie in Gruppen zusammen.",
        "Legen Sie eine Kategorie an, wenn eine Gruppe immer wiederkommt.",
        "Fragen Sie die Rufenden, was den Ruf unnötig gemacht hätte."
      ],
      "question": "Was haben diese Rufe gemeinsam?"
    },
    "default": {
      "meaning": "Der Grund mit den meisten Rufen zeigt, wo am häufigsten Hilfe nötig ist.",
      "moves": [
        "Lesen Sie die Notizen der Rufe zu diesem Grund und fassen Sie sie in Gruppen zusammen.",
        "Vereinbaren Sie mit dem Team eine Gegenmaßnahme und geben Sie ihr eine verantwortliche Person und ein Datum.",
        "Prüfen Sie nach zwei Wochen, ob die Rufe zu diesem Grund zurückgegangen sind."
      ],
      "question": "Was hätte diese Rufe unnötig gemacht?"
    }
  },
  "tips": [
    [
      "Rufen Sie beim ersten Zweifel.",
      "Ein Andon-Ruf ist keine Beschwerde. Ein früher Ruf ist billiger als ein späterer Stillstand; das Protokoll zeigt, wo Hilfe langsam ist, nicht, wer gerufen hat."
    ],
    [
      "Drücken Sie „Hilfe vor Ort“, sobald jemand da ist.",
      "Die Reaktionszeit läuft vom Ruf bis zur Hilfe vor Ort, die Lösungszeit bis zu dem Moment, in dem die Arbeit wieder läuft."
    ],
    [
      "Legen Sie die Eskalation mit dem Team fest.",

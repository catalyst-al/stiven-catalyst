  "advice": {
    "overproduction": {
      "meaning": "Es wurde mehr zubereitet oder ausgegeben, als die Gäste genommen haben. Das ist der größte und am besten vermeidbare Verlust am Buffet.",
      "moves": [
        "Wiegen Sie den Buffetabfall eine Woche lang je Artikel und legen Sie die Mengen nach der Gästeprognose fest.",
        "Füllen Sie in der letzten Stunde in kleineren Schalen nach, statt jede Schale bis zum Ende voll zu halten.",
        "Vereinbaren Sie mit der Küche die letzte Nachfüllzeit je Artikel und schreiben Sie sie in den Buffetplan."
      ],
      "question": "Welchen Artikel füllen wir nach, wenn die letzten Gäste schon gegessen haben?"
    },
    "spoilage": {
      "meaning": "Ware ist vor der Verwendung verdorben: Lagerung, Temperatur oder Rotation haben nicht gehalten.",
      "moves": [
        "Prüfen Sie heute die Kühltemperaturen und die Reihenfolge First in, first out in den Regalen.",
        "Bestellen Sie empfindliche Ware in kleineren, häufigeren Lieferungen.",
        "Versehen Sie jede geöffnete Packung mit dem Öffnungsdatum."
      ],
      "question": "Wo hat die Ware zu lange gewartet, und warum?"
    },
    "expiry": {
      "meaning": "Ware ist im Bestand abgelaufen: Es wurde mehr bestellt als verbraucht, oder ältere Ware wurde nicht zuerst verwendet.",
      "moves": [
        "Vergleichen Sie die Bestellmengen mit dem tatsächlichen Verbrauch der letzten vier Wochen.",
        "Führen Sie für die Regale mit den kürzesten Daten eine wöchentliche Datumskontrolle ein.",
        "Bieten Sie Ware kurz vor dem Mindesthaltbarkeitsdatum rechtzeitig der Küche oder einer Tafel an."
      ],
      "question": "Warum wurde diese Menge bestellt, und wer hat das Datum kommen sehen?"
    },
    "damage": {
      "meaning": "Ware oder Material wurde beim Handling beschädigt: im Wareneingang, im Lager, beim Transport oder in der Wäscherei.",
      "moves": [
        "Notieren Sie, an welcher Stelle im Ablauf der Schaden entsteht, und prüfen Sie sie bei der nächsten Lieferung.",
        "Vereinbaren Sie mit dem Lieferanten die Reklamationsregel: Schaden im Wareneingang geht zurück und wird nicht abgeschrieben.",
        "Zeigen Sie dem Team, wie die am häufigsten beschädigten Artikel richtig gelagert und bewegt werden."
      ],
      "question": "Bei welchem Schritt entsteht der Schaden, und was würde ihn verhindern?"
    },
    "wrongOrder": {
      "meaning": "Es wurde etwas bestellt oder geliefert, das nicht gebraucht wurde: eine Doppelbestellung, ein falscher Artikel oder eine falsche Menge.",
      "moves": [
        "Klären Sie, wer was bestellt, und dass eine Person jede Bestellung freigibt.",
        "Gleichen Sie die Lieferung im Wareneingang mit der Bestellung ab und nehmen Sie nicht Bestelltes nicht an.",
        "Halten Sie den Fall für das Lieferantengespräch fest."
      ],
      "question": "Wie hätte eine zweite Person den Fehler sehen können, bevor die Ware kam?"
    },
    "leftovers": {
      "meaning": "Essen, das die Gäste genommen, aber nicht gegessen haben. Tellergröße, Portionen und der Aufbau des Buffets bestimmen es mit.",
      "moves": [
        "Testen Sie kleinere Teller oder kleinere Portionen bei den Artikeln, die am häufigsten liegen bleiben.",
        "Stellen Sie ein kleines Schild ans Buffet: Nehmen Sie gern mehrmals.",
        "Wiegen Sie die Tellerreste eine Woche lang und vergleichen Sie vorher und nachher."
      ],
      "question": "Welche Artikel kommen am häufigsten auf den Tellern zurück, und warum werden sie genommen?"
    },
    "quality": {
      "meaning": "Ware oder Speisen haben den Standard nicht erfüllt und wurden aussortiert: eine verbrannte Charge, eine gedrückte Lieferung, eine fleckige Serviette.",
      "moves": [
        "Notieren Sie bei jedem Ausschuss, warum er den Standard nicht erfüllt hat.",
        "Prüfen Sie Rezeptur, Standzeit oder Lieferspezifikation hinter dem häufigsten Ausschuss.",
        "Vereinbaren Sie mit dem Lieferanten, was zurückgeht und gutgeschrieben wird."
      ],
      "question": "Was hat den Standard nicht erfüllt, und wo hat es angefangen?"
    },
    "other": {
      "meaning": "Der Grund ist keiner der üblichen. Ein großer Anteil Sonstiges heißt, dass die Gründe genauer angesehen werden müssen.",
      "moves": [
        "Lesen Sie die Notizen dieser Einträge und gruppieren Sie sie.",
        "Nehmen Sie einen Grund in die Liste auf, wenn er immer wiederkommt.",
        "Bringen Sie den größten Posten in die 5 Whys."
      ],
      "question": "Was haben diese Einträge gemeinsam?"
    },

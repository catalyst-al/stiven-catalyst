  "noDemand": {
    "name": "Kein Bedarf",
    "policy": "Kein Bedarf im ganzen Zeitraum: auf Ladenhüter prüfen, an den Lieferanten zurückgeben, abverkaufen oder abschreiben und den Artikel für die automatische Nachbestellung sperren."
  },
  "focus": {
    "reorder": {
      "meaning": "Diese Artikel haben weniger Bestand als der erwartete Bedarf über ihre Wiederbeschaffungszeit plus der Sicherheitsbestand für den gewählten Servicegrad. Ohne Bestellung jetzt laufen sie wahrscheinlich vor der nächsten Lieferung leer.",
      "moves": [
        "Bestellen Sie die A-Artikel heute und lassen Sie sich den Liefertermin vom Lieferanten bestätigen.",
        "Prüfen Sie den Bestand vor der Bestellung: Eine fehlende Buchung oder ein Zählfehler lässt einen Artikel knapp aussehen.",
        "Prüfen Sie bei einem Artikel, der immer wieder knapp wird, die Wiederbeschaffungszeit und den Bedarf hinter seinem Meldebestand."
      ],
      "question": "Welcher dieser Artikel würde einen Kundenauftrag oder eine Linie stoppen, wenn er diese Woche ausgeht?"
    },
    "slotting": {
      "meaning": "AX- und AY-Artikel sind die wertvollen Schnelldreher mit planbarem Bedarf: Sie verdienen die besten Greifplätze und die engste Steuerung.",
      "moves": [
        "Legen Sie die meistgegriffenen AX- und AY-Artikel in die goldene Zone, auf Hüfthöhe und nächst dem Versand.",
        "Zählen Sie die A-Artikel jeden Monat und beginnen Sie mit den AX-Artikeln.",
        "Prüfen Sie die CZ-Artikel: Auftragsfertigung, Bestellung auf Bedarf oder Auslistung."
      ],
      "question": "Welcher Schnelldreher wird noch am hinteren Ende des Lagers gegriffen?"
    },
    "dead": {
      "meaning": "Artikel ohne jeden Bedarf im ganzen Zeitraum binden trotzdem Kapital, Platz und Zählzeit.",
      "moves": [
        "Listen Sie die Artikel ohne Bedarf mit ihrem Bestandswert auf und legen Sie die Liste dem Einkauf vor.",
        "Vereinbaren Sie für jeden: Rückgabe, Abverkauf, Verwendung an anderer Stelle oder Abschreibung.",
        "Sperren Sie sie für die automatische Nachbestellung, bis entschieden ist."
      ],
      "question": "Wer entscheidet, was mit Bestand geschieht, der sich ein Jahr lang nicht bewegt hat?"
    }
  },
  "tips": [
    [
      "Zwölf Monate oder mehr.",
      "Nehmen Sie je Artikel mindestens 12 Monate oder 26 Wochen Bedarf: Mit weniger Perioden ist der Variationskoeffizient unzuverlässig, und die Saisons bleiben unsichtbar."
    ],
    [
      "Bedarf, nicht Zugänge.",
      "Nehmen Sie, was Kunden oder Linien entnommen haben (Abgänge, Picks, Verkäufe), nicht was angeliefert wurde. Eine Periode ohne Bedarf ist eine 0, keine Lücke: Lassen Sie die Zelle leer oder schreiben Sie 0."
    ],
    [
      "Die Grenzen sind Konventionen.",
      "80/95 % für ABC und ein Variationskoeffizient von 0,5/1,0 für XYZ sind am verbreitetsten. Andere nehmen 70/90 % oder 75/95 % für ABC und 0,25/0,5 oder 0,2/0,5 für XYZ. Wählen Sie einen Satz und bleiben Sie dabei, damit die Klassen von Monat zu Monat vergleichbar sind."
    ],
    [
      "Der Sicherheitsbestand setzt normalverteilten Bedarf voraus.",
      "Bei Z-Artikeln und Ersatzteilen ist der Bedarf sprunghaft, die Formel ist dort nur ein Anhaltspunkt: Nutzen Sie Min/Max, Bestellung auf Bedarf oder ein Poisson-Modell."
    ],
    [
      "Mit dem disponiblen Bestand vergleichen.",
      "Der Meldebestand gilt für den Lagerbestand plus offene Bestellungen minus Rückstände. Gibt es offene Bestellungen, rechnen Sie sie vor dem Import in die Bestandsspalte ein."
    ],
    [
      "Der Servicegrad gilt je Zyklus.",
      "95 % heißt etwa ein Fehlbestand in zwanzig Nachschubzyklen, nicht 95 % der gelieferten Menge. Viele Lager geben A-Artikeln einen höheren Servicegrad als C-Artikeln."
    ]
  ],

  "prompt": {
    "title": "Was der beste Standort anders macht",
    "lead": "{best} hat bei „{kpi}“ den besten Wert: {bestValue}, gegenüber {worstValue} in {worst}.",
    "ask": "Gehen Sie hin und sehen Sie selbst, bevor Sie Menschen vergleichen: Gehen Sie mit der Leitung von {worst} durch die Halle von {best}, halten Sie im Gemba Walk fest, was dort anders gemacht wird, und stellen Sie die Praxis, die sich übertragen lässt, auf das Kaizen-Board.",
    "none": "Die Standorte haben in diesem Zeitraum noch keine gemeinsame Quote. Aktualisieren Sie sie oder wählen Sie einen längeren Zeitraum."
  },
  "summary": {
    "title": "Standortvergleich",
    "ranking": "Rangfolge"
  },
  "tips": [
    [
      "Bitten Sie um den Nur-Lese-Code.",
      "Jeder Standort erstellt ihn in der Team-Synchronisierung (Box „Ihre ganze Arbeit in einer Datei“ → „Nur-Lese-Code erstellen“) und schickt ihn Ihnen. Sie lesen die geteilten Tools des Standorts; Sie treten dem Team nicht bei und können nichts ändern."
    ],
    [
      "Niemals ein Team-Code.",
      "Mit den sechs Wörtern kann jeder, der sie hat, die Arbeit eines Teams ändern. Diese Seite lehnt sie ab und speichert sie nicht."
    ],
    [
      "Jeden Montag aktualisieren.",
      "„Alle Standorte aktualisieren“ liest die neueste Teamkopie jedes Standorts und behält nur die Kennzahlen. Ein Standort, der seinen Code geändert hat, muss Ihnen seinen neuen Nur-Lese-Code schicken."
    ],
    [
      "Erst Quoten vergleichen, dann hingehen.",
      "Quoten und Durchschnitte kommen in die Rangfolge, Anzahlen nicht, weil sie mit der Größe eines Standorts wachsen. Der beste Standort bei einer Quote ist der Ort zum Lernen, kein Urteil über die anderen."
    ]
  ],

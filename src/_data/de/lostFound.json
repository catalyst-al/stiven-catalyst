  "advice": {
    "Gästezimmer": {
      "meaning": "Die meisten Sachen bleiben im Zimmer: Ladekabel in der Steckdose, Kleidung an der Tür, Dinge in der Nachttischschublade und im Safe. Am Vorabend ist der Gast noch im Haus, am nächsten Tag am Flughafen.",
      "moves": [
        "Fragen Sie bei jedem Check-out: „Haben Sie alles, auch aus dem Safe und den Steckdosen?“, und drucken Sie es auf die Schlüsselkartenhülle.",
        "Das Housekeeping prüft Safe, Schubladen, Steckdosen und die Rückseite der Tür, bevor das Zimmer abgezogen wird, und bringt Funde noch in derselben Stunde zur Rezeption.",
        "Rufen Sie den Gast des Zimmers noch am selben Tag an oder schreiben Sie ihm: Wer vor dem Flug erreicht wird, nimmt die Sache mit; wer danach erreicht wird, zahlt das Porto."
      ],
      "question": "An welcher Stelle im Zimmer haben wir diesen Monat die meisten Sachen gefunden, und nennt die Check-out-Frage sie?"
    },
    "Restaurant / Bar": {
      "meaning": "Brillen, Schals, Handys und Spielzeug beim Frühstück und in der Bar: Der Gast steht in Eile für den Shuttle auf. Die Tischnummer ist oft der einzige Hinweis darauf, wer es war.",
      "moves": [
        "Notieren Sie Tisch und Uhrzeit zur Fundsache; beim Frühstück lässt sich der Tisch oft über den Tischplan dem Zimmer zuordnen.",
        "Das Serviceteam bringt Funde am Ende jedes Service zur Rezeption, nicht am Ende der Woche.",
        "Stellen Sie am Restaurantausgang einen kleinen Korb „Etwas gefunden?“ auf, der zweimal am Tag ins Register übertragen wird."
      ],
      "question": "Wer im Serviceteam ist für die Funde eines Service verantwortlich, und wann kommen sie an der Rezeption an?"
    },
    "Lobby / Rezeption": {
      "meaning": "Powerbanks, Pässe und Taschen bleiben am Tresen oder auf den Sofas liegen, während der Gast auf Taxi oder Shuttle wartet. Viele dieser Gäste sind eine Stunde später noch im Hotel oder am Flughafen.",
      "moves": [
        "Prüfen Sie Tresen, Sofas und Ladestationen bei jedem Schichtwechsel und erfassen Sie, was dort liegt.",
        "Ein Pass oder Ausweis am Tresen wird zuerst mit den Anreisen und Abreisen des Tages abgeglichen.",
        "Halten Sie die Shuttle- und Taxizeiten neben dem Register bereit: Ein Gast, der gerade gegangen ist, ist am Terminal noch erreichbar."
      ],
      "question": "Welche Sachen vom Tresen hätten noch in derselben Stunde zurückgehen können, und was hat es verhindert?"
    },
    "Shuttlebus": {
      "meaning": "Dokumente und Geldbörsen rutschen im Shuttle aus der Tasche. Sie sind wertvoll und brauchen eine schnelle Entscheidung, weil der Eigentümer oft gleich fliegt.",
      "moves": [
        "Der Fahrer prüft die Sitze nach jeder Fahrt und ruft sofort die Rezeption an, wenn ein Dokument oder eine Geldbörse dabei ist.",
        "Notieren Sie die Fahrtzeit zur Fundsache; die Gästeliste dieser Fahrt ist der schnellste Weg zum Eigentümer.",
        "Vereinbaren Sie mit dem Fundbüro des Flughafens, wie im Shuttle gefundene Dokumente weitergegeben werden."
      ],
      "question": "Wie lange braucht ein im Shuttle gefundener Pass bis in den Safe, und wer ruft den Gast an?"
    },
    "default": {
      "meaning": "Ein Bereich liefert die meisten Funde. Dort spart eine einfache Kontrolle, bevor der Gast geht, die meisten Anrufe, Pakete und Regalplatz.",
      "moves": [
        "Nehmen Sie einen einzeiligen Check in die Routine dieses Bereichs auf: hinsehen, zur Rezeption bringen, erfassen.",
        "Bringen Sie Funde innerhalb einer Stunde zur Rezeption, mit Ort und Uhrzeit darauf.",
        "Schauen Sie sich den Bereich in vier Wochen wieder an: weniger Funde dort ist das Ziel."
      ],
      "question": "Was würde den Gast dazu bringen, die Sache mitzunehmen, bevor er diesen Bereich verlässt?"
    }
  },
  "tips": [

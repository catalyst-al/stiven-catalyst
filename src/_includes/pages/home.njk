{#- The homepage, shared by / and /de/. -#}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
{%- set noteList = collections["notes" + (lang | langSuffix)] -%}
{#- The field notes in a fixed order (oldest first) and today's place in it (partials/note-of-the-day.njk). -#}
{%- set dayNotes = noteList | chronological -%}
{%- set dayIndex = dayNotes.length | dayOfCycle -%}
{%- set highlights = (de if lang == "de" else sq).home.highlights if lang == "de" or lang == "sq" else home.highlights -%}
{%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools -%}
{%- set featured = essays | featured -%}
{#- The three newest essays besides the featured one, newest first. -#}
{%- set others = essays | except(featured) | last(3) | reverse -%}
{#- The three essays to read first, chosen by the author by slug in src/_data/homeEssays.json, each with the sentence on
    why, in this language. -#}
{%- set picks = homeEssays.essays -%}
{% include "partials/cosmos-hero.njk" %}

{#- Under the hero, a calm way in for someone new: where the writing comes from (the About page's own line) and two
    paths, the experience (Start here) or a problem at work (the tools, by role). -#}
  <section class="shell home-start" aria-labelledby="home-start-title">
    <div class="home-start-intro">
      <p class="kicker">{{ "Start here" | t(lang) }}</p>
      <h2 id="home-start-title">{{ "Ten years close to the work." | t(lang) }}</h2>
      <p>{{ "Retail and wholesale in Albania, then last-mile logistics and hotels in Germany: the places the essays and tools come from." | t(lang) }}</p>
    </div>
    <div class="home-paths">
      <a class="home-path" href="{{ '/start.html' | local(lang) }}">
        <strong>{{ "Read my experience" | t(lang) }} <span aria-hidden="true">→</span></strong>
        <span>{{ "Three essays, one tool and a field note: the first ten minutes." | t(lang) }}</span>
      </a>
      <a class="home-path" href="{{ '/tools.html' | local(lang) }}">
        <strong>{{ "Solve a work problem" | t(lang) }} <span aria-hidden="true">→</span></strong>
        <span>{{ "Pick your role and find the tool for the problem in front of you." | t(lang) }}</span>
      </a>
    </div>
  </section>

{% include "partials/note-of-the-day.njk" %}

  <div class="shell meta-strip" aria-label="{{ 'Stiven Catalyst philosophy' | t(lang) }}">
    <div><strong>{{ "Clarity" | t(lang) }}</strong><span>{{ "Understand before reacting." | t(lang) }}</span></div>
    <div><strong>{{ "People" | t(lang) }}</strong><span>{{ "Performance is lived by people." | t(lang) }}</span></div>
    <div><strong>{{ "Systems" | t(lang) }}</strong><span>{{ "Make good work repeatable." | t(lang) }}</span></div>
    <div><strong>{{ "Change" | t(lang) }}</strong><span>{{ "Turn insight into movement." | t(lang) }}</span></div>
  </div>

{%- if picks.length %}
  <section class="shell section home-picks" aria-labelledby="home-picks-title">
    <div class="section-heading">
      <div>
        <p class="kicker">{{ "Read first" | t(lang) }}</p>
        <h2 id="home-picks-title">{{ "Three essays to begin with." | t(lang) }}</h2>
      </div>
      <p>{{ "Not the newest, but three that show the work with its evidence and its limits." | t(lang) }}</p>
    </div>
    <div class="article-grid">
      {%- for pick in picks %}{% set item = (essays | bySlugs([pick.slug]))[0] %}{% if item %}
      <article class="article-card home-pick">
        <span class="card-number">{{ item.data.number }}</span>
        <div class="card-meta"><span>{{ item.data.category }}</span>{% if item.data.readingTime %}<span>{{ "{t} read" | t(lang) | replace("{t}", item.data.readingTime) }}</span>{% endif %}</div>
        <h3>{{ item.data.title }}</h3>
        <p class="home-pick-why"><span>{{ "Why this one" | t(lang) }}</span> {{ pick.why[lang or "en"] }}</p>
        <a class="text-link" href="{{ item.url }}">{{ "Read the essay" | t(lang) }} <span aria-hidden="true">→</span></a>
      </article>
      {%- endif %}{% endfor %}
    </div>
  </section>
{%- endif %}

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">{{ "Featured thinking" | t(lang) }}</p>
        <h2>{{ "From the work itself." | t(lang) }}</h2>
      </div>
      <p>{{ "Practical ideas shaped by real operations: how teams perform, where processes break and what better management can change." | t(lang) }}</p>
    </div>

    <div class="feature-grid">
      {%- if featured %}
      <article class="feature-card" data-number="{{ featured.data.number }}">
        <div class="feature-meta"><span>{{ featured.data.category }}</span>{% if featured.data.readingTime %}<span>{{ "{t} read" | t(lang) | replace("{t}", featured.data.readingTime) }}</span>{% endif %}</div>
        <div>
          <h3>{{ featured.data.title }}</h3>
          <p>{{ featured.data.teaser or featured.data.summary }}</p>
        </div>
        <a class="text-link" href="{{ featured.url }}">{{ "Read the essay" | t(lang) }} <span aria-hidden="true">→</span></a>
      </article>
      {%- endif %}

      <div class="side-stack">
        {%- for item in highlights %}
        <article class="mini-card">
          <div class="card-meta"><span>{{ item.label }}</span><span>{{ item.type }}</span></div>
          <h3>{% if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

{%- if others.length %}
  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">{{ "Latest insights" | t(lang) }}</p>
        <h2>{{ "Plain words about real work." | t(lang) }}</h2>
      </div>
      <p>{{ "No slogans. No recycled corporate language. Just clearer thinking about people, standards, accountability and execution." | t(lang) }}</p>
    </div>

    <div class="article-grid">
      {%- for item in others %}
      <article class="article-card">
        <span class="card-number">{{ item.data.number }}</span>
        <div class="card-meta"><span>{{ item.data.category }}</span></div>
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.teaser or item.data.summary }}</p>
        {%- if item.data.status == "soon" %}
        <span class="soon">{{ "Coming soon" | t(lang) }}</span>
        {%- else %}
        <a class="text-link" href="{{ item.url }}">{{ "Read more" | t(lang) }} <span aria-hidden="true">→</span></a>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </section>
{%- endif %}

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">{{ "Field notes" | t(lang) }}</p>
        <h2>{{ "Short observations. Real work." | t(lang) }}</h2>
      </div>
      <p>{{ "Smaller ideas captured close to the moment: from shifts, teams, service environments and everyday operations." | t(lang) }}</p>
    </div>

    <div class="notes-grid">
      {%- for offset in [1, 2] %}{% set note = dayNotes[(dayIndex + offset) % dayNotes.length] %}{% if note and dayNotes.length > 2 %}
      <article class="note-card" data-note-slot="{{ offset }}">
        <blockquote>{{ note.data.quote | quoted(lang) }}</blockquote>
        <time datetime="{{ note.date | isoDate }}">{{ note.date | readableDate(lang) }}</time>
      </article>
      {%- endif %}{% endfor %}
    </div>
  </section>

{#- After the writing: the tools, then who writes this and the book. #}
  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">{{ "Free tools" | t(lang) }}</p>
        <h2>{{ "Thinking you can use." | t(lang) }}</h2>
      </div>
      <p>{{ "Small tools built from the essays. They run in your browser, and your work stays on your device." | t(lang) }}</p>
    </div>

    <div class="family-index home-families">
      {%- set familyLink = "/tools.html" | local(lang) %}
      {%- include "partials/family-cards.njk" %}
    </div>
    <a class="text-link home-families-link" href="{{ '/tools.html' | local(lang) }}">{{ "See all tools" | t(lang) }} <span aria-hidden="true">→</span></a>
  </section>

{% include "partials/career-feature.njk" %}

  <section class="shell section philosophy">
    <div class="manifesto">
      <div class="manifesto-line" data-pairs>
        <span data-fit>{{ "Observation" | t(lang) }}</span>
        <span class="blue" data-fit>{{ "into insight." | t(lang) }}</span>
        <span data-fit>{{ "Insight" | t(lang) }}</span>
        <span class="red" data-fit>{{ "into action." | t(lang) }}</span>
      </div>
      <div class="manifesto-copy">
        <p>{{ "Stiven Catalyst exists to turn clearer thinking into better action." | t(lang) }}</p>
        <p>{{ "Leadership is not distance from the work. Management is not control. A KPI is not the operation. And an idea is not change until something moves." | t(lang) }}</p>
        <p>{{ "This is a place for practical thinking on leadership, operations, people and systems, grounded in real work and built to be useful." | t(lang) }}</p>
        <a class="text-link" href="{{ '/about.html' | local(lang) }}">{{ "Read the philosophy" | t(lang) }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

{% include "partials/newsletter.njk" %}

  <section class="shell cta">
    <h2>{{ "Build better systems." | t(lang) }} <span>{{ "Lead people better." | t(lang) }}</span></h2>
    <div class="cta-side">
      <p>{{ "Stiven Catalyst is an evolving archive of practical management thinking, projects and field experience." | t(lang) }}</p>
      <a class="text-link" href="{{ '/about.html' | local(lang) }}">{{ "About Stiven Catalyst" | t(lang) }} <span aria-hidden="true">→</span></a>
    </div>
  </section>
{#- The field notes of this language, one file the browser keeps (src/notes-data.njk), before the script that reads
    them: deferred scripts run in the order they stand. -#}
<script src="/js/notes-{{ lang or 'en' }}.js?v={{ dayNotes | noteDayData(lang) | stamp }}" defer></script>
<script src="{{ '/js/note-of-the-day.js' | assetUrl }}" defer></script>
<script src="{{ '/js/share.js' | assetUrl }}" defer></script>

{#- One volume of the operational treatise in its reader, shared by the three languages: the page-turning reader
    of the book (js/book.js) with the pages of the volume alive, the same markup as the print
    (print/treatise-page.njk, styled by /treatise-pages.css), so their text is drawn sharp at any size; the cover as
    a picture in the hero (magazinePages.json, made by scripts/treatise.mjs); the charts of the volume drawn again
    and moving in (js/weekly.js); and the whole text, from the same source as the print (treatise.js). Needs volume. -#}
{%- set lang = lang or "en" -%}
{%- set V = volume[lang] -%}
{%- set W = treatise[lang] -%}
{%- set L = W.labels -%}
{%- set reader = magazinePages[volume.slug][lang] -%}
{%- set cover = reader.pages[0] -%}
{%- set pdf = "/media/magazine/" + volume.slug + "/" + volume.slug + "-" + lang + ".pdf" -%}
{%- set archive = "/magazine/operational-treatise.html" | local(lang) -%}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
{%- set older = treatise.volumes | where("number", volume.number - 1) -%}
{%- set newer = treatise.volumes | where("number", volume.number + 1) -%}
{#- At the end of the reader, the next volume; after the newest one, the list of all volumes. -#}
{%- if newer -%}
{%- set onward = { url: ("/magazine/" + newer.slug + ".html") | local(lang), cover: magazinePages[newer.slug][lang].pages[0], label: L.next, title: newer[lang].heading, meta: L.volume + " " + newer.number + " · " + newer[lang].date } -%}
{%- else -%}
{%- set onward = { url: archive, label: W.short, title: L.all } -%}
{%- endif -%}
{%- set labels = {
  cover: "Cover" | t(lang),
  back: "Back cover" | t(lang),
  page: "Page {n}" | t(lang),
  pages: "Pages {a}–{b}" | t(lang),
  of: "of {total}" | t(lang),
  resume: "Continue from page {n}" | t(lang)
} -%}
  <section class="shell book-hero">
    <div class="book-hero-copy">
      <p class="eyebrow">{{ W.name }} · {{ L.volume }} {{ volume.number }} · {{ V.date }}</p>
      <h1{{ V.heading | longTitle | safe }}>{{ V.heading }}</h1>
      <p class="lede">{{ V.sub }}</p>
      <dl class="book-facts">
        <div><dt>{{ L.volume }}</dt><dd>{{ volume.number }}</dd></div>
        <div><dt>{{ L.chapters }}</dt><dd>{{ volume.chapterCount }}</dd></div>
        <div><dt>{{ L.pages }}</dt><dd>{{ volume.pageCount }}</dd></div>
        <div><dt>{{ L.sources }}</dt><dd>{{ volume.sources | length }}</dd></div>
      {%- if online[volume.slug] %}
        <div><dt>{{ "Online since" | t(lang) }}</dt><dd>{{ online[volume.slug].published | readableDate(lang) }}</dd></div>
      {%- endif %}
      </dl>
      <div class="hero-actions">
        <a class="button-primary" href="#reader" data-book-open>{{ L.open_volume }}</a>
        <a class="button-secondary" href="#text" data-book-text>{{ "Read it as text" | t(lang) }}</a>
        <a class="button-secondary" href="{{ pdf }}" download>{{ "Download PDF" | t(lang) }}</a>
      </div>
    </div>
    <a class="book-object" href="#reader" data-book-open aria-label="{{ L.open_volume }}">
      <span class="book-object-cover"><img src="{{ cover.image }}" srcset="{{ cover.image | srcsetFor }}" sizes="(max-width: 900px) min(calc(100vw - 32px), 360px), 360px" width="{{ cover.width }}" height="{{ cover.height }}" alt="" fetchpriority="high"></span>
    </a>
  </section>

  {#- The formula of the treatise, above the reader: the three layers every chapter is built in. -#}
  <section class="shell treatise-layers" aria-label="{{ L.layers }}">
    <p class="kicker">{{ W.intro.how }}</p>
    <ol class="treatise-layer-list">
      {%- for layer in W.layers %}
      <li class="treatise-layer is-{{ layer.id }}"><span class="treatise-layer-n">{{ loop.index }}</span><strong>{{ layer.h }}</strong><p>{{ layer.p }}</p></li>
      {%- endfor %}
    </ol>
  </section>

  <section class="book-stage" id="reader" aria-label="{{ L.page_by_page }}">
    <div class="book-reader is-dark" data-book data-slug="{{ volume.slug }}-{{ lang }}" data-labels="{{ labels | dump }}">
      <div class="book-viewport">
        <div class="book mr" data-book-pages>
          {%- for page in V.pages %}
          {%- set n = loop.index %}
          <div class="book-page is-live" data-page="{{ n }}">
            {%- include "print/treatise-page.njk" %}
          </div>
          {%- endfor %}
        </div>
      </div>
      {%- include "partials/book-onward.njk" %}

      <div class="book-controls" data-book-controls hidden>
        <button class="book-button" type="button" data-book-prev aria-label="{{ 'Previous page' | t(lang) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <div class="book-status">
          <p aria-live="polite"><strong data-book-where></strong> <span data-book-total></span></p>
          <p class="book-chapter" data-book-chapter></p>
          <input class="book-scrub" type="range" min="1" max="{{ volume.pageCount }}" value="1" step="1" data-book-scrub aria-label="{{ 'Go to page' | t(lang) }}">
        </div>
        <button class="book-button" type="button" data-book-next aria-label="{{ 'Next page' | t(lang) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        <div class="book-tools">
          <button class="book-chip" type="button" data-book-toc aria-expanded="false" aria-controls="book-contents">{{ "Contents" | t(lang) }}</button>
          <button class="book-chip" type="button" data-book-fullscreen hidden>{{ "Full screen" | t(lang) }}</button>
          <button class="book-chip" type="button" data-book-view data-one="{{ 'One large page' | t(lang) }}" data-two="{{ 'Two pages' | t(lang) }}" hidden>{{ "Two pages" | t(lang) }}</button>
          <button class="book-chip" type="button" data-book-zoom data-label="{{ 'The pages, enlarged' | t(lang) }}" data-close="{{ 'Close the enlarged pages' | t(lang) }}" hidden>{{ "Zoom in" | t(lang) }}</button>
          <a class="book-chip" href="{{ pdf }}" download>{{ "Download PDF" | t(lang) }}</a>
          <button class="book-chip is-accent" type="button" data-book-resume hidden></button>
          <a class="book-chip is-accent" href="#more-volumes" data-book-end hidden>{{ L.another }}</a>
        </div>
      </div>

      <nav class="book-contents" id="book-contents" data-book-contents aria-label="{{ 'Contents' | t(lang) }}" hidden>
        <ol>
          <li><button type="button" data-book-goto="{{ volume.pageOf.intro }}"><span class="book-contents-label">{{ L.volume }} {{ volume.number }}</span><span class="book-contents-title">{{ W.intro.title }}</span><span class="book-contents-page">{{ volume.pageOf.intro | pad }}</span></button></li>
          {%- for page in V.pages %}{% if page.heading %}
          <li><button type="button" data-book-goto="{{ loop.index }}"><span class="book-contents-label">{% if page.chapter %}{{ L.chapter }} {{ page.chapter.numeral }} · {{ page.layerInfo.short }}{% else %}{{ page.kicker }}{% endif %}</span><span class="book-contents-title">{{ page.heading }}</span><span class="book-contents-page">{{ loop.index | pad }}</span></button></li>
          {%- endif %}{% endfor %}
          <li><button type="button" data-book-goto="{{ volume.pageOf.sources }}"><span class="book-contents-label">{{ L.sources }}</span><span class="book-contents-title">{{ W.sourcesPage.kicker }}</span><span class="book-contents-page">{{ volume.pageOf.sources | pad }}</span></button></li>
        </ol>
      </nav>

      <p class="book-hint" data-book-hint hidden>{{ "Click or swipe a page to turn it. The arrow keys work too." | t(lang) }}</p>
    </div>
  </section>

  {#- The charts of the volume, drawn again for the screen: they move in once when they come into view. -#}
  <section class="shell weekly-glance" aria-labelledby="weekly-glance-title">
    <p class="kicker">{{ W.short }} · {{ L.volume }} {{ volume.number }}</p>
    <h2 id="weekly-glance-title">{{ L.glance }}</h2>
    <p class="weekly-glance-note">{{ L.glance_note }}</p>
    <div class="weekly-charts">
      {%- for c in V.charts %}
      <figure class="weekly-chart wk-chart wk-{{ c.type }}" data-weekly-chart>
        <figcaption><span>{{ c.kicker }}</span>{% if c.label %}<strong>{{ c.label }}</strong>{% endif %}</figcaption>
        {%- if c.type == "donut" %}
        <div class="weekly-donut">{{ c.svg | safe }}<p><strong>{{ c.n }}</strong> {{ c.t }}</p></div>
        {%- else %}
        <div class="wk-wide">{{ c.svg | safe }}</div>
        <div class="wk-narrow">{{ c.svgNarrow | safe }}</div>
        {%- endif %}
        {%- if c.note %}<p class="weekly-chart-note">{{ c.note }}</p>{% endif %}
        <p class="weekly-chart-source">{{ L.sources if c.sources > 1 else L.source }}: {{ c.sourceLine }}</p>
      </figure>
      {%- endfor %}
    </div>
  </section>

  <section class="shell book-text" id="text">
    <details data-book-details>
      <summary>
        <span class="kicker">{{ "The whole text" | t(lang) }}</span>
        <span class="book-text-title">{{ L.read_text }}</span>
        <span class="book-text-note">{{ "For reading on a small screen, searching or a screen reader. The same words, without the page design." | t(lang) }}</span>
      </summary>
      <div class="article-content book-text-body">
        {%- for page in V.pages %}
        {%- if page.type == "intro" %}
        <p class="book-text-kicker">{{ W.intro.title }}</p>
        <h2>{{ page.heading }}</h2>
        <p>{{ page.why }}</p>
        <p>{{ page.body }}</p>
        <p><em>Stiven Janaqi, {{ L.editor }}</em></p>
        <h3>{{ W.intro.how }}</h3>
        <ol>{% for layer in W.layers %}<li><strong>{{ layer.h }}.</strong> {{ layer.p }}</li>{% endfor %}</ol>
        <h3>{{ W.intro.contract }}</h3>
        <ul>{% for item in V.contract %}<li><strong>{{ item.h }}.</strong> {{ item.p }}</li>{% endfor %}</ul>
        {%- elif page.heading %}
        {%- if page.chapter and page.layer == "scene" %}

        <h2 class="book-text-chapter">{{ L.chapter }} {{ page.chapter.numeral }}: {{ page.chapter.title }}</h2>
        {%- endif %}

        <p class="book-text-kicker">{% if page.chapter %}{{ L.layer }} {{ page.layerInfo.n }} · {{ page.layerInfo.h }}{% else %}{{ page.kicker }}{% endif %}</p>
        <h2>{{ page.heading }}</h2>
        {%- if page.lead %}<p><em>{{ page.lead }}</em></p>{% endif %}
        {%- include "partials/review-text-blocks.njk" %}
        {%- if page.note %}<p><em>{{ page.note }}</em></p>{% endif %}
        {%- if page.sourceLine %}<p><small>{{ L.sources if page.source.length > 1 else L.source }}: {{ page.sourceLine }}</small></p>{% endif %}
        {%- if page.more %}{% for essay in essays %}{% if essay.fileSlug.endsWith(page.more) %}<p>{{ L.more }}: <a href="{{ essay.url }}">{{ essay.data.title }}</a></p>{% endif %}{% endfor %}{% endif %}
        {%- if page.tool %}{% set tool = toolsGuide.tool[lang][page.tool] %}<p>{{ L.open }}: <a href="{{ tool.url }}">{{ tool.name }}</a></p>{% endif %}
        {%- endif %}
        {%- endfor %}

        <p class="book-text-kicker">{{ W.sourcesPage.kicker }}</p>
        <h2>{{ W.sourcesPage.title | join(" ") }}</h2>
        <p>{{ W.sourcesPage.lead }}</p>
        <ul class="book-text-sources">{% for s in volume.sources %}<li>{{ s.by }}, {% if s.lang and s.lang != (lang or "en") %}<span lang="{{ s.lang }}">{{ s.title | softHyphens | quoted(lang) }}</span>{% else %}{{ s.title | softHyphens | quoted(lang) }}{% endif %}, {{ s.year }}{% if s.via %} ({{ L.via }} {{ s.via | inLang(lang) }}){% endif %}.{% if s.url %} <a href="{{ s.url }}" rel="noopener">{{ s.url }}</a>{% endif %}</li>{% endfor %}</ul>
        <h3>{{ W.sourcesPage.method }}</h3>
        <p>{{ W.sourcesPage.methodText }}</p>
        {%- set C = weekly[lang].colophon %}
        <p><small>{{ C.text }} <a href="{{ '/how-this-is-made.html' | local(lang) }}">{{ C.more }}</a></small></p>
      </div>
    </details>
  </section>

{#- After the volume: the one before and the one after it, and the list of all volumes. -#}
  <section class="shell issue-more" id="more-volumes" aria-labelledby="more-volumes-title">
    <p class="kicker">{{ W.short }} · {{ L.edition }}</p>
    <h2 id="more-volumes-title">{{ L.another }}</h2>
    {%- if older or newer %}
    <div class="issue-more-list">
      {%- for other in [older, newer] %}{% if other %}
      {%- set otherCover = magazinePages[other.slug][lang].pages[0] %}
      <a class="issue-more-card" href="{{ ('/magazine/' + other.slug + '.html') | local(lang) }}">
        <img src="{{ otherCover.image }}" srcset="{{ otherCover.image | srcsetFor }}" sizes="96px" width="{{ otherCover.width }}" height="{{ otherCover.height }}" alt="" loading="lazy" decoding="async">
        <span class="issue-more-copy">
          <span class="issue-more-label">{{ L.previous if other.number < volume.number else L.next }}</span>
          <span class="issue-more-title">{{ other[lang].heading }}</span>
          <span class="issue-more-meta">{{ L.volume }} {{ other.number }} · {{ other[lang].date }}</span>
        </span>
      </a>
      {%- endif %}{% endfor %}
    </div>
    {%- endif %}
    <a class="text-link" href="{{ archive }}">{{ L.all }}</a>
  </section>
<script src="{{ '/js/book.js' | assetUrl }}" defer></script>
<script src="{{ '/js/weekly.js' | assetUrl }}" defer></script>

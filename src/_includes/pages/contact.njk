{#- The Contact page, shared by both languages. -#}
<section class="shell page-hero contact-hero">
  <p class="eyebrow">{{ "Get in touch" | t(lang) }}</p>
  <h1>{{ "Contact" | t(lang) }}</h1>
  <p class="lede">{{ "Questions, ideas or a conversation about leadership, operations and systems. Messages are read personally." | t(lang) }}</p>
</section>
<section class="shell contact{% if not site.contact.action %} is-cards{% endif %}">
  {%- if site.contact.action %}
  <form class="contact-form" action="{{ site.contact.action }}" method="post">
    {%- if site.contact.key %}
    <input type="hidden" name="access_key" value="{{ site.contact.key }}">
    <input type="hidden" name="subject" value="Stiven Catalyst: {{ 'Contact' | t(lang) }}">
    <input type="hidden" name="from_name" value="Stiven Catalyst">
    {%- endif %}
    <div class="field">
      <label for="contact-name">{{ "Name" | t(lang) }}</label>
      <input id="contact-name" name="name" autocomplete="name" required>
    </div>
    <div class="field">
      <label for="contact-email">{{ "Email" | t(lang) }}</label>
      <input id="contact-email" type="email" name="email" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="contact-message">{{ "Message" | t(lang) }}</label>
      <textarea id="contact-message" name="message" rows="7" required></textarea>
    </div>
    <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button type="submit">{{ "Send message" | t(lang) }}</button>
    <p class="form-note">{{ "Your details are only used to reply to you." | t(lang) }}{% if legal.name and legal.city %} {{ "Details in the" | t(lang) }} <a href="{{ '/datenschutz.html' | local(lang) }}">{{ "privacy policy" | t(lang) }}</a>.{% endif %}</p>
  </form>
  {%- endif %}
  {#- The two ways to write: each a card with a planet, like the chips of the menu (styles.css, .contact-card). #}
  <aside class="contact-aside">
    <a class="contact-card" href="mailto:{{ site.email }}">
      <span class="contact-card-orb" aria-hidden="true"></span>
      <span class="kicker">{{ "Email" | t(lang) }}</span>
      {#- If the address must break on a narrow phone, it breaks after the @. #}
      <strong>{{ site.email | replace("@", "@<wbr>") | safe }}</strong>
      <span class="contact-card-go" aria-hidden="true">→</span>
    </a>
    <a class="contact-card" href="{{ '/your-challenge.html' | local(lang) }}">
      <span class="contact-card-orb" aria-hidden="true"></span>
      <span class="kicker">{{ "Your challenge" | t(lang) }}</span>
      <strong>{{ "Send me your situation" | t(lang) }}</strong>
      <span class="contact-card-go" aria-hidden="true">→</span>
    </a>
  </aside>
</section>

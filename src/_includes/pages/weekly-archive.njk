{#- All issues of the weekly Management Review, the newest first, each as its cover; the month of the edition and
    the topics narrow the list, twelve covers at a time (js/weekly.js). Below them, the special edition of September 2026. Shared by the three languages. -#}
{%- set lang = lang or "en" -%}
{%- set W = weekly[lang] -%}
{%- set L = W.labels -%}
{%- set A = W.archive -%}
  <section class="shell page-hero weekly-hero">
    <p class="eyebrow">{{ A.eyebrow }}</p>
    <h1>Management <span class="weekly-mark">Review</span></h1>
    <p class="lede">{{ A.lede }}</p>
    {#- The second check of 12 October, and what it changed (weekly.checked). -#}
    {%- set corrections = [{ date: W.checked.date, t: W.checked.archive, series: true }] %}
    {%- set correctionsId = "checked" %}
    {%- include "partials/book-corrections.njk" %}
  </section>

  <section class="shell weekly-archive" aria-label="{{ L.issues }}">
    {#- One month at a time, then a topic, then "show more": without the script all issues are listed. #}
    <div class="weekly-controls" data-weekly-filter data-page="12" data-shown="{{ A.shown }}" hidden>
      {%- if weekly.months | length > 1 %}
      <div class="weekly-months" role="group" aria-label="{{ A.months }}">
        {%- for m in weekly.months %}<button type="button" aria-pressed="{{ 'true' if loop.first else 'false' }}" data-month="{{ m.id }}">{{ m[lang] }}<span class="weekly-n">{{ m.count }}</span></button>{% endfor %}
      </div>
      {%- endif %}
      {%- if weekly.blocks | length > 1 %}
      <div class="weekly-filter" role="group" aria-label="{{ L.blocks }}">
        <button type="button" aria-pressed="true" data-block="">{{ A.all }}</button>
        {%- for b in weekly.blocks %}<button type="button" aria-pressed="false" data-block="{{ b.id }}">{{ b[lang] }}<span class="weekly-n"></span></button>{% endfor %}
      </div>
      {%- endif %}
    </div>
    <ol class="weekly-grid" reversed>
      {%- for issue in weekly.issues | reverse %}
      {%- set I = issue[lang] %}
      {%- set cover = magazinePages[issue.slug][lang].pages[0] %}
      <li data-block="{{ issue.block }}" data-month="{{ issue.month }}">
        <a class="weekly-card" href="{{ ('/magazine/' + issue.slug + '.html') | local(lang) }}">
          <span class="weekly-card-cover"><img src="{{ cover.image }}" srcset="{{ cover.image | srcsetFor }}" sizes="(max-width: 620px) 45vw, 220px" width="{{ cover.width }}" height="{{ cover.height }}" alt="" loading="{{ 'eager' if loop.index <= 4 else 'lazy' }}" decoding="async"></span>
          <span class="weekly-card-meta">{{ L.no }} {{ issue.no }} · {{ I.blockName }}</span>
          <strong>{{ I.heading }}</strong>
          <span class="weekly-card-date">{{ I.date }}</span>
        </a>
      </li>
      {%- endfor %}
    </ol>
    <p class="weekly-none" data-weekly-none hidden>{{ A.empty }}</p>
    <div class="weekly-more" data-weekly-more hidden>
      <p class="weekly-shown" aria-live="polite"></p>
      <button type="button" class="button-secondary">{{ A.more }}</button>
    </div>
  </section>

{#- The September edition: one of a kind, before the weekly began. -#}
{%- set R = review[lang] %}
{%- set reviewUrl = ("/magazine/" + review.slug + ".html") | local(lang) %}
{%- set reviewCover = magazinePages[review.slug][lang].pages[0] %}
  <section class="shell book-feature magazine-feature weekly-special">
    <a class="book-object" href="{{ reviewUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ reviewCover.image }}" srcset="{{ reviewCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ reviewCover.width }}" height="{{ reviewCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ R.name }} · {{ L.special }} · {{ R.date }}</p>
      <h2><a href="{{ reviewUrl }}">{{ R.theme }}</a></h2>
      <p class="book-subtitle">{{ A.special }}</p>
      <p>{{ R.feature }}</p>
      <a class="button-primary" href="{{ reviewUrl }}">{{ R.labels.open_edition }}</a>
    </div>
  </section>
<script src="{{ '/js/weekly.js' | assetUrl }}" defer></script>

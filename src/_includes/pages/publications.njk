{#- Publications: the monthly Management Review, the magazine, the book and the Tools Guide, in the three
    languages. -#}
  <section class="shell page-hero publications-hero">
    <p class="eyebrow">{{ "Books, guides, a monthly review and a magazine from the floor" | t(lang) }}</p>
    {%- set pubTitle = "Publications" | t(lang) %}
    {#- "Publications" and "Publikationen" are wider than a phone at the full hero size. #}
    <h1{% if pubTitle | length > 10 %} class="hero-long"{% endif %}>{{ pubTitle }}</h1>
    <p class="lede">{{ "Longer pieces made to be leafed through: a book about where it started, a guide to the tools, every month a review of the best management research in several issues, and a magazine from the floor." | t(lang) }}</p>
  </section>
{%- set ml = lang or "en" %}
{#- The monthly Management Review: its newest issue, and the way to all of them. -#}
{%- set WK = weekly[ml] %}
{%- set wk = weekly.latest %}
{%- set wkUrl = ("/magazine/" + wk.slug + ".html") | local(lang) %}
{%- set wkCover = magazinePages[wk.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature" id="weekly">
    <a class="book-object" href="{{ wkUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ wkCover.image }}" srcset="{{ wkCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ wkCover.width }}" height="{{ wkCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ weekly.name }} · {{ wk[ml].edition }} · {{ wk[ml].date }} · {{ WK.labels.no }} {{ wk.no }}</p>
      <h2><a href="{{ wkUrl }}">{{ wk[ml].heading }}</a></h2>
      <p class="book-subtitle">{{ WK.tagline }}</p>
      <p>{{ wk[ml].feature }}</p>
      <div class="book-feature-actions">
        <a class="button-primary" href="{{ wkUrl }}">{{ WK.labels.open_issue }}</a>
        <a class="text-link" href="{{ '/magazine/management-review.html' | local(lang) }}">{{ WK.labels.all }} ({{ weekly.issues | length }})</a>
      </div>
    </div>
  </section>
{#- The magazine: every issue the same way as the other publications, cover and text, the newest first. -#}
{%- for issue in magazine.issues | reverse %}
{%- set issueUrl = ("/magazine/" + issue.slug + ".html") | local(lang) %}
{%- set issueCover = magazinePages[issue.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature"{% if loop.first %} id="magazine"{% endif %}>
    <a class="book-object" href="{{ issueUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ issueCover.image }}" srcset="{{ issueCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ issueCover.width }}" height="{{ issueCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ magazine.names[ml].name }} · {{ magazine.labels[ml].issue }} {{ issue.number }} · {{ issue[ml].date }}</p>
      <h2><a href="{{ issueUrl }}">{{ issue[ml].theme }}</a></h2>
      <p class="book-subtitle">{{ issue[ml].themeSub }}</p>
      <p>{{ issue[ml].trend.lead }}</p>
      <a class="button-primary" href="{{ issueUrl }}">{{ "Open the issue" | t(lang) }}</a>
    </div>
  </section>
{%- endfor %}
{#- The Management Review of September 2026: the special edition before the monthly one. -#}
{%- set R = review[ml] %}
{%- set reviewUrl = ("/magazine/" + review.slug + ".html") | local(lang) %}
{%- set reviewCover = magazinePages[review.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature">
    <a class="book-object" href="{{ reviewUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ reviewCover.image }}" srcset="{{ reviewCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ reviewCover.width }}" height="{{ reviewCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ R.name }} · {{ WK.labels.special }} · {{ R.date }}</p>
      <h2><a href="{{ reviewUrl }}">{{ R.theme }}</a></h2>
      <p class="book-subtitle">{{ R.tagline }}</p>
      <p>{{ R.feature }}</p>
      <a class="button-primary" href="{{ reviewUrl }}">{{ R.labels.open_edition }}</a>
    </div>
  </section>
{% include "partials/guide-feature.njk" %}
{% include "partials/book-feature.njk" %}
{% include "partials/newsletter.njk" %}

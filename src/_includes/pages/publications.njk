{#- Publications: the monthly Management Review, its operational treatise, the magazine, the book and the Tools
    Guide, in the three languages. Above them a month and a kind narrow the page (partials/issue-filter.njk,
    src/_data/publications.js): each month shows the newest issue or volume of each series that came out in it; the
    book and the guide stay in every month. Without the script the page shows the newest of each series. -#}
  <section class="shell page-hero publications-hero">
    <p class="eyebrow">{{ "Books, guides, a monthly review, an operational treatise and a magazine from the floor" | t(lang) }}</p>
    {%- set pubTitle = "Publications" | t(lang) %}
    {#- "Publications" and "Publikationen" are wider than a phone at the full hero size. #}
    <h1{% if pubTitle | length > 10 %} class="hero-long"{% endif %}>{{ pubTitle }}</h1>
    <p class="lede">{{ "Longer pieces made to be leafed through: a book about where it started, a guide to the tools, every month a review of the best management research in several issues, an operational treatise in volumes that follow one question from the floor to the protocol, and a magazine from the floor." | t(lang) }}</p>
  </section>
{%- set ml = lang or "en" %}
{%- set P = publications[ml] %}
{%- import "partials/issue-filter.njk" as filter %}
  <section class="shell publications-filter" aria-label="{{ P.kinds }}">
    {{ filter.controls(publications.months, publications.kinds, ml, P, P.kinds, "[data-pub]") }}
  </section>
{#- The monthly Management Review: the newest issue of each month, and the way to all of them. -#}
{%- set WK = weekly[ml] %}
{%- for wk in publications.review %}
{%- set wkUrl = ("/magazine/" + wk.slug + ".html") | local(lang) %}
{%- set wkCover = magazinePages[wk.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature"{% if loop.first %} id="weekly"{% endif %} data-pub data-block="review" data-month="{{ wk.month }}"{% if not loop.first %} hidden{% endif %}>
    <a class="book-object" href="{{ wkUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ wkCover.image }}" srcset="{{ wkCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ wkCover.width }}" height="{{ wkCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ weekly.name }} · {{ wk[ml].edition }} · {{ wk[ml].date }} · {{ WK.labels.no }} {{ wk.no }}</p>
      <h2><a href="{{ wkUrl }}">{{ wk[ml].heading }}</a></h2>
      <p class="book-subtitle">{{ WK.tagline }}</p>
      <p>{{ wk[ml].feature }}</p>
      <div class="book-feature-actions">
        <a class="button-primary" href="{{ wkUrl }}">{{ WK.labels.open_issue }}</a>
        <a class="text-link" href="{{ '/magazine/management-review.html' | local(lang) }}">{{ WK.labels.all }} ({{ weekly.issues | length }})</a>
      </div>
    </div>
  </section>
{%- endfor %}
{#- The operational treatise: the newest volume of each month, and the way to all of them. -#}
{%- set TR = treatise[ml] %}
{%- for tv in publications.treatise %}
{%- set tvUrl = ("/magazine/" + tv.slug + ".html") | local(lang) %}
{%- set tvCover = magazinePages[tv.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature"{% if loop.first %} id="treatise"{% endif %} data-pub data-block="treatise" data-month="{{ tv.month }}"{% if not loop.first %} hidden{% endif %}>
    <a class="book-object" href="{{ tvUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ tvCover.image }}" srcset="{{ tvCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ tvCover.width }}" height="{{ tvCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ TR.short }} · {{ TR.labels.volume }} {{ tv.number }} · {{ tv[ml].date }}</p>
      <h2><a href="{{ tvUrl }}">{{ tv[ml].heading }}</a></h2>
      <p class="book-subtitle">{{ TR.name }}</p>
      <p>{{ tv[ml].feature }}</p>
      <div class="book-feature-actions">
        <a class="button-primary" href="{{ tvUrl }}">{{ TR.labels.open_volume }}</a>
        <a class="text-link" href="{{ '/magazine/operational-treatise.html' | local(lang) }}">{{ TR.labels.all }} ({{ treatise.volumes | length }})</a>
      </div>
    </div>
  </section>
{%- endfor %}
{#- The magazine: the newest issue of each month, and the way to all of them, the same way as the Management Review. -#}
{%- for issue in publications.floor %}
{%- set issueUrl = ("/magazine/" + issue.slug + ".html") | local(lang) %}
{%- set issueCover = magazinePages[issue.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature"{% if loop.first %} id="magazine"{% endif %} data-pub data-block="floor" data-month="{{ issue.month }}"{% if not loop.first %} hidden{% endif %}>
    <a class="book-object" href="{{ issueUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ issueCover.image }}" srcset="{{ issueCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ issueCover.width }}" height="{{ issueCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ magazine.names[ml].name }} · {{ magazine.labels[ml].issue }} {{ issue.number }} · {{ issue[ml].date }}</p>
      <h2><a href="{{ issueUrl }}">{{ issue[ml].theme }}</a></h2>
      <p class="book-subtitle">{{ issue[ml].themeSub }}</p>
      <p>{{ issue[ml].trend.lead }}</p>
      <div class="book-feature-actions">
        <a class="button-primary" href="{{ issueUrl }}">{{ "Open the issue" | t(lang) }}</a>
        <a class="text-link" href="{{ '/magazine/from-the-floor.html' | local(lang) }}">{{ magazine.archive[ml].all }} ({{ magazine.issues | length }})</a>
      </div>
    </div>
  </section>
{%- endfor %}
{#- The Management Review of September 2026: the special edition before the monthly one. -#}
{%- set R = review[ml] %}
{%- set reviewUrl = ("/magazine/" + review.slug + ".html") | local(lang) %}
{%- set reviewCover = magazinePages[review.slug][ml].pages[0] %}
  <section class="shell book-feature magazine-feature" data-pub data-block="review" data-month="{{ publications.special.month }}">
    <a class="book-object" href="{{ reviewUrl }}" tabindex="-1" aria-hidden="true">
      <span class="book-object-cover"><img src="{{ reviewCover.image }}" srcset="{{ reviewCover.image | srcsetFor }}" sizes="(max-width: 900px) 200px, 300px" width="{{ reviewCover.width }}" height="{{ reviewCover.height }}" alt="" loading="lazy"></span>
    </a>
    <div class="book-feature-copy">
      <p class="kicker">{{ R.name }} · {{ WK.labels.special }} · {{ R.date }}</p>
      <h2><a href="{{ reviewUrl }}">{{ R.theme }}</a></h2>
      <p class="book-subtitle">{{ R.tagline }}</p>
      <p>{{ R.feature }}</p>
      <a class="button-primary" href="{{ reviewUrl }}">{{ R.labels.open_edition }}</a>
    </div>
  </section>
{#- The guide and the book: not tied to a month, in every month. #}
<div data-pub data-block="books">
{% include "partials/guide-feature.njk" %}
</div>
<div data-pub data-block="books">
{% include "partials/book-feature.njk" %}
</div>
  <div class="shell publications-more">
    {{ filter.more(P) }}
  </div>
<script src="{{ '/js/weekly.js' | assetUrl }}" defer></script>
{% include "partials/newsletter.njk" %}

{#- Publications: the monthly Management Review, its operational treatise, the magazine, the book and the Tools
    Guide, in the three languages. Above them a month and a kind narrow the page (partials/issue-filter.njk,
    src/_data/publications.js): each month shows the newest issue or volume of each series that came out in it; the
    book and the guide stay in every month. Without the script the page shows the newest of each series. -#}
  <section class="shell page-hero publications-hero">
    <p class="eyebrow">{{ "Books, guides, a monthly review, an operational treatise and a magazine from the floor" | t(lang) }}</p>
    {%- set pubTitle = "Publications" | t(lang) %}
    {#- "Publications" and "Publikationen" are wider than a phone at the full hero size. #}
    <h1{% if pubTitle | length > 10 %} class="hero-long"{% endif %}>{{ pubTitle }}</h1>
    <p class="lede">{{ "Longer pieces made to be leafed through: a book about where it started, a guide to the tools, every month a review of the best management research in several issues, an operational treatise in volumes that follow one question from the floor to the protocol, and a magazine from the floor." | t(lang) }}</p>
  </section>
{%- set ml = lang or "en" %}
{%- set P = publications[ml] %}
{%- import "partials/issue-filter.njk" as filter %}
  <section class="shell publications-filter" aria-label="{{ P.kinds }}">
    {{ filter.controls(publications.months, publications.kinds, ml, P, P.kinds, "[data-pub]") }}
  </section>
{#- The publications as one list, the way Reflections lists its pieces: the date, then the series, the title and a
    line about it, and at the end of the row the cover as a small book that floats and turns towards the reader under
    the pointer. Each row keeps its month and kind (data-pub), so the month and the kind above narrow the list. -#}
{%- set WK = weekly[ml] %}
{%- set TR = treatise[ml] %}
{%- set R = review[ml] %}
{%- macro row(url, image, date, kicker, title, line, titleLang = "") %}
    <a class="list-row pub-row" href="{{ url }}">
      <span class="number">{{ date }}</span>
      <div><p class="kicker">{{ kicker }}</p><h2{{ titleLang | safe }}>{{ title }}</h2><p>{{ line }}</p></div>
      <span class="pub-thumb" aria-hidden="true"><span class="book-object-cover"><img src="{{ image.image }}" srcset="{{ image.image | srcsetFor }}" sizes="120px" width="{{ image.width }}" height="{{ image.height }}" alt="" loading="lazy"></span></span>
    </a>
{%- endmacro %}
  <section class="shell listing pub-list" aria-label="{{ 'Publications' | t(lang) }}">
{#- The monthly Management Review: the newest issue of each month. -#}
{%- for wk in publications.review %}
  <div{% if loop.first %} id="weekly"{% endif %} data-pub data-block="review" data-month="{{ wk.month }}"{% if not loop.first %} hidden{% endif %}>
{{- row(("/magazine/" + wk.slug + ".html") | local(lang), magazinePages[wk.slug][ml].pages[0], wk[ml].date, weekly.name + " · " + wk[ml].edition + " · " + WK.labels.no + " " + wk.no, wk[ml].heading, wk[ml].feature) }}
  </div>
{%- endfor %}
{#- The operational treatise: the newest volume of each month. -#}
{%- for tv in publications.treatise %}
  <div{% if loop.first %} id="treatise"{% endif %} data-pub data-block="treatise" data-month="{{ tv.month }}"{% if not loop.first %} hidden{% endif %}>
{{- row(("/magazine/" + tv.slug + ".html") | local(lang), magazinePages[tv.slug][ml].pages[0], tv[ml].date, TR.short + " · " + TR.labels.volume + " " + tv.number, tv[ml].heading, tv[ml].feature) }}
  </div>
{%- endfor %}
{#- The magazine from the floor: the newest issue of each month. -#}
{%- for issue in publications.floor %}
  <div{% if loop.first %} id="magazine"{% endif %} data-pub data-block="floor" data-month="{{ issue.month }}"{% if not loop.first %} hidden{% endif %}>
{{- row(("/magazine/" + issue.slug + ".html") | local(lang), magazinePages[issue.slug][ml].pages[0], issue[ml].date, magazine.names[ml].name + " · " + magazine.labels[ml].issue + " " + issue.number, issue[ml].theme, issue[ml].trend.lead) }}
  </div>
{%- endfor %}
{#- The Management Review of September 2026: the special edition before the monthly one. -#}
  <div data-pub data-block="review" data-month="{{ publications.special.month }}">
{{- row(("/magazine/" + review.slug + ".html") | local(lang), magazinePages[review.slug][ml].pages[0], R.date, R.name + " · " + WK.labels.special, R.theme, R.feature) }}
  </div>
{#- The guide and the book: not tied to a month, in every month. #}
{%- set book = books[ml] or books.sq %}
<div data-pub data-block="books">
{{- row("/guides/tools-guide.html" | local(lang), toolsGuidePages[ml].pages[0], "", "The guide · Edition {n}" | t(lang) | replace("{n}", toolsGuide.edition), toolsGuide[ml].title, "Why the tools are a solar system, what each family is for, and how to use every tool, step by step. Leaf through it page by page, or download the PDF." | t(lang)) }}
</div>
<div data-pub data-block="books">
{{- row("/books/mall-per-durresin.html" | local(lang), book.pages[0], "", ("The book · in Albanian" if book.language == "sq" else "The book · translated from the Albanian") | t(lang), book.title, "Seven chapters about growing up in Durrës: friends, the leaving and the coming back. Leaf through it page by page, like a real book." | t(lang), (' lang="' + book.language + '"') if book.language != ml else "") }}
</div>
  </section>
  {#- Every series has its own list of all its issues. #}
  <nav class="shell pub-archives" aria-label="{{ WK.labels.all }}">
    <a class="text-link" href="{{ '/magazine/management-review.html' | local(lang) }}">{{ weekly.name }}: {{ WK.labels.all }} ({{ weekly.issues | length }}) <span aria-hidden="true">→</span></a>
    <a class="text-link" href="{{ '/magazine/operational-treatise.html' | local(lang) }}">{{ TR.short }}: {{ TR.labels.all }} ({{ treatise.volumes | length }}) <span aria-hidden="true">→</span></a>
    <a class="text-link" href="{{ '/magazine/from-the-floor.html' | local(lang) }}">{{ magazine.names[ml].name }}: {{ magazine.archive[ml].all }} ({{ magazine.issues | length }}) <span aria-hidden="true">→</span></a>
  </nav>
  <div class="shell publications-more">
    {{ filter.more(P) }}
  </div>
<script src="{{ '/js/weekly.js' | assetUrl }}" defer></script>
{% include "partials/newsletter.njk" %}

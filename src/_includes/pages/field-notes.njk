{#- The Field Notes page, shared by both languages. -#}
{% include "partials/writing-tabs.njk" %}
<section class="shell page-hero writing-hero"><p class="eyebrow">{{ "Observed close to the work" | t(lang) }}</p><h1>{{ "Field Notes" | t(lang) }}</h1><p class="lede">{{ "Shorter ideas about management, service, standards and what becomes visible when you stay close to the operation." | t(lang) }}</p></section>
<section class="shell section" data-filter-list>
{%- set noteList = collections["notes" + (lang | langSuffix)] %}
{%- set notesPage = "/field-notes.html" | local(lang) %}
{%- set searchLabel = "Search notes" | t(lang) %}
{%- set countLabel = "{a} of {b} notes" | t(lang) %}
{%- set filterTopics = noteList | topics("topic") %}
{#- Each note's essay and tool (lib/writing-links.js), in the page's language. -#}
{%- set noteLinks = collections.writingLinks.noteLinks %}
{%- set essayList = collections["insights" + (lang | langSuffix)] %}
{%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools %}
{% include "partials/filter-bar.njk" %}
<div class="notes-grid">
{%- for note in noteList %}
<article class="note-card" id="note-{{ note.fileSlug }}" data-filter-item data-topic="{{ note.data.topic }}" data-search="{{ [note.data.quote, note.data.topic] | join(' ') | lower }}">
  <blockquote>“{{ note.data.quote }}”</blockquote>
  {%- set link = noteLinks[note.fileSlug] %}
  {%- set noteEssay = (essayList | byOriginal(link.essay)) if link and link.essay else null %}
  {%- set noteTool = (toolList | toolAt(link.tool, lang)) if link and link.tool else null %}
  {%- if (noteEssay and noteEssay.url) or noteTool %}
  <p class="note-links">
    {%- if noteEssay and noteEssay.url %}<a href="{{ noteEssay.url }}"><small>{{ "From the essay" | t(lang) }}</small><span>{{ noteEssay.data.title }}</span></a>{% endif %}
    {%- if noteTool %}<a class="is-tool" href="{{ noteTool.url }}"><small>{{ "Put it to work" | t(lang) }}</small><span>{{ noteTool.name }} →</span></a>{% endif %}
  </p>
  {%- endif %}
  <div class="note-foot">
    <time datetime="{{ note.date | isoDate }}">{{ note.date | readableDate(lang) }}{% if note.data.topic %} · {{ note.data.topic }}{% endif %}</time>
    <div class="note-actions" data-note-actions hidden>
      <button type="button" data-copied-label="{{ 'Copied' | t(lang) }}" data-copy-text="“{{ note.data.quote }}” (Stiven Janaqi, Stiven Catalyst) {{ (notesPage + '#note-' + note.fileSlug) | absoluteUrl }}">{{ "Copy" | t(lang) }}</button>
      <button type="button" data-share-url="{{ (notesPage + '#note-' + note.fileSlug) | absoluteUrl }}" data-share-text="“{{ note.data.quote }}”">{{ "Share" | t(lang) }}</button>
      {%- set image = note.fileSlug | noteImage(lang) %}{% if image %}
      <a href="{{ image }}" download="stiven-catalyst-{{ note.fileSlug }}-{{ lang or 'en' }}.jpg" title="{{ 'Download as an image to post' | t(lang) }}">{{ "Image" | t(lang) }}</a>{% endif %}
    </div>
  </div>
</article>
{%- endfor %}
</div>
<p class="filter-empty" data-filter-empty hidden>{{ "No notes match that yet. Try another word." | t(lang) }}</p>
</section>
<script src="{{ '/js/filter.js' | assetUrl }}" defer></script>
<script src="{{ '/js/share.js' | assetUrl }}" defer></script>

{#- "Start here", shared by the three languages: the first ten minutes for someone who arrives from a link (LinkedIn,
    an email, a talk). Three steps: read three essays, try one tool, keep up with a field note and the newsletter.
    The essays, the tool and the note are chosen here by slug; each language shows its own version. -#}
{%- set essays = collections["insights" + (lang | langSuffix)] | bySlugs(["the-operations-manager-i-want-to-be", "kpis-do-not-improve-in-excel", "from-albania-to-germany"]) -%}
{%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools -%}
{%- set tool = toolList | toolAt("/tools/kpi-diagnostic/", lang) -%}
{%- set note = (collections["notes" + (lang | langSuffix)] | bySlugs(["15-standard"]))[0] -%}
<section class="shell page-hero">
  <p class="eyebrow">{{ "New to Stiven Catalyst" | t(lang) }}</p>
  <h1>{{ "Start here." | t(lang) }}</h1>
  <p class="lede">{{ "Essays, field notes and small tools about leading people and running operations, written from ten years close to the work. If you have ten minutes, begin with these." | t(lang) }}</p>
</section>

<section class="shell start-intro" aria-labelledby="start-author">
  <img src="{{ site.authorImage }}" alt="" width="120" height="120" decoding="async">
  <div>
    <p class="kicker" id="start-author">{{ "Who writes this" | t(lang) }}</p>
    <p>{{ "I am Stiven Janaqi. I have led teams in retail, last-mile logistics and hotels, first in Albania, then in Germany. I write about what I have seen work and fail on the floor, and build the tools I wished I had on shift." | t(lang) }}</p>
    <a class="text-link" href="{{ '/about.html' | local(lang) }}">{{ "More about me" | t(lang) }} <span aria-hidden="true">→</span></a>
  </div>
</section>

{%- if essays.length %}
<section class="shell section start-step" aria-labelledby="start-read">
  <div class="section-heading">
    <div>
      <p class="kicker"><span class="start-number">1</span> {{ "Read first" | t(lang) }}</p>
      <h2 id="start-read">{{ "Three essays to begin with." | t(lang) }}</h2>
    </div>
    <p>{{ "The first brings the whole series together. The second is about numbers, the third about where it all began." | t(lang) }}</p>
  </div>
  <div class="article-grid">
    {%- for item in essays %}
    <article class="article-card">
      <span class="card-number">{{ item.data.number }}</span>
      <div class="card-meta"><span>{{ item.data.category }}</span>{% if item.data.readingTime %}<span>{{ "{t} read" | t(lang) | replace("{t}", item.data.readingTime) }}</span>{% endif %}</div>
      <h3>{{ item.data.title }}</h3>
      <p>{{ item.data.teaser or item.data.summary }}</p>
      <a class="text-link" href="{{ item.url }}">{{ "Read the essay" | t(lang) }} <span aria-hidden="true">→</span></a>
    </article>
    {%- endfor %}
  </div>
</section>
{%- endif %}

{%- if tool %}
<section class="shell section start-step" aria-labelledby="start-try">
  <div class="section-heading">
    <div>
      <p class="kicker"><span class="start-number">2</span> {{ "Try a tool" | t(lang) }}</p>
      <h2 id="start-try">{{ "One tool for your next shift." | t(lang) }}</h2>
    </div>
    <p>{{ "Small tools built from the essays. They run in your browser, and nothing you type leaves your device." | t(lang) }}</p>
  </div>
  <article class="article-card start-tool">
    <h3>{{ tool.name }}</h3>
    <p>{{ tool.summary }}</p>
    <div class="start-links">
      <a class="text-link" href="{{ tool.url }}">{{ "Open the tool" | t(lang) }} <span aria-hidden="true">→</span></a>
      <a class="text-link" href="{{ '/tools.html' | local(lang) }}">{{ "See all tools" | t(lang) }} <span aria-hidden="true">→</span></a>
    </div>
  </article>
</section>
{%- endif %}

<section class="shell section start-step" aria-labelledby="start-stay">
  <div class="section-heading">
    <div>
      <p class="kicker"><span class="start-number">3</span> {{ "Keep up" | t(lang) }}</p>
      <h2 id="start-stay">{{ "A field note a day, the next essay by email." | t(lang) }}</h2>
    </div>
    <p>{{ "A new field note on the home page every day. New essays and field notes by email, when they are ready." | t(lang) }}</p>
  </div>
  {%- if note %}
  <article class="note-card">
    <blockquote>“{{ note.data.quote }}”</blockquote>
    <a class="text-link" href="{{ '/field-notes.html' | local(lang) }}#note-{{ note.fileSlug }}">{{ "All field notes" | t(lang) }} <span aria-hidden="true">→</span></a>
  </article>
  {%- endif %}
  <p class="start-more">{{ "Also here:" | t(lang) }}
    <a href="{{ '/reflections.html' | local(lang) }}">{{ "Reflections" | t(lang) }}</a> ·
    <a href="{{ '/publications.html' | local(lang) }}">{{ "the magazine, the book and the guides" | t(lang) }}</a> ·
    <a href="{{ '/projects.html' | local(lang) }}">{{ "Projects" | t(lang) }}</a>
  </p>
</section>

{% include "partials/newsletter.njk" %}

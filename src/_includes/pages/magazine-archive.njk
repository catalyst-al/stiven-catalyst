{#- All issues of the monthly magazine From the Floor, the newest first, each as its cover, narrowed by month and
    topic the way the list of the Management Review is (partials/issue-filter.njk). Shared by the three languages. -#}
{%- set lang = lang or "en" -%}
{%- set N = magazine.names[lang] -%}
{%- set L = magazine.labels[lang] -%}
{%- set A = magazine.archive[lang] -%}
{%- set F = weekly[lang].archive -%}
{%- import "partials/issue-filter.njk" as filter -%}
  <section class="shell page-hero weekly-hero">
    <p class="eyebrow">{{ A.eyebrow }}</p>
    <h1{% if N.name | length > 10 %} class="hero-long"{% endif %}>{{ N.name }}</h1>
    <p class="lede">{{ A.lede }}</p>
  </section>

  <section class="shell weekly-archive" aria-label="{{ A.all }}">
    {{ filter.controls(magazine.months, magazine.blocks, lang, F, weekly[lang].labels.blocks) }}
    <ol class="weekly-grid" reversed>
      {%- for issue in magazine.issues | reverse %}
      {%- set cover = magazinePages[issue.slug][lang].pages[0] %}
      <li data-block="{{ issue.block }}" data-month="{{ issue.month }}">
        <a class="weekly-card" href="{{ ('/magazine/' + issue.slug + '.html') | local(lang) }}">
          <span class="weekly-card-cover"><img src="{{ cover.image }}" srcset="{{ cover.image | srcsetFor }}" sizes="(max-width: 620px) 45vw, 220px" width="{{ cover.width }}" height="{{ cover.height }}" alt="" loading="{{ 'eager' if loop.index <= 4 else 'lazy' }}" decoding="async"></span>
          <span class="weekly-card-meta">{{ L.issue }} {{ issue.number }}</span>
          <strong>{{ issue[lang].theme }}</strong>
          <span class="weekly-card-date">{{ issue[lang].date }}</span>
        </a>
      </li>
      {%- endfor %}
    </ol>
    {{ filter.more(F) }}
  </section>
<script src="{{ '/js/weekly.js' | assetUrl }}" defer></script>

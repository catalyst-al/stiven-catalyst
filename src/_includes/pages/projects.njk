{#- The Projects page, shared by both languages. -#}
<section class="shell page-hero"><p class="eyebrow">{{ "Built work" | t(lang) }}</p><h1>{{ "Projects" | t(lang) }}</h1><p class="lede">{{ "Tools, operational systems and working ideas designed to make everyday work clearer, faster and more reliable." | t(lang) }}</p></section>
<section class="shell project-grid">
{%- for project in (collections.projectsDe if lang == "de" else collections.projects) %}
<article class="project-card">
  {%- if project.data.image %}<img class="project-image" src="{{ project.data.image }}" alt="" loading="lazy">{% endif %}
  <span class="tag">{{ project.data.tag }}</span>
  <div>
    <h2>{{ project.data.title }}</h2>
    <p>{{ project.data.summary }}</p>
    {%- if project.data.link %}
    <a class="text-link project-link" href="{{ project.data.link }}">{{ "View project" | t(lang) }} <span aria-hidden="true">→</span></a>
    {%- endif %}
    {%- if project.data.file %}
    <a class="text-link project-link" href="{{ project.data.file }}" download>{{ "Download" | t(lang) }} <span aria-hidden="true">↓</span></a>
    {%- endif %}
  </div>
</article>
{%- endfor %}
</section>

{#- The Reflections list, shared by the three languages. -#}
  <section class="shell page-hero reflection-hero">
    <p class="eyebrow">{{ "Personal essays" | t(lang) }}</p>
    <h1>{{ "Reflections" | t(lang) }}</h1>
    <p class="lede">{{ "Slower, more personal pieces on attention, people and the quiet side of leadership." | t(lang) }}</p>
  </section>
  <section class="shell listing reflection-list">
    {%- for item in collections["reflections" + (lang | langSuffix)] %}
    <a class="list-row" href="{{ item.url }}">
      <span class="number"><time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate(lang) }}</time></span>
      <div><h2>{{ item.data.title }}</h2><p>{{ item.data.summary }}</p></div>
      <span class="row-meta">{{ "Reflection" | t(lang) }}{% if item.data.readingTime %} · {{ item.data.readingTime }}{% endif %}</span>
    </a>
    {%- else %}
    <p class="filter-empty">{{ "The first reflection is on its way." | t(lang) }}</p>
    {%- endfor %}
  </section>
{% include "partials/newsletter.njk" %}

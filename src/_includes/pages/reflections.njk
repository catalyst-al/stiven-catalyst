{#- The Reflections list, shared by the three languages. -#}
  <section class="shell page-hero writing-hero reflection-hero">
    <p class="eyebrow">{{ "Personal essays" | t(lang) }}</p>
    <h1>{{ "Reflections" | t(lang) }}</h1>
    <p class="lede">{{ "Slower, more personal pieces on attention, people and the quiet side of leadership." | t(lang) }}</p>
  </section>
  {%- set reflections = collections["reflections" + (lang | langSuffix)] %}
  <section class="shell listing reflection-list" data-filter-list>
    {#- Search, the months of the reflections once there are two (the newest first) and twelve at a time with "show
        more", the way Insights lists its essays (partials/filter-bar.njk, js/filter.js). #}
    {%- if reflections.length %}
    {%- set searchLabel = "Search reflections" | t(lang) %}
    {%- set countLabel = "{a} of {b} reflections" | t(lang) %}
    {%- set filterTopics = [] %}
    {%- set filterMonths = reflections | monthsOf(lang) %}
    {%- set filterPage = 12 %}
    {% include "partials/filter-bar.njk" %}
    {%- endif %}
    {%- for item in reflections %}
    <a class="list-row" href="{{ item.url }}" data-filter-item data-topic="" data-month="{{ item.date | monthId }}" data-search="{{ [item.data.title, item.data.summary] | join(' ') | lower }}" data-read-row="{{ item.fileSlug }}">
      <span class="number"><time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate(lang) }}</time></span>
      <div><h2>{{ item.data.title }}</h2><p>{{ item.data.summary }}</p></div>
      <span class="row-meta">{{ "Reflection" | t(lang) }}{% if item.data.readingTime %} · {{ item.data.readingTime }}{% endif %}<span class="read-mark" data-read-mark hidden>{{ "Read" | t(lang) }}</span></span>
    </a>
    {%- else %}
    <p class="filter-empty">{{ "The first reflection is on its way." | t(lang) }}</p>
    {%- endfor %}
    {%- if reflections.length %}
    <p class="filter-empty" data-filter-empty hidden>{{ "No reflections match that yet. Try another word." | t(lang) }}</p>
    <div class="weekly-more" data-filter-more hidden>
      <p class="weekly-shown" aria-live="polite"></p>
      <button type="button" class="button-secondary">{{ "Show more reflections" | t(lang) }}</button>
    </div>
    {%- endif %}
  </section>
{% include "partials/newsletter.njk" %}
<script src="{{ '/js/filter.js' | assetUrl }}" defer></script>
<script src="{{ '/js/writing.js' | assetUrl }}" defer></script>

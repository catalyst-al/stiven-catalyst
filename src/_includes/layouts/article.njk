---
layout: layouts/base.njk
ogType: article
---
{%- set pageUrl = page.url | absoluteUrl %}
<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<section class="shell article-hero{% if image %} has-image{% endif %}">
  {%- if image %}
  {%- set heroSize = image | imageSize %}
  <figure class="article-hero-media"><img src="{{ image }}" alt="{{ image_alt }}"{% if heroSize %} width="{{ heroSize.width }}" height="{{ heroSize.height }}"{% endif %} fetchpriority="high"></figure>
  {%- endif %}
  <div class="article-hero-text">
    <p class="eyebrow">{% if category %}{{ category }} · {% endif %}{{ (kind or "Essay") | t(lang) }}</p>
    <h1>{{ title }}</h1>
    {%- if deck %}
    <p class="article-deck">{{ deck }}</p>
    {%- endif %}
    {#- Who wrote it, when, and how long it takes: one line, so the text starts on the first screen. -#}
    <p class="article-byline">
      {%- if not author and site.authorImage %}<img class="author-photo" src="{{ site.authorImage }}" alt="" width="44" height="44" decoding="async">{% endif -%}
      <span><strong>{{ author or site.author }}</strong><span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(lang) }}</time>{% if readingTime %} · {{ "{t} read" | t(lang) | replace("{t}", readingTime) }}{% endif %}</span></span>
    </p>
  </div>
</section>
{#- The text with ids on its section titles; with three sections or more, a list of them beside the text
    (on a phone, folded above it). -#}
{%- set body = content | essayBody %}
{%- set sections = content | essayContents %}
{%- set hasContents = sections.length >= 3 %}
{%- set isEssay = "/insights/" in page.inputPath %}
{#- The essay's series (src/_data/essaySeries.json): its name, its essays and this one's place among them. -#}
{%- set seriesInfo = essaySeries | seriesById(series) if isEssay else null %}
{%- set seriesName = seriesInfo.name[lang or "en"] if seriesInfo else "" %}
{%- set allEssays = collections["insights" + (lang | langSuffix)] | published if isEssay else [] %}
{%- set seriesItems = allEssays | inSeries(seriesInfo.id) if seriesInfo else [] %}
{%- set series = seriesItems | seriesNeighbours(page.url, seriesInfo.planned) if seriesInfo else null %}
{%- set contentsTitle = "In this essay" | t(lang) %}
<section class="shell article-body{% if not (series or hasContents) %} no-aside{% endif %}">
  {%- if series or hasContents %}
  <aside class="article-aside">
    <div class="article-aside-inner">
      {%- if series %}
      {#- Where this essay stands in the series: one dot per essay, this one marked, those already read filled in
          (js/article.js, from this browser only). -#}
      <div class="series-track">
        <p class="kicker">{{ seriesName }}</p>
        <p class="series-track-count">{{ "Essay {n} of {total}" | t(lang) | replace("{n}", series.number | string) | replace("{total}", series.total | string) }}</p>
        <ol class="series-dots">
          {%- for item in seriesItems %}
          <li><a href="{{ item.url }}" data-essay-dot="{{ item.fileSlug }}" title="{{ loop.index | pad }} · {{ item.data.title }}"{% if item.url == page.url %} aria-current="page"{% endif %}><span class="visually-hidden">{{ loop.index | pad }} · {{ item.data.title }}</span></a></li>
          {%- endfor %}
        </ol>
      </div>
      {%- endif %}
      {%- if hasContents %}
      <nav class="article-toc" aria-label="{{ contentsTitle }}">
        <p class="kicker">{{ contentsTitle }}</p>
        <ol>
          {%- for section in sections %}
          <li><a href="#{{ section.id }}" data-toc-link>{{ section.html | safe }}</a></li>
          {%- endfor %}
        </ol>
      </nav>
      {%- endif %}
    </div>
  </aside>
  {%- endif %}
  <article class="article-content" data-article data-essay-id="{{ page.fileSlug }}" data-essay-title="{{ title }}">
    {%- if hasContents %}
    <details class="article-toc-fold">
      <summary>{{ contentsTitle }}</summary>
      <ol>
        {%- for section in sections %}
        <li><a href="#{{ section.id }}">{{ section.html | safe }}</a></li>
        {%- endfor %}
      </ol>
    </details>
    {%- endif %}
{{ body | safe }}
    {#- A checklist the essay ends with ("checklist" in its front matter: title, items as text or { label, hint }, "fill" for a card of answers, an optional note, and "copy" for the copy button's label): the reader ticks the
        questions off and can copy them. Nothing is kept or sent (js/article.js). -#}
    {%- if checklist and checklist.items %}
    <section class="essay-checklist" data-essay-checklist aria-labelledby="essay-checklist-title">
      <div class="essay-checklist-head">
        <p class="kicker" id="essay-checklist-title">{{ checklist.title }}</p>
        <span class="essay-checklist-count" data-checklist-count aria-live="polite">0/{{ checklist.items.length }}</span>
      </div>
      <ol>
        {%- for item in checklist.items %}
        {%- if checklist.fill %}
        {%- set label = item.label if item.label else item %}
        <li class="is-field"><label><span><b>{{ loop.index | pad }}</b> {{ label }}</span>{% if item.hint %}<small>{{ item.hint }}</small>{% endif %}<textarea rows="2" data-checklist-item placeholder="{{ 'Your answer' | t(lang) }}"></textarea></label></li>
        {%- else %}
        <li><label><input type="checkbox" data-checklist-item><span>{{ item }}</span></label></li>
        {%- endif %}
        {%- endfor %}
      </ol>
      <div class="essay-checklist-actions">
      {%- if checklist.fill %}
      <button type="button" class="button-secondary" data-checklist-clear>{{ "Clear" | t(lang) }}</button>
      {%- endif %}
      <button type="button" class="button-secondary" data-checklist-copy data-copied-label="{{ 'Copied' | t(lang) }}">{{ checklist.copy if checklist.copy else (("Copy the card" | t(lang)) if checklist.fill else ("Copy the {n} questions" | t(lang) | replace("{n}", checklist.items.length | string))) }}</button>
      </div>
      {%- if checklist.note %}
      <p class="essay-checklist-note">{{ checklist.note }}</p>
      {%- endif %}
    </section>
    {%- endif %}
    {#- The tools an essay is about ("relatedTools" on the English essay, or read from its text; translations follow
        it), and the field notes drawn from it (lib/writing-links.js). -#}
    {%- if isEssay %}
    {%- set essayKey = original or page.fileSlug %}
    {%- set essayTools = collections.writingLinks.essayTools[essayKey] or [] %}
    {%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools %}
    {%- if essayTools.length %}
    <aside class="essay-tools" aria-labelledby="essay-tools-title">
      <p class="kicker" id="essay-tools-title">{{ "Tools for this essay" | t(lang) }}</p>
      <ul>
        {%- for url in essayTools %}{% set tool = toolList | toolAt(url, lang) %}{% if tool %}
        <li><a href="{{ tool.url }}"><small>{{ tool.type }} · {{ tool.time }}</small><strong>{{ tool.name }}</strong><span>{{ tool.summary }}</span><em aria-hidden="true">→</em></a></li>
        {%- endif %}{% endfor %}
      </ul>
    </aside>
    {%- endif %}
    {%- set essayNotes = collections["notes" + (lang | langSuffix)] | bySlugs(collections.writingLinks.essayNotes[essayKey] or []) %}
    {%- if essayNotes.length %}
    {%- set notesPage = "/field-notes.html" | local(lang) %}
    <aside class="essay-notes" aria-labelledby="essay-notes-title">
      <p class="kicker" id="essay-notes-title">{{ "Field notes from this essay" | t(lang) }}</p>
      <ul>
        {%- for note in essayNotes %}{% if loop.index <= 4 %}
        <li><a href="{{ notesPage }}#note-{{ note.fileSlug }}">“{{ note.data.quote }}”</a></li>
        {%- endif %}{% endfor %}
      </ul>
      {%- if essayNotes.length > 4 %}<a class="text-link" href="{{ notesPage }}">{{ "All field notes" | t(lang) }} →</a>{% endif %}
    </aside>
    {%- endif %}
    {#- After the essay: the next one, large, with its opening line; the one before; all essays. After the last
        essay, the end of the series and where to go from there. -#}
    {%- if series %}
    {%- set insightsUrl = '/insights.html' | local(lang) %}
    {%- set laterSeries = essaySeries | seriesAfter(seriesInfo.id) %}
    {%- set laterFirst = (allEssays | inSeries(laterSeries.id))[0] if laterSeries else null %}
    <nav class="essay-series" aria-labelledby="essay-series-title">
      <p class="kicker" id="essay-series-title">{{ seriesName }} · {{ "Essay {n} of {total}" | t(lang) | replace("{n}", series.number | string) | replace("{total}", series.total | string) }}</p>
      {%- if series.next %}
      <a class="essay-series-next" href="{{ series.next.url }}" rel="next">
        <small>{{ "Next essay" | t(lang) }} · {{ (series.number + 1) | pad }}</small>
        <strong>{{ series.next.data.title }}</strong>
        {%- if series.next.data.teaser or series.next.data.summary %}<span>{{ series.next.data.teaser or series.next.data.summary }}</span>{% endif %}
        <em aria-hidden="true">→</em>
      </a>
      {%- elif seriesItems.length < seriesInfo.planned %}
      {#- The newest essay of a series still being written: the next one is on its way. #}
      <div class="essay-series-next is-end">
        <strong>{{ "The next essay of the series is on its way." | t(lang) }}</strong>
        <span class="essay-series-end-links">
          <a href="#newsletter-title">{{ "Get it by email" | t(lang) }}</a>
          {%- if series.number > 1 %}
          <a href="{{ seriesItems[0].url }}">{{ "Start again with essay 1" | t(lang) }}</a>
          {%- endif %}
          <a href="{{ '/tools.html' | local(lang) }}">{{ "Tools" | t(lang) }}</a>
        </span>
      </div>
      {%- elif laterFirst %}
      {#- The last essay of a finished series leads into the next series. #}
      <a class="essay-series-next" href="{{ laterFirst.url }}">
        <small>{{ "The next series" | t(lang) }} · {{ laterSeries.name[lang or "en"] }}</small>
        <strong>{{ laterFirst.data.title }}</strong>
        {%- if laterFirst.data.teaser or laterFirst.data.summary %}<span>{{ laterFirst.data.teaser or laterFirst.data.summary }}</span>{% endif %}
        <em aria-hidden="true">→</em>
      </a>
      {%- else %}
      <div class="essay-series-next is-end">
        <strong>{{ "The last essay of the series." | t(lang) }}</strong>
        <span class="essay-series-end-links">
          <a href="{{ seriesItems[0].url }}">{{ "Start again with essay 1" | t(lang) }}</a>
          <a href="{{ '/publications.html' | local(lang) }}#magazine">{{ magazine.names[lang or 'en'].name }}</a>
          <a href="{{ '/tools.html' | local(lang) }}">{{ "Tools" | t(lang) }}</a>
        </span>
      </div>
      {%- endif %}
      <p class="essay-series-more">
        {%- if series.prev %}<a href="{{ series.prev.url }}" rel="prev"><small>← {{ "Previous essay" | t(lang) }}</small> {{ series.prev.data.title }}</a>{% endif %}
        <a class="essay-series-all" href="{{ insightsUrl }}">{{ "All essays" | t(lang) }}</a>
      </p>
    </nav>
    {%- endif %}
    {%- endif %}
    <div class="share-row">
      <p class="kicker">{{ "Share this essay" | t(lang) }}</p>
      <div class="share-links">
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ pageUrl | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:?subject={{ title | urlencode }}&amp;body={{ (title + ' ' + pageUrl) | urlencode }}">{{ "Email" | t(lang) }}</a>
        <button type="button" data-copy-text="{{ pageUrl }}" data-copied-label="{{ 'Link copied' | t(lang) }}">{{ "Copy link" | t(lang) }}</button>
        <button type="button" data-share-url="{{ pageUrl }}" data-share-text="{{ title }}" data-native-only hidden>{{ "Share" | t(lang) }}</button>
      </div>
    </div>
  </article>
</section>
{% include "partials/newsletter.njk" %}
<script src="{{ '/js/share.js' | assetUrl }}" defer></script>
<script src="{{ '/js/article.js' | assetUrl }}" defer></script>

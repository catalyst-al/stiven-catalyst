---
layout: layouts/base.njk
ogType: article
---
{%- set pageUrl = page.url | absoluteUrl %}
<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<section class="shell article-hero{% if image %} has-image{% endif %}">
  {%- if image %}
  {%- set heroSize = image | imageSize %}
  <figure class="article-hero-media"><img src="{{ image }}" alt="{{ image_alt }}"{% if heroSize %} width="{{ heroSize.width }}" height="{{ heroSize.height }}"{% endif %} fetchpriority="high"></figure>
  {%- endif %}
  <div class="article-hero-text">
    <p class="eyebrow">{% if category %}{{ category }} · {% endif %}{{ (kind or "Essay") | t(lang) }}</p>
    <h1>{{ title }}</h1>
    {%- if deck %}
    <p class="article-deck">{{ deck }}</p>
    {%- endif %}
  </div>
</section>
<section class="shell article-body">
  <aside class="article-aside">
    {%- if not author and site.authorImage %}<img class="author-photo" src="{{ site.authorImage }}" alt="" width="96" height="96" loading="lazy" decoding="async">{% endif -%}
    {{ author or site.author }}<br><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate(lang) }}</time>{% if readingTime %}<br>{{ "{t} read" | t(lang) | replace("{t}", readingTime) }}{% endif %}</aside>
  <article class="article-content" data-article>
{{ content | safe }}
    {#- The tools an essay is about ("relatedTools" on the English essay; translations follow it). -#}
    {%- if "/insights/" in page.inputPath %}
    {%- set sourceEssay = collections.insights | byOriginal(original or page.fileSlug) %}
    {%- set essayTools = sourceEssay.data.relatedTools if sourceEssay and sourceEssay.data.relatedTools else [] %}
    {%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools %}
    {%- if essayTools.length %}
    <aside class="essay-tools" aria-labelledby="essay-tools-title">
      <p class="kicker" id="essay-tools-title">{{ "Tools for this essay" | t(lang) }}</p>
      <ul>
        {%- for url in essayTools %}{% set tool = toolList | toolAt(url, lang) %}{% if tool %}
        <li><a href="{{ tool.url }}"><small>{{ tool.type }} · {{ tool.time }}</small><strong>{{ tool.name }}</strong><span>{{ tool.summary }}</span><em aria-hidden="true">→</em></a></li>
        {%- endif %}{% endfor %}
      </ul>
    </aside>
    {%- endif %}
    {#- Where this essay stands in the series, with the one before and the one after. -#}
    {%- set series = collections["insights" + (lang | langSuffix)] | seriesNeighbours(page.url) %}
    {%- if series and (series.prev or series.next) %}
    <nav class="essay-series" aria-labelledby="essay-series-title">
      <p class="kicker" id="essay-series-title">{{ "Ten years close to the work" | t(lang) }} · {{ "Essay {n} of {total}" | t(lang) | replace("{n}", series.number | string) | replace("{total}", series.total | string) }}</p>
      <ul>
        {%- if series.prev %}
        <li><a href="{{ series.prev.url }}" rel="prev"><small>{{ "Previous essay" | t(lang) }}</small><strong>{{ series.prev.data.title }}</strong></a></li>
        {%- endif %}
        {%- if series.next %}
        <li class="is-next"><a href="{{ series.next.url }}" rel="next"><small>{{ "Next essay" | t(lang) }}</small><strong>{{ series.next.data.title }}</strong></a></li>
        {%- endif %}
      </ul>
      <p class="essay-series-all"><a href="{{ '/insights.html' | local(lang) }}">{{ "All essays" | t(lang) }}</a></p>
    </nav>
    {%- endif %}
    {%- endif %}
    <div class="share-row">
      <p class="kicker">{{ "Share this essay" | t(lang) }}</p>
      <div class="share-links">
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ pageUrl | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:?subject={{ title | urlencode }}&amp;body={{ (title + ' ' + pageUrl) | urlencode }}">{{ "Email" | t(lang) }}</a>
        <button type="button" data-copy-text="{{ pageUrl }}" data-copied-label="{{ 'Link copied' | t(lang) }}">{{ "Copy link" | t(lang) }}</button>
        <button type="button" data-share-url="{{ pageUrl }}" data-share-text="{{ title }}" data-native-only hidden>{{ "Share" | t(lang) }}</button>
      </div>
    </div>
  </article>
</section>
{% include "partials/newsletter.njk" %}
<script src="{{ '/js/share.js' | assetUrl }}" defer></script>
<script src="{{ '/js/article.js' | assetUrl }}" defer></script>

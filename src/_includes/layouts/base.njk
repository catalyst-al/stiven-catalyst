{%- set shortTitle = seo_title or title -%}
{#- The site's name follows the title only while the whole stays within about 60 characters, what a search result
    shows; a longer title stands alone, since the name would be the part cut off (the site name is in the structured
    data, partials/structured-data.njk). -#}
{%- set pageTitle = ((shortTitle + " | " + site.title) if (shortTitle | length) + 3 + (site.title | length) <= 60 else shortTitle) if shortTitle else (site.title + " | " + ("Leadership, Operations & Ideas" | t(lang))) -%}
{%- set pageDescription = description or summary or site.description -%}
{%- set homeUrl = "/" | local(lang) -%}
{#- The menu: "Home" and "Start here" for someone new, then five places: Writing, Tools, CV, Publications and About
    (Projects lives under About). The third field of an item lists the pages it is active on; the seventh is the
    little menu that opens under it on hover or keyboard focus, so what is inside shows without opening the page:
    [address, name, line under it, colour of its planet]. "Home" and "Start here" give way first when the header is
    narrow (styles.css, .nav-start); the phone menu always has them, with the inner pages under each place. -#}
{%- set writingPages = ["/writing.html" | local(lang), "/insights.html" | local(lang), "/challenges.html" | local(lang), "/reflections.html" | local(lang), "/field-notes.html" | local(lang)] -%}
{#- Writing and Publications also carry a stamp of what they hold (navStamp): when it changes, their menu item
    pulses for a reader who has been here before (script.js). -#}
{%- set sfx = {"de": "De", "sq": "Sq"}[lang] or "" -%}
{%- set ml = lang or "en" -%}
{%- set writingStamp = collections["insights" + sfx] | navStamp(collections["reflections" + sfx], collections["notes" + sfx]) -%}
{%- set pubStamp = publications.review | navStamp(publications.treatise, publications.floor, [publications.special]) -%}
{%- set writingMenu = [
  ["/insights.html" | local(lang), "Insights" | t(lang), "Essays & analysis" | t(lang)],
  ["/challenges.html" | local(lang), "Challenges" | t(lang), "By the problem, not the title" | t(lang)],
  ["/reflections.html" | local(lang), "Reflections" | t(lang), "Personal essays" | t(lang)],
  ["/field-notes.html" | local(lang), "Field Notes" | t(lang), "Observed close to the work" | t(lang)]
] -%}
{%- set toolsMenu = [["/tools.html" | local(lang), "All tools" | t(lang), ""]] -%}
{%- for family in families %}{% set toolsMenu = (toolsMenu.push([("/tools.html" | local(lang)) + "#" + family.id, family.role | t(lang), family.name, family.color]), toolsMenu) %}{% endfor -%}
{%- set pubMenu = [
  ["/magazine/management-review.html" | local(lang), weekly.name, ""],
  ["/magazine/operational-treatise.html" | local(lang), treatise[ml].short, ""],
  ["/magazine/from-the-floor.html" | local(lang), magazine.names[ml].name, ""],
  ["/books/mall-per-durresin.html" | local(lang), (books[ml] or books.sq).title, ""],
  ["/guides/tools-guide.html" | local(lang), toolsGuide[ml].title, ""],
  ["/downloads.html" | local(lang), "Downloads" | t(lang), ""]
] -%}
{#- The career tools have their own place, so the CV is one click away from every page, not only at the end of the
    homepage. -#}
{%- set cvPages = ["/tools/cv-builder/" | local(lang), "/tools/ats-cv/" | local(lang), "/tools/cover-letter/" | local(lang)] -%}
{%- set cvMenu = [
  [cvPages[0], "CV Builder" | t(lang), ""],
  [cvPages[1], "ATS CV" | t(lang), ""],
  [cvPages[2], "Cover Letter" | t(lang), ""]
] -%}
{%- set aboutMenu = [
  ["/about.html" | local(lang), "About" | t(lang), ""],
  ["/projects.html" | local(lang), "Projects" | t(lang), ""],
  ["/contact.html" | local(lang), "Contact" | t(lang), ""]
] -%}
{%- set nav = [
  [homeUrl, "Homepage" | t(lang), null, null, null, "nav-start nav-home"],
  ["/start.html" | local(lang), "Start here" | t(lang), null, null, null, "nav-start"],
  ["/writing.html" | local(lang), "Writing" | t(lang), writingPages, "writing", writingStamp, null, writingMenu],
  ["/tools.html" | local(lang), "Tools" | t(lang), null, null, null, null, toolsMenu],
  [cvPages[0], "CV", cvPages, null, null, "nav-cv", cvMenu],
  ["/publications.html" | local(lang), "Publications" | t(lang), ["/publications.html" | local(lang), "/downloads.html" | local(lang)], "publications", pubStamp, null, pubMenu],
  ["/about.html" | local(lang), "About" | t(lang), ["/about.html" | local(lang), "/projects.html" | local(lang), "/contact.html" | local(lang)], null, null, null, aboutMenu]
] -%}
{%- set hasLegal = legal.name and legal.city -%}
{%- set toolFamily = page.url | familyOf(families) -%}
{%- set rolePage = toolFamily and "/roles/" in page.url -%}
{#- Anonymous visit counts (Cloudflare Web Analytics: no cookies, nothing stored in the browser) on the writing
    pages only; the tools and the role pages, where people type their own work, load nothing from outside. -#}
{%- set analyticsToken = site.analytics.cloudflareToken if not toolFamily else "" -%}
{#- A page's own image, else its card (a tool, a role, an essay, a reflection, a writing page), else the homepage
    card in its language (the hero with the families). -#}
{%- set card = (page.url | socialCard(lang)) or (page | pieceCard(lang)) or (homeUrl | socialCard(lang)) -%}
{%- set socialImage = ogImage or ((card | assetUrl) if card else "/social.png") -%}
{#- The two inline scripts, kept in variables so the Content Security Policy can name their hashes. -#}
{%- set themeScript -%}document.documentElement.classList.add("js");try{document.documentElement.dataset.theme=localStorage.getItem("sc-theme")||"dark"}catch(e){document.documentElement.dataset.theme="dark"}{%- endset -%}
{%- set coachingLoader -%}{% include "partials/coaching-loader.njk" %}{%- endset -%}
{#- Links on this site are fetched while the pointer rests on them (or on touch), so the next page is usually there
    by the time it is clicked; browsers without speculation rules ignore it. -#}
{%- set speculationRules -%}{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"selector_matches":"[download],[target=_blank]"}}]},"eagerness":"moderate"}]}{%- endset -%}
{#- Everything comes from this site; the one exception is a company logo from Google's icon service in the
    CV tools (img-src). Styles allow inline attributes (the role colour, SVG charts), fonts and images may be
    data: or blob: (exports, uploaded photos), pdf.js runs its worker from here, forms may post to the
    newsletter provider (form-action https:, and connect-src for the form that stays on the page), and the
    feedback form at the end of a tool may post to the form provider in site.contact.action (connect-src). -#}
{%- set csp = "default-src 'self'; script-src 'self' " + (themeScript | cspHash) + " " + (speculationRules | cspHash) + (" " + (coachingLoader | cspHash) if toolFamily and not rolePage else "") + (" https://static.cloudflareinsights.com" if analyticsToken else "") + "; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google.com; font-src 'self' data:; connect-src 'self'" + ((" " + (site.newsletter.action | originOf)) if site.newsletter.action else "") + (" https://cloudflareinsights.com" if analyticsToken else "") + ((" " + (site.contact.action | originOf)) if site.contact.action and toolFamily and not rolePage else "") + "; worker-src 'self' blob:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-src 'none'" -%}
<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="{{ csp | safe }}">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#070a0d">
{%- if not noindex %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
{%- for code, href in alternates %}
  <link rel="alternate" hreflang="{{ code }}" href="{{ href | absoluteUrl }}">
{%- endfor %}
{%- if alternates.en %}
  <link rel="alternate" hreflang="x-default" href="{{ alternates.en | absoluteUrl }}">
{%- endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ ogTitle or title or site.title }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ socialImage | absoluteUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogTitle or title or site.title }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else %}
  <meta name="robots" content="noindex">
{%- endif %}
  {%- set feedUrl = "/feed.xml" if not lang or lang == "en" else "/" + lang + "/feed.xml" %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ feedUrl }}">
  {#- The podcast of the Management Review, so that a podcast app given this site's address finds it. -#}
  {%- set podcastFeed = podcast[lang or "en"].feed %}
  {%- if podcastFeed %}
  <link rel="alternate" type="application/rss+xml" title="{{ podcastFeed.title }}" href="{{ podcastFeed.path }}">
  {%- endif %}
{%- if not noindex %}
{% include "partials/structured-data.njk" %}
{%- endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  {#- The site as an app on a phone or desktop (manifest.webmanifest, with sw.js registered from the tool pages by js/offline.js). #}
  <link rel="manifest" href="/manifest.webmanifest">
  <script>{{ themeScript | safe }}</script>
  <script type="speculationrules">{{ speculationRules | safe }}</script>
  <link rel="stylesheet" href="{{ '/styles.css' | assetUrl }}">
{%- if toolFamily %}
  <link rel="stylesheet" href="{{ '/coaching.css' | assetUrl }}">
{%- endif %}
{#- A reader whose pages are alive (livePages in the page's front matter: review, magazine or guide) loads the
    stylesheet of those pages (lib/live-pages.js). #}
{%- if livePages %}
  <link rel="stylesheet" href="{{ livePages | livePagesUrl }}">
{%- endif %}
{#- Translated tool pages load their UI text for tool-kit.js from one file the browser keeps. Deferred scripts run
    in document order, so this one, first in the document, runs before the deferred tool scripts that read it. #}
{%- if lang and lang != "en" and page.url and ("/" + lang + "/tools/") in page.url %}
  <script src="{{ lang | uiStringsUrl }}" defer></script>
{%- endif %}
</head>
<body{% if toolFamily %} class="in-family" data-family="{{ toolFamily.id }}" style="--family: {{ toolFamily.color }}"{% endif %}>
<a class="skip-link" href="#main">{{ "Skip to content" | t(lang) }}</a>

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="{{ homeUrl }}" aria-label="{{ 'Stiven Catalyst home' | t(lang) }}">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Stiven Catalyst</span>
    </a>
    <nav class="main-nav" aria-label="{{ 'Primary' | t(lang) }}" data-new-label="{{ 'New' | t(lang) }}">
      {%- for item in nav %}
      {%- set current = activeNav == item[0] or (item[2] and activeNav in item[2]) %}
      {%- if item[6] %}<div class="nav-item">{% endif %}
      <a{% if current %} aria-current="page"{% endif %}{% if item[5] %} class="{{ item[5] }}"{% endif %} href="{{ item[0] }}"{% if item[4] %} data-news="{{ item[3] }}" data-stamp="{{ item[4] }}"{% endif %}><span class="nav-orb" aria-hidden="true"></span>{{ item[1] }}{% if current %}<span class="nav-pill" aria-hidden="true"></span>{% endif %}</a>
      {%- if item[6] %}
      <div class="nav-menu"><div class="nav-menu-inner">
        {%- for sub in item[6] %}
        <a class="nav-menu-link" href="{{ sub[0] }}"{% if activeNav == sub[0] %} aria-current="page"{% endif %}><i aria-hidden="true"{% if sub[3] %} class="is-planet" style="--planet: {{ sub[3] }}"{% endif %}></i><span>{{ sub[1] }}{% if sub[2] %}<small>{{ sub[2] }}</small>{% endif %}</span></a>
        {%- endfor %}
      </div></div>
      </div>
      {%- endif %}
      {%- endfor %}
    </nav>
    <div class="header-actions">
      {%- include "partials/lang-switch.njk" %}
      {#- The shelf's name is hidden text, not aria-label, so the count shown beside it is part of its name. #}
      <a class="icon-button shelf-link" href="{{ '/shelf.html' | local(lang) }}" title="{{ 'My shelf' | t(lang) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10a1 1 0 0 1 1 1V20l-6-3.6L6 20V4.5a1 1 0 0 1 1-1z"/></svg><span class="visually-hidden">{{ 'My shelf' | t(lang) }}</span><b class="shelf-count" data-shelf-count hidden>0</b></a>
      <a class="icon-button" href="{{ '/search.html' | local(lang) }}" aria-label="{{ 'Search' | t(lang) }}" title="{{ 'Search' | t(lang) }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></a>
      <button class="icon-button" type="button" data-theme-toggle data-light-label="{{ 'Use light theme' | t(lang) }}" data-dark-label="{{ 'Use dark theme' | t(lang) }}" aria-label="{{ 'Toggle theme' | t(lang) }}"><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"/></svg></button>
      <button class="menu-button" type="button" data-menu-toggle data-menu-label="{{ 'Menu' | t(lang) }}" data-close-label="{{ 'Close menu' | t(lang) }}" aria-label="{{ 'Menu' | t(lang) }}" aria-expanded="false" aria-controls="mobile-menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="menu-line" d="M4 7h16"/><path class="menu-line" d="M4 12h16"/><path class="menu-line" d="M4 17h16"/></svg></button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-panel" data-mobile-panel data-open="false" aria-label="{{ 'Mobile' | t(lang) }}">
    {%- for item in nav %}
    <a{% if activeNav == item[0] or (item[2] and activeNav in item[2]) %} aria-current="page"{% endif %} href="{{ item[0] }}"{% if item[4] %} data-news="{{ item[3] }}"{% endif %}>{{ item[1] }}{% if item[4] %}<span class="nav-orb" aria-hidden="true"></span>{% endif %}</a>
    {%- if item[6] %}
    <div class="mobile-sub">
      {%- for sub in item[6] %}{% if sub[0] != item[0] %}<a href="{{ sub[0] }}"{% if activeNav == sub[0] %} aria-current="page"{% endif %}>{{ sub[1] }}</a>{% endif %}{% endfor %}
    </div>
    {%- endif %}
    {%- endfor %}
    {%- include "partials/lang-switch.njk" %}
  </nav>
</header>

<main id="main">
{%- if toolFamily %}
{% include "partials/family-stage.njk" %}
{%- endif %}
{{ content | safe }}
{%- if toolFamily and not rolePage %}
{% include "partials/coaching-bridge.njk" %}
{% include "partials/tool-essays.njk" %}
{% include "partials/tool-guide.njk" %}
{% include "partials/tool-feedback.njk" %}
{% include "partials/work-backup.njk" %}
{% include "partials/family-more.njk" %}
<script src="{{ '/js/tool-fold.js' | assetUrl }}" defer></script>
{%- endif %}
{%- if toolFamily or page.url | enPath == "/tools.html" %}
<script src="{{ '/js/offline.js' | assetUrl }}" defer></script>
{%- endif %}
</main>

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand" href="{{ homeUrl }}" aria-label="{{ 'Stiven Catalyst home' | t(lang) }}"><span class="brand-mark" aria-hidden="true"></span><span>Stiven Catalyst</span></a>
      <p class="footer-small">© <span data-year>{{ year }}</span> Stiven Catalyst. {{ "Clarity into action." | t(lang) }}</p>
      <p class="footer-legal">
        {%- if hasLegal %}<a href="{{ '/impressum.html' | local(lang) }}">{{ "Legal notice" | t(lang) }}</a><a href="{{ '/datenschutz.html' | local(lang) }}">{{ "Privacy" | t(lang) }}</a>{% endif -%}
        <a href="{{ '/how-this-is-made.html' | local(lang) }}">{{ "How this is made" | t(lang) }}</a>
        <a href="{{ feedUrl }}">RSS</a>
        {%- if podcastFeed %}<a href="{{ '/podcast.html' | local(lang) }}">Podcast</a>{% endif %}
      </p>
    </div>
    <nav class="footer-links" aria-label="{{ 'Footer' | t(lang) }}">
      {%- for path, label in [["/start.html", "Start here"], ["/insights.html", "Insights"], ["/reflections.html", "Reflections"], ["/publications.html", "Publications"], ["/downloads.html", "Downloads"], ["/field-notes.html", "Field Notes"], ["/projects.html", "Projects"], ["/tools.html", "Tools"], ["/about.html", "About"], ["/contact.html", "Contact"]] %}
      <a href="{{ path | local(lang) }}">{{ label | t(lang) }}</a>
      {%- endfor %}
    </nav>
  </div>
</footer>
{%- include "partials/share-orbit.njk" %}
<script src="{{ '/script.js' | assetUrl }}" defer></script>
<script src="{{ '/js/share-orbit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/shelf.js' | assetUrl }}" defer></script>
{%- if analyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ analyticsToken }}"}'></script>
{%- endif %}
{%- if toolFamily %}
<script src="{{ '/js/family-sky.js' | assetUrl }}" defer></script>
{%- endif %}
</body>
</html>

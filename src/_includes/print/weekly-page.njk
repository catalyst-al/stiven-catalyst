{#- One page of a monthly issue of the Management Review, as the print (src/guide-print/weekly.njk) and the reader
    (src/_includes/pages/weekly-issue.njk) both show it. Needs page (the page), n (its number), issue, I (the issue in
    this language), W (weekly[lang]), L (its labels), lang and essays. The charts come ready from weekly.js (b.svg).
    "Nga terreni" draws its issues written the same way with these pages too: its W carries its own name, masthead,
    picture and list of issues (magazine.js), and I.coverTheme the title of its cover. -#}
{%- macro chrome(number, section) -%}
<header class="run"><span>{{ W.name }} · {{ L.no }} {{ issue.no }} · {{ I.date }}</span>{% if section %}<span class="run-section">{{ section }}</span>{% endif %}</header>
<footer class="foot"><span>stivencatalyst.com</span><span>Stiven Catalyst</span><span class="num">{{ number }}</span></footer>
{%- endmacro -%}
{%- if page.type == "cover" %}
<section class="pg cover wk-cover">
  <div class="mast"><span>Stiven Catalyst</span><span>{{ I.edition }} · {{ I.date }}</span></div>
  <div class="mast-rule"></div>
  <div class="cover-main">
    <div>
      <div class="masthead">{{ W.mast[0] }}<span class="accent">{{ W.mast[1] }}</span></div>
      <p class="cover-tag">{{ W.tagline }}</p>
      <div class="cover-rule"></div>
      <p class="wk-chip">{{ I.blockName }}</p>
      <div class="cover-theme">{{ (I.coverTheme or I.theme)[0] }}<span class="accent">{{ (I.coverTheme or I.theme)[1] }}</span></div>
      <p class="cover-sub">{{ I.sub }}</p>
    </div>
    <div class="wk-art"><img src="{{ W.cover.src }}" alt=""><p class="wk-no"><small>{{ L.no }}</small>{{ issue.no }}</p></div>
  </div>
  {%- if I.figure %}
  <div class="wk-figure-cover"><b>{{ I.figure.n }}</b><p>{{ I.figure.t }}<i>{{ I.figure.by }}</i></p></div>
  {%- endif %}
  <div class="wk-teasers">
    <p class="k">{{ L.inside }}</p>
    <ol>{% for t in I.teasers %}<li><span class="wk-t-kick">{{ t.kicker }}</span><b>{{ t.title }}</b><span class="wk-t-page">{{ L.page }} {{ t.number | pad }}</span></li>{% endfor %}</ol>
  </div>
  <p class="cover-foot">stivencatalyst.com</p>
</section>
{%- elif page.type == "intro" %}
<section class="pg">
  {{ chrome(n, I.blockName) }}
  <p class="kicker">{{ L.no }} {{ issue.no }} · {{ I.blockName }}</p>
  <h2>{{ W.intro.title }}</h2>
  <p class="lead">{{ page.why }}</p>
  <div class="body-text"><p>{{ page.body }}</p></div>
  <p class="wk-byline">Stiven Janaqi<span>{{ L.editor }} · Stiven Catalyst</span></p>
  <ol class="wk-toc">
    {%- for item in I.pages %}{% if item.heading %}<li><b>{{ loop.index | pad }}</b><span><i>{{ item.kicker }}</i>{{ item.heading }}</span></li>{% endif %}{% endfor %}
    <li><b>{{ issue.pageOf.sources | pad }}</b><span><i>{{ L.sources }}</i>{{ W.sourcesPage.kicker }}</span></li>
  </ol>
  <p class="block-label">{{ W.intro.how }}</p>
  <div class="wk-legend-box">{% for item in W.legend %}<div><h4>{{ item.h }}</h4><p>{{ item.p }}</p></div>{% endfor %}</div>
</section>
{%- elif page.type == "sources" %}
<section class="pg{{ ' is-dense' if issue.sources.length > 6 }}">
  {{ chrome(n, L.sources) }}
  <p class="kicker">{{ W.sourcesPage.kicker }}</p>
  <h2>{{ W.sourcesPage.title[0] }}<span class="accent">{{ W.sourcesPage.title[1] }}</span></h2>
  <p class="lead">{{ W.sourcesPage.lead }}</p>
  <ol class="src">{% for s in issue.sources %}<li>{{ s.title }}<em>{{ s.by }}, {{ s.year }}{% if s.via %} · {{ L.via }} {{ s.via }}{% endif %}</em>{% if s.url %}<i>{{ s.url }}</i>{% endif %}</li>{% endfor %}</ol>
  <div class="bottom"><div class="callout wk-method"><span class="label">{{ W.sourcesPage.method }}</span><p>{{ W.sourcesPage.methodText }}</p></div></div>
</section>
{%- elif page.type == "back" %}
<section class="pg back">
  <img src="{{ W.cover.src }}" alt="">
  <div class="masthead">{{ W.mast[0] }}<span class="accent">{{ W.mast[1] }}</span></div>
  <p class="cover-tag">{{ W.tagline }}</p>
  <p>{{ W.back.line }}</p>
  <p class="monthly">{{ W.back.all }}</p>
  <p class="url">stivencatalyst.com{{ W.archiveUrl | local(lang) }}</p>
  <p class="edition">{{ W.name }} · {{ L.no }} {{ issue.no }} · {{ I.date }} · Stiven Catalyst</p>
</section>
{%- else %}
<section class="pg">
  {{ chrome(n, I.blockName) }}
  <p class="kicker">{{ page.kicker }}</p>
  {%- if page.title %}<h2>{{ page.title[0] }}<span class="accent">{{ page.title[1] }}</span></h2>{% endif %}
  {%- if page.lead %}<p class="lead">{{ page.lead }}</p>{% endif %}
  {%- include "print/review-blocks.njk" %}
  {%- include "print/review-bottom.njk" %}
</section>
{%- endif %}

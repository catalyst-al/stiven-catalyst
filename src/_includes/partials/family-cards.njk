{#- One card per tool family, each linking to its section on the Tools page (familyLink is that page, or "" on it). Needs toolList. -#}
  {%- for family in families %}
  {%- set count = (family | familyTools(toolList, lang)).length %}
  <a class="family-card family-{{ family.id }}" href="{{ familyLink }}#{{ family.id }}" style="--family: {{ family.color }}">
    <span class="family-visual" aria-hidden="true"><span class="family-orbit"><i></i></span><span class="family-planet"></span></span>
    <span class="family-card-text">
      <span class="family-role">{{ family.role | t(lang) }}</span>
      <strong>{{ family.name }}</strong>
      <span class="family-line">{{ family.line | t(lang) }}</span>
      <span class="family-count">{{ ("1 tool" if count == 1 else "{n} tools") | t(lang) | replace("{n}", count) }} <span aria-hidden="true">{{ "→" if familyLink else "↓" }}</span></span>
    </span>
  </a>
  {%- endfor %}

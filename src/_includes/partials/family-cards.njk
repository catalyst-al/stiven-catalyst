{#- One card per role (families.json). With familyLink set (the homepage) each card opens its role page;
    on the Tools page (familyLink "") it jumps to the role's section below. Needs toolList. -#}
  {%- for family in families %}
  {%- set count = (family | familyTools(toolList, lang)).length + (family | familyTools(toolList, lang, "learn")).length %}
  <a class="family-card family-{{ family.id }}" href="{{ (family | roleUrl(lang)) if familyLink else '#' + family.id }}" style="--family: {{ family.color }}">
    <span class="family-visual" aria-hidden="true"><span class="family-orbit"><i></i></span><span class="family-planet"></span></span>
    <span class="family-card-text">
      <span class="family-role">{{ family.name }} · {{ family.scope | t(lang) }}</span>
      <strong>{{ family.role | t(lang) }}</strong>
      <span class="family-line">{{ family.line | t(lang) }}</span>
      <span class="family-count">{{ ("1 tool" if count == 1 else "{n} tools") | t(lang) | replace("{n}", count) }} <span aria-hidden="true">{{ "→" if familyLink else "↓" }}</span></span>
    </span>
  </a>
  {%- endfor %}

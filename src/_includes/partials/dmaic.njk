{#- The Six Sigma DMAIC course. The page sets `cfg` to its data file; dmaic.js does the rest. -#}
<nav class="shell dm-nav" aria-label="{{ 'Course steps' | t(lang) }}" data-dm-nav>
  <ol class="dm-steps">
    {%- for m in cfg.modules %}
    <li><a href="#dm-{{ m.id }}" data-step="{{ m.id }}"><span class="dm-step-letter">{{ m.letter }}</span><span class="dm-step-name">{{ m.nav or m.name }}</span></a></li>
    {%- endfor %}
  </ol>
  <div class="dm-progress">
    <div class="bar-track"><div class="bar-fill" data-progress-bar></div></div>
    <p class="form-note" data-progress-text aria-live="polite">{{ "Answer the questions to track your progress." | t(lang) }}</p>
  </div>
  <p class="dm-more"><a class="inline-link" href="#dm-wastes">{{ "8 wastes" | t(lang) }}</a><a class="inline-link" href="#dm-glossary">{{ "Glossary" | t(lang) }}</a><a class="inline-link" href="#dm-charter">{{ "Project charter" | t(lang) }}</a></p>
</nav>

<section class="shell dm-case">
  <p class="kicker">{{ "Throughout the course" | t(lang) }}</p>
  <h2>{{ cfg.case.title }}</h2>
  <p>{{ cfg.case.text }}</p>
</section>

{%- for m in cfg.modules %}
{%- set mi = loop.index0 %}
<section class="shell dm-module" id="dm-{{ m.id }}" data-module="{{ m.id }}">
  <header class="dm-module-head">
    <span class="dm-letter" aria-hidden="true">{{ m.letter }}</span>
    <div>
      <p class="kicker">{{ "Step {n} of 5" | t(lang) | replace("{n}", loop.index) }} · {{ "Output" | t(lang) }}: {{ m.output }}</p>
      <h2>{{ m.name }}</h2>
      <p class="dm-goal">{{ m.goal }}</p>
    </div>
  </header>

  <div class="dm-grid">
    <div class="dm-col">
      <h3 class="result-label">{{ "Key ideas" | t(lang) }}</h3>
      <dl class="dm-ideas">
        {%- for idea in m.ideas %}
        <div><dt>{{ idea[0] }}</dt><dd>{{ idea[1] }}</dd></div>
        {%- endfor %}
      </dl>
      <h3 class="result-label">{{ "Common mistakes" | t(lang) }}</h3>
      <ul class="tips dm-mistakes">
        {%- for item in m.mistakes %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </div>
    <article class="result-card dm-case-card">
      <p class="result-label">{{ "In the case" | t(lang) }}</p>
      <dl class="dm-case-rows">
        {%- for row in m.case %}
        <div><dt>{{ row[0] }}</dt><dd>{{ row[1] }}</dd></div>
        {%- endfor %}
      </dl>
      <p class="result-label">{{ "Tools for this step" | t(lang) }}</p>
      <ul class="dm-tools">
        {%- for tool in m.tools %}
        <li><a class="text-link" href="{{ tool[1] | local(lang) }}">{{ tool[0] }} <span aria-hidden="true">→</span></a> <span>{{ tool[2] }}</span></li>
        {%- endfor %}
      </ul>
    </article>
  </div>

  <div class="dm-grid dm-grid-check">
    <div class="dl-box">
      <p class="kicker">{{ "Before you move on" | t(lang) }}</p>
      <ul class="dm-checklist">
        {%- for item in m.checklist %}
        <li><label class="dl-check-item"><input type="checkbox" data-check="{{ m.id }}-{{ loop.index0 }}"><span>{{ item }}</span></label></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="dl-box dm-quiz" data-quiz="{{ m.id }}">
      <p class="kicker">{{ "Check yourself" | t(lang) }}</p>
      {%- for q in m.quiz %}
      {%- set qi = loop.index0 %}
      <fieldset class="dm-question" data-question="{{ qi }}">
        <legend><span class="statement-number">{{ loop.index | pad }}</span>{{ q.q }}</legend>
        <div class="dm-options">
          {%- for option in q.options %}
          <label class="dm-option"><input type="radio" name="q-{{ m.id }}-{{ qi }}" value="{{ loop.index0 }}"><span>{{ option }}</span></label>
          {%- endfor %}
        </div>
        <p class="dm-feedback" data-feedback aria-live="polite" hidden></p>
      </fieldset>
      {%- endfor %}
      <p class="form-note dm-score" data-score></p>
    </div>
  </div>
</section>
{%- endfor %}

<section class="shell dm-extra" id="dm-wastes">
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "Lean basics" | t(lang) }}</p>
      <h2>{{ "The eight wastes in the warehouse" | t(lang) }}</h2>
    </div>
    <p>{{ "DOWNTIME: eight kinds of work the customer does not pay for. Walk one shift and write down one example of each." | t(lang) }}</p>
  </div>
  <div class="dm-wastes">
    {%- for w in cfg.wastes %}
    <article class="dm-waste">
      <span class="dm-waste-letter" aria-hidden="true">{{ w[0] }}</span>
      <h3>{{ w[1] }}</h3>
      <p>{{ w[2] }}</p>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="shell dm-extra" id="dm-glossary">
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "Words you will hear" | t(lang) }}</p>
      <h2>{{ "Glossary" | t(lang) }}</h2>
    </div>
    <p>{{ "The terms used in this course and in the tools, in plain words." | t(lang) }}</p>
  </div>
  <dl class="dm-glossary">
    {%- for term in cfg.glossary %}
    <div><dt>{{ term[0] }}</dt><dd>{{ term[1] }}</dd></div>
    {%- endfor %}
  </dl>
</section>

{#- The certificate of the course: shown once every step is complete (dmaic.js), printed on its own A4 page. -#}
<section class="shell dm-extra dm-certificate" id="dm-certificate" data-certificate hidden>
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "Course complete" | t(lang) }}</p>
      <h2>{{ "Your certificate" | t(lang) }}</h2>
    </div>
    <p>{{ "Every question of the five steps answered right. Write your name as it should stand on the certificate and print it or save it as PDF." | t(lang) }}</p>
  </div>
  <div class="dl-box">
    <div class="field">
      <label for="dm-cert-name">{{ "Your name" | t(lang) }}</label>
      <input id="dm-cert-name" name="certName" autocomplete="name" data-cert-name>
    </div>
    <div class="tool-actions">
      <button class="button-primary" type="button" data-cert-print>{{ "Print the certificate" | t(lang) }}</button>
      <a class="button-secondary" href="{{ '/tools/project-portfolio/' | local(lang) }}">{{ "Start a real project in the Project Portfolio" | t(lang) }}</a>
    </div>
  </div>
  <div class="dm-cert-sheet" data-cert-sheet aria-hidden="true">
    <p class="dm-cert-kicker">Stiven Catalyst · {{ "Self-study course" | t(lang) }}</p>
    <p class="dm-cert-title">{{ "Certificate of completion" | t(lang) }}</p>
    <p class="dm-cert-name" data-cert-sheet-name></p>
    <p class="dm-cert-line">{{ "has completed the course" | t(lang) }}</p>
    <p class="dm-cert-course">{{ title }}</p>
    <p class="dm-cert-line">{{ "Define, Measure, Analyze, Improve, Control: every step read and every question answered right." | t(lang) }}</p>
    <p class="dm-cert-date" data-cert-sheet-date></p>
    <p class="dm-cert-note">{{ "A record of self-study. It is not an accredited Six Sigma certification." | t(lang) }}</p>
  </div>
</section>

<section class="shell dm-extra dm-charter" id="dm-charter" data-print-fields>
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "Your project" | t(lang) }}</p>
      <h2>{{ "DMAIC project charter" | t(lang) }}</h2>
    </div>
    <p>{{ "One page that the team and the sponsor agree on before measuring starts. Fill it in, print it and bring it to the first meeting." | t(lang) }}</p>
  </div>
  <form class="dl-box" data-charter>
    <div class="worksheet-grid dm-charter-grid">
      {%- for f in cfg.charter %}
      <div class="field{% if f[3] %} wide{% endif %}">
        <label for="ch-{{ f[0] }}">{{ f[1] }}</label>
        {%- if f[3] %}
        <textarea id="ch-{{ f[0] }}" name="{{ f[0] }}" rows="2" placeholder="{{ f[2] }}"></textarea>
        {%- else %}
        <input id="ch-{{ f[0] }}" name="{{ f[0] }}" placeholder="{{ f[2] }}" autocomplete="off">
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
    <div class="tool-actions">
      <button class="button-primary" type="button" data-charter-print>{{ "Print or save as PDF" | t(lang) }}</button>
      <button class="button-secondary" type="button" data-charter-copy>{{ "Copy as text" | t(lang) }}</button>
      <button class="button-secondary" type="button" data-charter-example>{{ "Fill with the course case" | t(lang) }}</button>
      <button class="button-secondary" type="button" data-charter-clear>{{ "Clear" | t(lang) }}</button>
    </div>
    <p class="form-note" data-charter-status aria-live="polite">{{ "Your charter is kept only in this browser." | t(lang) }}</p>
  </form>
</section>

<script type="application/json" id="dmaic-data">{{ cfg | scriptJson | safe }}</script>
<script src="{{ '/js/tool-kit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/dmaic.js' | assetUrl }}" defer></script>

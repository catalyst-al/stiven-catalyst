{#- The homepage hero: the Catalyst light in the centre, the roles on its orbits (js/cosmos.js). -#}
<section class="cosmos" data-cosmos>
  <canvas class="cosmos-canvas" aria-hidden="true"></canvas>
  <div class="shell cosmos-inner">
    <div class="cosmos-copy">
      <p class="eyebrow">{{ "Free tools and essays for people who run shifts, teams and operations" | t(lang) }}</p>
      <h1>
        <span class="line">{{ "Management" | t(lang) }}</span>
        <span class="line act">{{ "without theatre." | t(lang) }}</span>
      </h1>
      <p class="hero-copy"><strong>{{ "Free tools for the people who run the work:" | t(lang) }}</strong> {{ "damage rate, late routes, shift handover, Pareto, CV. No account, no cookies; your data stays on your device." | t(lang) }}</p>
      <div class="hero-actions">
        {#- The two first steps carry light too: a sweep of light crosses the tools button now and then, with a soft
            blue glow and an arrow that leans forward; the essays button carries the lit bulb in a warm frame. -#}
        <a class="button-primary hero-go" href="{{ '/tools.html' | local(lang) }}"><span class="hero-go-label">{{ "Try the tools" | t(lang) }}</span><span class="hero-go-arrow" aria-hidden="true">→</span></a>
        <a class="button-secondary hero-read" href="{{ '/insights.html' | local(lang) }}"><i class="hero-bulb" aria-hidden="true"></i>{{ "Read the essays" | t(lang) }}</a>
        {#- Two ways straight in, each with the lit bulb of the logo: the monthly Management Review, the site's own
            publication (the masthead, its second word in blue, and how many issues it has), and the Reflections, the
            personal pieces (in the gold the site keeps for them, and how many there are). -#}
        {%- set wl = weekly[lang or "en"] %}
        {%- set reflectionCount = (collections["reflections" + (lang | langSuffix)] | published).length %}
        <div class="hero-cards">
          <a class="hero-review" href="{{ wl.archiveUrl | local(lang) }}">
            <i class="hero-bulb" aria-hidden="true"></i>
            <span class="hero-review-mast">{{ wl.mast[0] }} <b>{{ wl.mast[1] }}</b></span>
            <small>{{ wl.archive.eyebrow }} · <span>{{ wl.labels.no }} 1–{{ weekly.latest.number }}</span></small>
            <span class="hero-review-arrow" aria-hidden="true">→</span>
          </a>
          <a class="hero-review hero-reflections" href="{{ '/reflections.html' | local(lang) }}">
            <i class="hero-bulb" aria-hidden="true"></i>
            <span class="hero-review-mast">{{ "Reflections" | t(lang) }}</span>
            <small>{{ "Personal essays" | t(lang) }} · <span>{{ "{n} reflections" | t(lang) | replace("{n}", reflectionCount) }}</span></small>
            <span class="hero-review-arrow" aria-hidden="true">→</span>
          </a>
          {#- And the CV, in the silver of Atlas (the career orbit), across the width under the two. -#}
          <a class="hero-review hero-cv" href="{{ '/tools/cv-builder/' | local(lang) }}">
            <i class="hero-bulb" aria-hidden="true"></i>
            <span class="hero-review-mast">{{ "Build your CV" | t(lang) }}</span>
            <small>{{ "CV Builder" | t(lang) }} · {{ "ATS CV" | t(lang) }} · {{ "Cover Letter" | t(lang) }}</small>
            <span class="hero-review-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="cosmos-system">
      <div class="cosmos-anchor" data-cosmos-anchor></div>
      <p class="cosmos-hint" data-cosmos-hint>{{ "Drag to turn the system. Tap a planet to open its tools, a moon to open one of them." | t(lang) }}</p>
      {#- The motion runs on its own, so it can be stopped (js/cosmos.js shows the button unless motion is reduced). -#}
      <button class="cosmos-pause" type="button" data-cosmos-pause data-play-label="{{ 'Play the motion' | t(lang) }}" hidden>{{ "Pause the motion" | t(lang) }}</button>
      <div class="cosmos-families" role="group" aria-label="{{ 'Roles' | t(lang) }}">
        {%- for family in families %}
        <button class="cosmos-chip" type="button" data-family="{{ family.id }}" aria-expanded="false" aria-controls="family-{{ family.id }}" style="--family: {{ family.color }}"><span class="cosmos-chip-dot" aria-hidden="true"></span><span class="cosmos-chip-text"><b>{{ family.name }}</b> <small>{{ family.role | t(lang) }}</small></span></button>
        {%- endfor %}
      </div>
      {%- for family in families %}
      <div class="cosmos-family" id="family-{{ family.id }}" data-family-panel="{{ family.id }}" data-name="{{ family.name }}" data-color="{{ family.color }}" data-orbit="{{ family.orbit }}" style="--family: {{ family.color }}">
        <p class="cosmos-family-head"><strong>{{ family.name }}</strong><span>{{ family.role | t(lang) }}</span></p>
        <p class="cosmos-family-line">{{ family.line | t(lang) }}</p>
        <ul>
          {%- for tool in (family | familyTools(toolList, lang)).concat(family | familyTools(toolList, lang, "learn")) %}
          <li><a href="{{ tool.url }}"><span>{{ tool.name }}</span><small>{{ tool.type }}</small><span aria-hidden="true">→</span></a></li>
          {%- endfor %}
        </ul>
        <a class="cosmos-family-role" href="{{ family | roleUrl(lang) }}">{{ "Open the planet" | t(lang) }} <span aria-hidden="true">→</span></a>
      </div>
      {%- endfor %}
    </div>

    {#- Under the hero, small, as on Publications: the book, the newest issue of the monthly Management Review (the edition
        and its month on top, as the author asked), the newest volume of the operational treatise, the newest issue of the
        magazine and the Tools Guide. -#}
    {%- set ml = lang or "en" %}
    {%- set book = books[ml] or books.sq %}
    {%- set issue = magazine.latest %}
    {%- set wk = weekly.latest %}
    {%- set tv = treatise.latest %}
    {%- set shelf = [
      { url: "/books/mall-per-durresin.html" | local(lang), cover: book.pages[0], kicker: ("The book · in Albanian" if book.language == "sq" else "The book · translated from the Albanian") | t(lang), title: book.title, titleLang: book.language if book.language != ml else "", open: "Open the book" | t(lang) },
      { url: ("/magazine/" + wk.slug + ".html") | local(lang), cover: magazinePages[wk.slug][ml].pages[0], kicker: wk[ml].edition + " · " + wk[ml].date, title: wk[ml].heading, open: weekly[ml].labels.open_no | replace("{n}", wk.no) },
      { url: ("/magazine/" + tv.slug + ".html") | local(lang), cover: magazinePages[tv.slug][ml].pages[0], kicker: treatise[ml].short + " · " + treatise[ml].labels.volume + " " + tv.number, title: tv[ml].heading, open: treatise[ml].labels.open_vol | replace("{n}", tv.number) },
      { url: ("/magazine/" + issue.slug + ".html") | local(lang), cover: magazinePages[issue.slug][ml].pages[0], kicker: magazine.names[ml].name + " · " + issue[ml].date, title: issue[ml].theme, open: "Open the issue" | t(lang) },
      { url: "/guides/tools-guide.html" | local(lang), cover: toolsGuidePages[ml].pages[0], kicker: ("The guide · Edition {n}" | t(lang) | replace("{n}", toolsGuide.edition)), title: toolsGuide[ml].title, open: "Open the guide" | t(lang) }
    ] %}
    <div class="book-shelf hero-shelf">
      <a class="hero-shelf-label" href="{{ '/publications.html' | local(lang) }}">{{ "Publications" | t(lang) }} <span aria-hidden="true">→</span></a>
      {%- for item in shelf %}
      <a class="book-shelf-item" href="{{ item.url }}">
        <span class="book-object" aria-hidden="true"><span class="book-object-cover"><img src="{{ item.cover.image }}" srcset="{{ item.cover.image | srcsetFor }}" sizes="78px" width="{{ item.cover.width }}" height="{{ item.cover.height }}" alt="" loading="lazy"></span></span>
        <span class="book-shelf-text"><small>{{ item.kicker }}</small><strong{% if item.titleLang %} lang="{{ item.titleLang }}"{% endif %}>{{ item.title }}</strong><span>{{ item.open }} →</span></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
<script src="{{ '/js/cosmos.js' | assetUrl }}" defer></script>

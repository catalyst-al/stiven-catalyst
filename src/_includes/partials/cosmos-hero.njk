{#- The homepage hero: the Catalyst light in the centre, the roles on its orbits (js/cosmos.js). -#}
<section class="cosmos" data-cosmos>
  <canvas class="cosmos-canvas" aria-hidden="true"></canvas>
  <div class="shell cosmos-inner">
    <div class="cosmos-copy">
      <p class="eyebrow">{{ "Free tools and essays for people who run shifts, teams and operations" | t(lang) }}</p>
      <h1>
        <span class="line">{{ "Management" | t(lang) }}</span>
        <span class="line act">{{ "without theatre." | t(lang) }}</span>
      </h1>
      <p class="hero-copy"><strong>{{ "Free tools for the people who run the work:" | t(lang) }}</strong> {{ "damage rate, late routes, shift handover, Pareto, CV. No account, no tracking; your data stays on your device." | t(lang) }}</p>
      <div class="hero-actions">
        <a class="button-primary" href="{{ '/tools.html' | local(lang) }}">{{ "Try the tools" | t(lang) }}</a>
        <a class="button-secondary" href="{{ '/insights.html' | local(lang) }}">{{ "Read the essays" | t(lang) }}</a>
      </div>
    </div>

    <div class="cosmos-system">
      <div class="cosmos-anchor" data-cosmos-anchor></div>
      <p class="cosmos-hint" data-cosmos-hint>{{ "Drag to turn the system. Tap a planet to open its tools, a moon to open one of them." | t(lang) }}</p>
      <div class="cosmos-families" role="group" aria-label="{{ 'Roles' | t(lang) }}">
        {%- for family in families %}
        <button class="cosmos-chip" type="button" data-family="{{ family.id }}" aria-expanded="false" aria-controls="family-{{ family.id }}" style="--family: {{ family.color }}"><span class="cosmos-chip-dot" aria-hidden="true"></span><span class="cosmos-chip-text"><b>{{ family.name }}</b> <small>{{ family.role | t(lang) }}</small></span></button>
        {%- endfor %}
      </div>
      {%- for family in families %}
      <div class="cosmos-family" id="family-{{ family.id }}" data-family-panel="{{ family.id }}" data-name="{{ family.name }}" data-color="{{ family.color }}" data-orbit="{{ family.orbit }}" style="--family: {{ family.color }}">
        <p class="cosmos-family-head"><strong>{{ family.name }}</strong><span>{{ family.role | t(lang) }}</span></p>
        <p class="cosmos-family-line">{{ family.line | t(lang) }}</p>
        <ul>
          {%- for tool in (family | familyTools(toolList, lang)).concat(family | familyTools(toolList, lang, "learn")) %}
          <li><a href="{{ tool.url }}"><span>{{ tool.name }}</span><small>{{ tool.type }}</small><span aria-hidden="true">→</span></a></li>
          {%- endfor %}
        </ul>
        <a class="cosmos-family-role" href="{{ family | roleUrl(lang) }}">{{ "Open the planet" | t(lang) }} <span aria-hidden="true">→</span></a>
      </div>
      {%- endfor %}
    </div>

    {#- Under the hero, small, as on Publications: the book, the newest weekly Management Review, the newest issue of
        the magazine and the Tools Guide. -#}
    {%- set ml = lang or "en" %}
    {%- set issue = magazine.latest %}
    {%- set wk = weekly.latest %}
    {%- set shelf = [
      { url: "/books/mall-per-durresin.html" | local(lang), cover: book.pages[0], kicker: "The book · in Albanian" | t(lang), title: book.title, titleLang: "sq", open: "Open the book" | t(lang) },
      { url: ("/magazine/" + wk.slug + ".html") | local(lang), cover: magazinePages[wk.slug][ml].pages[0], kicker: weekly.name + " · " + weekly[ml].labels.no + " " + wk.no, title: wk[ml].heading, open: weekly[ml].labels.open_issue },
      { url: ("/magazine/" + issue.slug + ".html") | local(lang), cover: magazinePages[issue.slug][ml].pages[0], kicker: magazine.names[ml].name + " · " + issue[ml].date, title: issue[ml].theme, open: "Open the issue" | t(lang) },
      { url: "/guides/tools-guide.html" | local(lang), cover: toolsGuidePages[ml].pages[0], kicker: "The guide · Edition 1" | t(lang), title: toolsGuide[ml].title, open: "Open the guide" | t(lang) }
    ] %}
    <div class="book-shelf hero-shelf">
      <a class="hero-shelf-label" href="{{ '/publications.html' | local(lang) }}">{{ "Publications" | t(lang) }} <span aria-hidden="true">→</span></a>
      {%- for item in shelf %}
      <a class="book-shelf-item" href="{{ item.url }}">
        <span class="book-object" aria-hidden="true"><span class="book-object-cover"><img src="{{ item.cover.image }}" srcset="{{ item.cover.image | srcsetFor }}" sizes="78px" width="{{ item.cover.width }}" height="{{ item.cover.height }}" alt="" loading="lazy"></span></span>
        <span class="book-shelf-text"><small>{{ item.kicker }}</small><strong{% if item.titleLang %} lang="{{ item.titleLang }}"{% endif %}>{{ item.title }}</strong><span>{{ item.open }} →</span></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
<script src="{{ '/js/cosmos.js' | assetUrl }}" defer></script>

{#- The KPI Diagnostic. The page sets `cfg` to its data file; kpi-diagnostic.js does the rest. -#}
<section class="shell tool-layout">
  <form class="tool-panel diagnostic" data-diagnostic novalidate>
    <div class="field">
      <label for="kpi-name">{{ "Which KPI?" | t(lang) }} <span class="optional">{{ "optional" | t(lang) }}</span></label>
      <input id="kpi-name" name="kpi" placeholder="{{ 'e.g. Delivery delays, room readiness, picking errors' | t(lang) }}" autocomplete="off">
    </div>

    <ol class="statement-list">
      {%- for s in cfg.statements %}
      {%- set qi = loop.index0 %}
      <li>
        <fieldset class="statement">
          <legend><span class="statement-number">{{ loop.index | pad }}</span>{{ s.text }}</legend>
          <div class="scale">
            {%- for label in cfg.scale %}
            <label class="scale-option">
              <input type="radio" name="q{{ qi }}" value="{{ loop.index0 }}" data-cause="{{ s.cause }}">
              <span>{{ label }}</span>
            </label>
            {%- endfor %}
          </div>
        </fieldset>
      </li>
      {%- endfor %}
    </ol>

    <div class="tool-actions">
      <button class="button-primary" type="submit">{{ "See the result" | t(lang) }}</button>
      <p class="form-note" data-progress aria-live="polite">{{ "{a} of {b} answered" | t(lang) | replace("{a}", 0) | replace("{b}", cfg.statements.length) }}</p>
    </div>
  </form>

  <aside class="tool-aside">
    <p class="kicker">{{ "How it works" | t(lang) }}</p>
    <p>{{ "Each statement points to one of five causes from the essay" | t(lang) }} <a class="inline-link" href="{{ '/de/insights/kpi-is-not-the-problem/' if lang == 'de' else '/article-kpi.html' }}">{{ "The KPI is not the problem" | t(lang) }}</a>{{ ": clarity, skill, capacity, process design and ownership." | t(lang) }}</p>
    <p>{{ "The result shows which cause fits your situation best, with three first moves and one question to ask on the floor." | t(lang) }}</p>
    <p class="privacy-note">{{ "Everything stays in your browser. Nothing you enter is sent or stored." | t(lang) }}</p>
  </aside>
</section>

<section class="shell tool-result" data-result hidden tabindex="-1" aria-live="polite"></section>

<script type="application/json" id="kpi-diagnostic-data">{{ cfg | dump | safe }}</script>
<script src="{{ '/js/tool-kit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/kpi-diagnostic.js' | assetUrl }}" defer></script>

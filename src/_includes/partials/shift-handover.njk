{#- The Shift Handover. The page sets `cfg` to its data file; shift-handover.js does the rest. -#}
<section class="shell tool-layout dl-setup sh-setup">
  <form class="tool-panel" data-handover novalidate>
    <fieldset class="dl-box">
      <legend class="kicker">1 · {{ "Shift" | t(lang) }}</legend>
      <div class="dl-grid">
        <div class="field">
          <label for="sh-template">{{ "Type of work" | t(lang) }}</label>
          <select id="sh-template" name="template">
            {%- for key, tpl in cfg.templates %}
            <option value="{{ key }}">{{ tpl.name }}</option>
            {%- endfor %}
          </select>
        </div>
        <div class="field">
          <label for="sh-date">{{ "Date" | t(lang) }}</label>
          <input id="sh-date" name="date" type="date">
        </div>
        <div class="field">
          <label for="sh-shift">{{ "Shift" | t(lang) }}</label>
          <select id="sh-shift" name="shift">
            {%- for shift in cfg.shifts %}
            <option>{{ shift }}</option>
            {%- endfor %}
          </select>
        </div>
        <div class="field">
          <label for="sh-area">{{ "Area or team" | t(lang) }}</label>
          <input id="sh-area" name="area" placeholder="{{ 'e.g. Outbound, docks 1–6' | t(lang) }}" autocomplete="off">
        </div>
        <div class="field">
          <label for="sh-from">{{ "Handed over by" | t(lang) }}</label>
          <input id="sh-from" name="from" autocomplete="off">
        </div>
        <div class="field">
          <label for="sh-to">{{ "Taken over by" | t(lang) }}</label>
          <input id="sh-to" name="to" autocomplete="off">
        </div>
      </div>
    </fieldset>

    <fieldset class="dl-box">
      <legend class="kicker">2 · {{ "Numbers at handover" | t(lang) }}</legend>
      <div class="sh-rows" data-metrics></div>
      <div class="sh-metric-actions">
        <button class="button-ghost" type="button" data-add-metric>{{ "+ Add a number" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-fill-logs>{{ "Fill in from the logs" | t(lang) }}</button>
      </div>
      <p class="form-note sh-fill-status" data-fill-status aria-live="polite"></p>
    </fieldset>

    <fieldset class="dl-box">
      <legend class="kicker">3 · {{ "Open issues" | t(lang) }}</legend>
      <p class="form-note sh-help">{{ "One line per issue, with one owner on the next shift and a time. Tick it when it is solved; everything else carries over when you close the shift." | t(lang) }}</p>
      <div class="sh-issues" data-issues></div>
      <button class="button-ghost" type="button" data-add-issue>{{ "+ Add an issue" | t(lang) }}</button>
    </fieldset>

    <fieldset class="dl-box">
      <legend class="kicker">4 · {{ "Heads-up and people" | t(lang) }}</legend>
      <div class="dl-grid sh-grid-2">
        <div class="field">
          <label for="sh-heads">{{ "Heads-up for the next shift" | t(lang) }}</label>
          <textarea id="sh-heads" name="headsUp" rows="4"></textarea>
        </div>
        <div class="field">
          <label for="sh-safety">{{ "Safety and people" | t(lang) }}</label>
          <textarea id="sh-safety" name="safety" rows="4" placeholder="{{ 'Incidents, near misses, absences, new starters' | t(lang) }}"></textarea>
        </div>
      </div>
    </fieldset>

    <fieldset class="dl-box">
      <legend class="kicker">5 · {{ "Handover check" | t(lang) }}</legend>
      <ul class="dm-checklist" data-checklist></ul>
    </fieldset>

    <p class="dl-empty sh-empty" data-empty>{{ "New here?" | t(lang) }} <button class="button-ghost" type="button" data-example>{{ "Load an example shift" | t(lang) }}</button> {{ "to see a full handover." | t(lang) }}</p>
  </form>

  <aside class="tool-aside">
    <p class="kicker">{{ "A good handover" | t(lang) }}</p>
    <ul class="tips">
      <li><strong>{{ "Face to face, with the sheet." | t(lang) }}</strong> {{ "The written handover is the agenda for a two-minute talk, not a replacement for it." | t(lang) }}</li>
      <li><strong>{{ "One owner per issue." | t(lang) }}</strong> {{ '“The early shift” is not an owner. A name is.' | t(lang) }}</li>
      <li><strong>{{ "Numbers, not feelings." | t(lang) }}</strong> {{ '“Backlog is fine” means nothing; “320 parcels, sorted” does.' | t(lang) }}</li>
      <li><strong>{{ "Watch what carries over." | t(lang) }}</strong> {{ "An issue carried three times is not a shift problem any more. Take it through" | t(lang) }} <a class="inline-link" href="{{ '/tools/five-whys/' | local(lang) }}" data-five-whys>5 Whys</a>.</li>
    </ul>
    <p class="privacy-note">{{ "Handovers stay in this browser. Nothing is sent or uploaded. Copy the text to send it through your own channel." | t(lang) }}</p>
  </aside>
</section>

<section class="shell sh-output" data-output tabindex="-1">
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "The handover" | t(lang) }}</p>
      <h2 data-output-title>{{ "Ready to hand over" | t(lang) }}</h2>
      <p class="form-note sh-state" data-transfer-state hidden></p>
    </div>
    <div class="dl-box sh-incoming" data-incoming hidden>
      <p class="sh-ok" data-incoming-text></p>
      <form class="sh-unlock" data-incoming-unlock hidden>
        <label class="field"><span>{{ "Transfer code" | t(lang) }}</span><input name="code" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" required></label>
        <button class="button-primary" type="submit">{{ "Open" | t(lang) }}</button>
        <p class="form-note sh-error" data-incoming-error role="alert"></p>
      </form>
      <div class="sh-preview" data-incoming-preview hidden>
        <p class="kicker">{{ "What it holds" | t(lang) }}</p>
        <ul class="sh-summary" data-incoming-summary></ul>
        <p class="kicker">{{ "Issues" | t(lang) }}</p>
        <ul class="sh-preview-issues" data-incoming-issues></ul>
        <p class="form-note sh-warn" data-incoming-note hidden></p>
      </div>
      <div class="tool-actions">
        <button class="button-primary" type="button" data-incoming-open hidden>{{ "Take over this handover" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-incoming-again hidden>{{ "Take it over again anyway" | t(lang) }}</button>
        <button class="button-ghost" type="button" data-incoming-ignore>{{ "Not now" | t(lang) }}</button>
      </div>
    </div>
    <p>{{ "This is what the next shift reads. It updates as you type." | t(lang) }}</p>
  </div>
  <div class="sh-output-grid">
    <article class="result-card sh-sheet" data-sheet></article>
    <div class="sh-side">
      <div class="dl-box sh-quality" data-quality></div>
      <div class="dl-box">
        <p class="kicker">{{ "Take over" | t(lang) }}</p>
        <p class="form-note sh-help" data-ack-text>{{ "The person taking over confirms they have read it and asked their questions." | t(lang) }}</p>
        <div class="tool-actions">
          <button class="button-secondary" type="button" data-ack>{{ "Confirm takeover" | t(lang) }}</button>
        </div>
        <div class="sh-ack-code" data-ack-code hidden>
          <p class="form-note sh-help">{{ "Give the sender this confirmation code, by voice or in your own message. It proves on their device that you took over." | t(lang) }}</p>
          <p class="sh-code" data-ack-code-text aria-live="polite"></p>
          <div class="tool-actions">
            <button class="button-secondary" type="button" data-ack-code-copy>{{ "Copy the code" | t(lang) }}</button>
            <button class="button-ghost" type="button" data-ack-code-link>{{ "Copy a confirmation link" | t(lang) }}</button>
          </div>
        </div>
        <form class="sh-verify" data-ack-verify hidden>
          <p class="form-note sh-help">{{ "When the next shift has taken over on their device, they get a confirmation code. Type it here." | t(lang) }}</p>
          <div class="sh-verify-fields">
            <label class="field"><span>{{ "Confirmation code" | t(lang) }}</span><input name="code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABC-DEF" required></label>
            <label class="field"><span>{{ "Confirmed by" | t(lang) }}</span><input name="by" type="text" autocomplete="off"></label>
            <button class="button-secondary" type="submit">{{ "Check the code" | t(lang) }}</button>
          </div>
          <p class="form-note sh-error" data-ack-verify-status role="alert"></p>
        </form>
        <p class="form-note sh-file-open"><label class="button-ghost work-backup-open">{{ "Open a handover file" | t(lang) }}<input type="file" accept=".json,application/json" data-incoming-file></label></p>
      </div>
      <div class="tool-actions sh-actions">
        <button class="button-primary" type="button" data-copy>{{ "Copy as text" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-send>{{ "Send to the next shift" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-print>{{ "Print or save as PDF" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-close>{{ "Close shift, start the next" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-clear>{{ "Clear" | t(lang) }}</button>
      </div>
      <p class="form-note" data-status aria-live="polite"></p>
      <dialog class="sh-send" data-send-dialog aria-labelledby="sh-send-title">
        <h2 id="sh-send-title">{{ "Send this handover to another device" | t(lang) }}</h2>
        <div data-send-step="prepare">
          <p class="form-note sh-help">{{ "This is what goes. The handover is sealed with a transfer code and travels inside a link, a QR code or a file, never through a server; without the code it cannot be read." | t(lang) }}</p>
          <ul class="sh-summary" data-send-summary></ul>
          <label class="sh-check"><input type="checkbox" data-send-names> {{ "Include the names of people (who hands over, who takes over, the owners of the issues)" | t(lang) }}</label>
          <div class="sh-warn" data-send-warnings hidden>
            <p class="form-note">{{ "Check before sending; this looks personal or confidential:" | t(lang) }}</p>
            <ul></ul>
          </div>
          <p class="form-note sh-help">{{ "The texts of the issues, the heads-up and the safety note travel as typed: read them once for guests’ names or card details." | t(lang) }}</p>
          <label class="field"><span>{{ "Transfer code" | t(lang) }}</span><input data-send-code type="text" autocomplete="off" autocapitalize="none" spellcheck="false"></label>
          <p class="form-note sh-help">{{ "Tell the code to the next shift in person or by phone, never in the same message as the link. Keep it: their confirmation code is checked with it." | t(lang) }}</p>
          <div class="tool-actions">
            <button class="button-primary" type="button" data-send-make>{{ "Seal and make the link" | t(lang) }}</button>
            <button class="button-ghost" type="button" data-send-newcode>{{ "New code" | t(lang) }}</button>
            <button class="button-ghost" type="button" data-send-close>{{ "Close" | t(lang) }}</button>
          </div>
          <p class="form-note sh-error" data-send-prepare-status role="alert"></p>
        </div>
        <div data-send-step="share" hidden>
          <p class="form-note" data-send-sealed></p>
          <div class="sh-qr" data-send-qr hidden></div>
          <p class="form-note sh-help" data-send-qr-note></p>
          <label class="field">
            <span>{{ "Link" | t(lang) }}</span>
            <textarea class="sh-link" data-send-link rows="3" readonly></textarea>
          </label>
          <div class="tool-actions">
            <button class="button-primary" type="button" data-send-share hidden>{{ "Share the link" | t(lang) }}</button>
            <button class="button-secondary" type="button" data-send-copy>{{ "Copy the link" | t(lang) }}</button>
            <button class="button-secondary" type="button" data-send-file>{{ "Save as a file" | t(lang) }}</button>
            <button class="button-ghost" type="button" data-send-shown hidden>{{ "I showed the QR code" | t(lang) }}</button>
            <button class="button-ghost" type="button" data-send-close>{{ "Close" | t(lang) }}</button>
          </div>
          <p class="form-note" data-send-status aria-live="polite"></p>
        </div>
      </dialog>
    </div>
  </div>
</section>

<section class="shell sh-history" data-history-section hidden>
  <div class="section-heading">
    <div>
      <p class="kicker">{{ "History" | t(lang) }}</p>
      <h2>{{ "Earlier handovers" | t(lang) }}</h2>
    </div>
    <p>{{ "The last 30 closed shifts on this device. Open one to read or copy it." | t(lang) }}</p>
  </div>
  <div class="sh-history-list" data-history></div>
  <div class="tool-actions">
    <button class="button-secondary" type="button" data-clear-history>{{ "Delete history" | t(lang) }}</button>
  </div>
</section>

<script type="application/json" id="shift-handover-data">{{ cfg | scriptJson | safe }}</script>
<script src="{{ '/js/tool-kit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/shift-handover.js' | assetUrl }}" defer></script>

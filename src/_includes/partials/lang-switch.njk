{#- Link to the same page in the other language; pages set `alt` in their front matter. -#}
{%- if alt %}
{%- set other = "en" if lang == "de" else "de" %}
<a class="lang-switch" href="{{ alt }}" hreflang="{{ other }}" lang="{{ other }}" aria-label="{{ 'English' if other == 'en' else 'Deutsch' }}">{{ other | upper }}</a>
{%- endif %}

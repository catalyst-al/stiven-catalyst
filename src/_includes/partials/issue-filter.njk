{#- The controls above a list of issues (the Management Review, From the Floor, the volumes of the treatise): one month at a time, the newest
    first, then a topic, then twelve covers at a time with "show more" (js/weekly.js). Each cover of the list is an
    <li data-block data-month> of .weekly-grid, or what items names (Publications: its sections); an item with no month
    stays in every month. Without the script every issue is listed. F: the words of the controls (the archive labels
    of the list); topics: the name of the group of topics. -#}
{%- macro controls(months, blocks, lang, F, topics, items) %}
    <div class="weekly-controls" data-weekly-filter data-page="12" data-shown="{{ F.shown }}"{% if items %} data-items="{{ items }}"{% endif %} hidden>
      {%- if months | length > 1 %}
      <div class="weekly-months" role="group" aria-label="{{ F.months }}">
        {%- for m in months %}<button type="button" aria-pressed="{{ 'true' if loop.first else 'false' }}" data-month="{{ m.id }}">{{ m[lang] }}<span class="weekly-n">{{ m.count }}</span></button>{% endfor %}
      </div>
      {%- endif %}
      {%- if blocks | length > 1 %}
      <div class="weekly-filter" role="group" aria-label="{{ topics }}">
        <button type="button" aria-pressed="true" data-block="">{{ F.all }}</button>
        {%- for b in blocks %}<button type="button" aria-pressed="false" data-block="{{ b.id }}">{{ b[lang] }}<span class="weekly-n"></span></button>{% endfor %}
      </div>
      {%- endif %}
    </div>
{%- endmacro %}

{%- macro more(F) %}
    <p class="weekly-none" data-weekly-none hidden>{{ F.empty }}</p>
    <div class="weekly-more" data-weekly-more hidden>
      <p class="weekly-shown" aria-live="polite"></p>
      <button type="button" class="button-secondary">{{ F.more }}</button>
    </div>
{%- endmacro %}

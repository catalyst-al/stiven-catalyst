{# Only shown when a tool is opened from a saved coaching project. #}
<section class="shell role-ring coaching" data-coaching-bridge hidden aria-labelledby="coaching-bridge-title">
  <div data-coaching-bridge-app></div>
  <p data-coaching-bridge-status class="form-note" role="status" aria-live="polite"></p>
</section>
<script type="application/json" id="coaching-data">{{ coaching | scriptJson | safe }}</script>
<script src="{{ '/js/coaching-core.js' | assetUrl }}" defer></script>
<script src="{{ '/js/coaching-bridge.js' | assetUrl }}" defer></script>

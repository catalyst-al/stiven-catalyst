{#- The search index of a language (lib/search-index.js), written by search-index.njk in each language. -#}
{%- set toolList = (de if lang == "de" else sq).tools if lang == "de" or lang == "sq" else tools -%}
{%- set pages = [
  { title: "Start here" | t(lang), summary: "Essays, field notes and small tools about leading people and running operations, written from ten years close to the work. If you have ten minutes, begin with these." | t(lang), url: "/start.html" },
  { title: "Challenges" | t(lang), summary: "Twelve situations a shift lead or a manager walks in with. Under each one: the essays, their checklists, the tools and the field notes that go with it." | t(lang), url: "/challenges.html" },
  { title: "About" | t(lang), summary: "Stiven Catalyst is built around one idea: better results begin with clearer thinking, and clearer thinking matters only when it changes what happens next." | t(lang), url: "/about.html" },
  { title: "Publications" | t(lang), summary: "Longer pieces made to be leafed through: a book about where it started, a guide to the tools, every month a review of the best management research in several issues, an operational treatise in volumes that follow one question from the floor to the protocol, and a magazine from the floor." | t(lang), url: "/publications.html" },
  { title: "Tools" | t(lang), summary: "Small tools built from the essays. They run in your browser, and your work stays on your device." | t(lang), url: "/tools.html" },
  { title: "Your challenge" | t(lang), summary: "A situation from your shift, your area or your front desk: a number you cannot explain, a handover that keeps failing, a conversation you are putting off. I read every one, and answer the ones I can in public, anonymised, so the next reader with the same problem finds it." | t(lang), url: "/your-challenge.html" },
  { title: "My shelf" | t(lang), summary: "What you saved for later, the cards you started and the essays you read. Kept in this browser only, with no account; “Save all my work” takes it to another device." | t(lang), url: "/shelf.html" },
  { title: downloads[lang or "en"].heading, summary: downloads[lang or "en"].lede, url: "/downloads.html" },
  { title: "Contact" | t(lang), summary: "Questions, ideas or a conversation about leadership, operations and systems. Messages are read personally." | t(lang), url: "/contact.html" }
] -%}
{{ lang | searchIndex(collections, toolList, pages, { weekly: weekly, treatise: treatise, magazine: magazine, review: review, toolsGuide: toolsGuide, podcast: podcast }) | safe }}

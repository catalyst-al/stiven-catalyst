{#- The Tools page: the roles (families.json) as cards, then each role with its tools and training modules. Needs toolList. -#}
<nav class="shell family-index" aria-label="{{ 'Roles' | t(lang) }}">
  {%- set familyLink = "" %}
  {%- include "partials/family-cards.njk" %}
</nav>

{%- for family in families %}
<section class="shell family-section family-{{ family.id }}" id="{{ family.id }}" style="--family: {{ family.color }}" aria-labelledby="{{ family.id }}-title">
  <header class="family-head">
    <span class="family-visual" aria-hidden="true"><span class="family-orbit"><i></i></span><span class="family-planet"></span></span>
    <div>
      <p class="kicker">{{ family.name }} · {{ family.scope | t(lang) }}</p>
      <h2 id="{{ family.id }}-title">{{ family.role | t(lang) }}</h2>
      <p>{{ family.line | t(lang) }}</p>
      <a class="text-link" href="{{ family | roleUrl(lang) }}">{{ "Open the planet: routine, learning, next orbit" | t(lang) }} <span aria-hidden="true">→</span></a>
    </div>
  </header>
  <div class="tool-grid family-tools">
    {%- set accent = family.color %}
    {%- set level = 3 %}
    {%- for tool in (family | familyTools(toolList, lang)).concat(family | familyTools(toolList, lang, "learn")) %}
    {% include "partials/tool-card.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endfor %}

{%- set rest = toolList | unassigned(families, lang) %}
{%- if rest.length %}
<section class="shell family-section" aria-labelledby="more-tools-title">
  <header class="family-head is-plain">
    <div><h2 id="more-tools-title">{{ "More tools" | t(lang) }}</h2></div>
  </header>
  <div class="tool-grid family-tools">
    {%- set accent = false %}
    {%- set level = 3 %}
    {%- for tool in rest %}
    {% include "partials/tool-card.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endif %}

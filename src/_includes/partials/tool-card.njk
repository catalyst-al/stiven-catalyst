{#- A tool's card: what it is, what it shows (a picture of its result, when scripts/tool-previews.mjs has made one), and the way in. -#}
{%- set preview = tool.url | toolPreview(lang) %}
<article class="tool-card{% if not tool.url %} is-soon{% endif %}{% if preview %} has-preview{% endif %}{% if accent %} has-family" style="--family: {{ accent }}{% endif %}">
  {%- if preview %}{% set previewSize = preview | imageSize %}
  <a class="tool-card-preview" href="{{ tool.url }}" tabindex="-1" aria-hidden="true"><img src="{{ preview | assetUrl }}" srcset="{{ preview | assetUrl | srcsetFor }}" sizes="(max-width: 700px) calc(100vw - 64px), 360px" alt=""{% if previewSize %} width="{{ previewSize.width }}" height="{{ previewSize.height }}"{% endif %} loading="lazy" decoding="async"></a>
  {%- endif %}
  <div class="card-meta"><span>{{ tool.type }}</span><span>{{ tool.time }}</span></div>
  <div>
    <h{{ level or 2 }}>{{ tool.name }}</h{{ level or 2 }}>
    <p>{{ tool.summary }}</p>
    {%- if tool.url %}
    <a class="text-link" href="{{ tool.url }}"{% if tool.hreflang %} hreflang="{{ tool.hreflang }}"{% endif %}>{{ tool.cta }} <span aria-hidden="true">→</span></a>
    {%- else %}
    <span class="soon">{{ "Coming soon" | t(lang) }}</span>
    {%- endif %}
  </div>
</article>

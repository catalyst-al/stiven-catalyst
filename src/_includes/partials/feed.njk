{#- The Atom feed of one language: its essays and reflections, newest first (feed.njk, de/feed.njk, sq/feed.njk). -#}
{%- set feedLang = feedLang or "en" -%}
{%- set feedPath = "/feed.xml" if feedLang == "en" else "/" + feedLang + "/feed.xml" -%}
{%- set homePath = "/" | local(feedLang) -%}
{%- set posts = collections["feed" + (feedLang | langSuffix)] | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ feedLang }}">
  <title>{{ site.title }}{% if feedLang == "de" %} (Deutsch){% elif feedLang == "sq" %} (Shqip){% endif %}</title>
  <subtitle>{{ site.description if feedLang == "en" else ("Leadership, Operations & Ideas" | t(feedLang)) }}</subtitle>
  <link href="{{ feedPath | absoluteUrl }}" rel="self"/>
  <link href="{{ homePath | absoluteUrl }}"/>
  <id>{{ homePath | absoluteUrl }}</id>
  <author><name>{{ site.author }}</name></author>
  <updated>{{ (posts[0].date if posts.length else "2026-01-01") | isoDate }}T00:00:00Z</updated>
  {%- for post in posts | first(20) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl }}"/>
    <id>{{ post.url | absoluteUrl }}</id>
    <updated>{{ post.date | isoDate }}T00:00:00Z</updated>
    <summary>{{ post.data.deck or post.data.summary }}</summary>
    <content type="html">{{ post.content | transformWithHtmlBase(site.url, post.url) }}</content>
  </entry>
  {%- endfor %}
</feed>

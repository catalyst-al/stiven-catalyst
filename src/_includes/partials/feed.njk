{#- The Atom feed of one language (feed.njk, de/feed.njk, sq/feed.njk): its essays and reflections, the issues of the
    magazines and the volumes of the treatise, and each edition of the Tools Guide, newest first, the publications by
    the day they went online (lib/feed-entries.js). An essay comes with its whole text; a publication with its summary
    and its address, where it is read. -#}
{%- set feedLang = feedLang or "en" -%}
{%- set feedPath = "/feed.xml" if feedLang == "en" else "/" + feedLang + "/feed.xml" -%}
{%- set homePath = "/" | local(feedLang) -%}
{%- set feed = collections["feed" + (feedLang | langSuffix)] | reverse | feedEntries(feedLang, { weekly: weekly, review: review, treatise: treatise, magazine: magazine, toolsGuide: toolsGuide, online: online, edited: edited }) -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ feedLang }}">
  <title>{{ site.title }}{% if feedLang == "de" %} (Deutsch){% elif feedLang == "sq" %} (Shqip){% endif %}</title>
  <subtitle>{{ site.description if feedLang == "en" else ("Leadership, Operations & Ideas" | t(feedLang)) }}</subtitle>
  <link href="{{ feedPath | absoluteUrl }}" rel="self"/>
  <link href="{{ homePath | absoluteUrl }}"/>
  <id>{{ homePath | absoluteUrl }}</id>
  <author><name>{{ site.author }}</name></author>
  <updated>{{ feed.updated }}T00:00:00Z</updated>
  {%- for entry in feed.entries %}
  <entry>
    <title>{{ entry.title }}</title>
    <link href="{{ entry.url | absoluteUrl }}"/>
    <id>{{ entry.id | absoluteUrl }}</id>
    <published>{{ entry.published }}T00:00:00Z</published>
    <updated>{{ entry.updated }}T00:00:00Z</updated>
    <summary>{{ entry.summary }}</summary>
    {%- if entry.post %}
    <content type="html">{{ entry.post.content | withDiagram(entry.post.data.diagram, entry.post.data.lang or "en") | transformWithHtmlBase(site.url, entry.post.url) }}</content>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>

{#- On every page: a small planet at the bottom right; tapping it sends out the ways to share this page (js/share-orbit.js). No third-party scripts: plain links. -#}
{%- set shareLink = page.url | absoluteUrl %}
{%- set shareTitle = shortTitle or site.title %}
<div class="share-orbit" data-share-orbit data-url="{{ shareLink }}" data-title="{{ shareTitle }}">
  <div class="share-orbit-panel" id="share-orbit-panel" role="dialog" aria-label="{{ 'Share this page' | t(lang) }}" hidden>
    <p class="share-orbit-head"><span class="share-orbit-mini" aria-hidden="true"><i></i></span>{{ "Share this page" | t(lang) }}</p>
    <ul class="share-orbit-planets">
      <li style="--i: 0; --c: #f5c86a"><a data-whatsapp="com.whatsapp" href="https://wa.me/?text={{ (shareTitle + ' ' + shareLink) | urlencode }}" target="_blank" rel="noopener"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z"/><path d="M9.2 8.6c.2 2.6 3.4 5.8 6 6l1.1-1.4-1.9-1-1 .9c-1.1-.4-2.2-1.5-2.6-2.6l.9-1-1-1.9z" class="fill"/></svg></span><small>WhatsApp</small></a></li>
      <li style="--i: 1; --c: #d1a553" data-whatsapp-business hidden><a data-whatsapp="com.whatsapp.w4b" href="https://wa.me/?text={{ (shareTitle + ' ' + shareLink) | urlencode }}" target="_blank" rel="noopener"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.4 18.6z"/><path d="M9.2 8.6c.2 2.6 3.4 5.8 6 6l1.1-1.4-1.9-1-1 .9c-1.1-.4-2.2-1.5-2.6-2.6l.9-1-1-1.9z" class="fill"/></svg><b>B</b></span><small>Business</small></a></li>
      <li style="--i: 2; --c: #4ab5f7"><a href="https://www.facebook.com/sharer/sharer.php?u={{ shareLink | urlencode }}" target="_blank" rel="noopener"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8.9v3h2.6V21z" class="fill"/></svg></span><small>Facebook</small></a></li>
      <li style="--i: 3; --c: #e9eef3"><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareLink | urlencode }}" target="_blank" rel="noopener"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9.5h3V19H5zM6.5 4.8a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4zM10.2 9.5h2.9v1.3c.4-.8 1.4-1.6 2.9-1.6 3 0 3.6 2 3.6 4.6V19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19h-3.1z" class="fill"/></svg></span><small>LinkedIn</small></a></li>
      <li style="--i: 4; --c: #ff4d55"><a href="https://x.com/intent/post?url={{ shareLink | urlencode }}&amp;text={{ shareTitle | urlencode }}" target="_blank" rel="noopener"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h4.2l3.4 4.7 4-4.7h1.9l-5 5.8 5.8 8.2h-4.2l-3.7-5.2-4.4 5.2H5.1l5.4-6.3z" class="fill"/></svg></span><small>X</small></a></li>
      <li style="--i: 5; --c: #f2884b"><a href="mailto:?subject={{ shareTitle | urlencode }}&amp;body={{ shareLink | urlencode }}"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7l8 6 8-6"/></svg></span><small>Email</small></a></li>
      <li style="--i: 6; --c: #79c9f7"><button type="button" data-share-copy data-done="{{ 'Link copied' | t(lang) }}"><span class="share-planet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2"/></svg></span><small>{{ "Copy link" | t(lang) }}</small></button></li>
    </ul>
    <button class="share-orbit-native" type="button" data-share-native hidden>{{ "More" | t(lang) }} <span aria-hidden="true">↗</span></button>
  </div>
  <button class="share-orbit-button" type="button" aria-expanded="false" aria-controls="share-orbit-panel" aria-label="{{ 'Share this page' | t(lang) }}" data-share-toggle>
    <span class="share-orbit-ring" aria-hidden="true"><i></i></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="17.5" cy="5.5" r="2.5"/><circle cx="6.5" cy="12" r="2.5"/><circle cx="17.5" cy="18.5" r="2.5"/><path d="M8.7 10.8l6.6-4M8.7 13.2l6.6 4"/></svg>
  </button>
</div>

{#- Search and topic chips; shown only when JavaScript runs (the "js" class is set in the head, so nothing moves on load).
    Insights adds the months of its essays (filterMonths, from the "monthsOf" filter, shown when there are two or more),
    the number of items of each chip in the month (filterCounts) and a page size (filterPage) with "show more" below
    the list (js/filter.js). -#}
<div class="filter-bar" data-filter-controls data-count-label="{{ countLabel }}"{% if filterPage %} data-page="{{ filterPage }}"{% endif %}>
  {%- if filterMonths and filterMonths.length > 1 %}
  <div class="weekly-months" role="group" aria-label="{{ 'Month' | t(lang) }}">
    {%- for m in filterMonths %}<button type="button" aria-pressed="{{ 'true' if loop.first else 'false' }}" data-filter-month="{{ m.id }}">{{ m.label }}<span class="weekly-n">{{ m.count }}</span></button>{% endfor %}
  </div>
  {%- endif %}
  <div class="filter-search">
    <label class="visually-hidden" for="filter-search">{{ searchLabel }}</label>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
    <input id="filter-search" type="search" placeholder="{{ searchLabel }}" autocomplete="off" data-filter-search>
  </div>
  {%- if filterTopics and filterTopics.length > 1 %}
  {#- A topic is a text, or { id, label } when the value in the address should not change with the language. -#}
  <div class="filter-chips" role="group" aria-label="{{ filterLabel or ('Filter by topic' | t(lang)) }}">
    <button type="button" class="chip" aria-pressed="true" data-topic="">{{ "All" | t(lang) }}</button>
    {%- for topic in filterTopics %}
    <button type="button" class="chip" aria-pressed="false" data-topic="{{ topic.id if topic.id else topic }}">{{ topic.label if topic.label else topic }}{% if filterCounts %}<span class="weekly-n" data-chip-count></span>{% endif %}</button>
    {%- endfor %}
  </div>
  {%- endif %}
  <p class="filter-count" data-filter-count aria-live="polite"></p>
</div>

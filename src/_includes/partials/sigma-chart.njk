{#- The Sigma & Control Chart tool. The page sets `cfg` to its data file; sigma-chart.js does the rest. -#}
<section class="shell sc-calc" data-sigma-calc>
  <div class="section-heading">
    <div>
      <p class="kicker">1 · {{ "Calculator" | t(lang) }}</p>
      <h2>{{ "How good is the process?" | t(lang) }}</h2>
    </div>
    <p>{{ "Type the numbers from any period. Everything updates as you type, and nothing leaves your browser." | t(lang) }}</p>
  </div>

  <div class="sc-calc-grid">
    <form class="dl-box" data-calc-sigma>
      <p class="kicker">{{ "From defects to sigma" | t(lang) }}</p>
      <div class="dl-grid sc-grid-3">
        <div class="field">
          <label for="sc-units">{{ "Units" | t(lang) }}</label>
          <input id="sc-units" name="units" type="number" min="0" step="1" inputmode="numeric" placeholder="{{ 'e.g. 18400' | t(lang) }}" data-calc>
        </div>
        <div class="field">
          <label for="sc-defects">{{ "Defects" | t(lang) }}</label>
          <input id="sc-defects" name="defects" type="number" min="0" step="1" inputmode="numeric" placeholder="{{ 'e.g. 104' | t(lang) }}" data-calc>
        </div>
        <div class="field">
          <label for="sc-opps">{{ "Chances per unit" | t(lang) }}</label>
          <input id="sc-opps" name="opportunities" type="number" min="1" step="1" inputmode="numeric" value="1" data-calc>
        </div>
      </div>
      <div class="dl-stats sc-stats" data-sigma-out aria-live="polite"></div>
      <p class="form-note sc-note">{{ "Chances per unit: how many ways one unit can fail that you count separately. Keep it at 1 when you count damaged or incomplete units." | t(lang) }}</p>
    </form>

    <form class="dl-box" data-calc-perfect>
      <p class="kicker">{{ "Perfect delivery" | t(lang) }}</p>
      <div class="dl-grid sc-grid-3">
        <div class="field">
          <label for="sc-ontime">{{ "On time %" | t(lang) }}</label>
          <input id="sc-ontime" name="onTime" type="number" min="0" max="100" step="0.01" inputmode="decimal" placeholder="{{ 'e.g. 96.5' | t(lang) }}" data-calc>
        </div>
        <div class="field">
          <label for="sc-undamaged">{{ "Undamaged %" | t(lang) }}</label>
          <input id="sc-undamaged" name="undamaged" type="number" min="0" max="100" step="0.01" inputmode="decimal" placeholder="{{ 'e.g. 99.4' | t(lang) }}" data-calc>
        </div>
        <div class="field">
          <label for="sc-complete">{{ "Complete %" | t(lang) }}</label>
          <input id="sc-complete" name="complete" type="number" min="0" max="100" step="0.01" inputmode="decimal" placeholder="{{ 'e.g. 99.1' | t(lang) }}" data-calc>
        </div>
      </div>
      <div class="dl-stats sc-stats" data-perfect-out aria-live="polite"></div>
      <p class="form-note sc-note">{{ "A delivery is perfect only when it is on time, undamaged and complete. Take the numbers from" | t(lang) }} <a class="inline-link" href="{{ '/tools/delay-analyzer/' | local(lang) }}">{{ "Delay Analyzer" | t(lang) }}</a>, <a class="inline-link" href="{{ '/tools/damage-control/' | local(lang) }}">{{ "Damage Control" | t(lang) }}</a> {{ "and" | t(lang) }} <a class="inline-link" href="{{ '/tools/incomplete-control/' | local(lang) }}">{{ "Incomplete Control" | t(lang) }}</a>{{ ". Multiplying them assumes the three failures are independent, so read the result as a close estimate." | t(lang) }}</p>
    </form>
  </div>

  <div class="dl-box sc-reference">
    <p class="kicker">{{ "What a sigma level means" | t(lang) }}</p>
    <div class="dl-table-wrap">
      <table class="dl-table">
        <thead><tr><th scope="col">{{ "Sigma level" | t(lang) }}</th><th scope="col" class="num">{{ "Defects per million" | t(lang) }}</th><th scope="col" class="num">{{ "Yield" | t(lang) }}</th><th scope="col" class="num">{{ "Failures per 1,000" | t(lang) }}</th></tr></thead>
        <tbody data-sigma-table></tbody>
      </table>
    </div>
    <p class="form-note sc-note">{{ "Short-term sigma with the usual 1.5 shift. Most warehouse and delivery processes run between 3 and 4.5 sigma; every step up means roughly three to ten times fewer failures." | t(lang) }}</p>
  </div>
</section>

<section class="shell tool-layout dl-setup sc-chart-setup">
  <div class="tool-panel" data-control-chart>
    <p class="kicker sc-section-kicker">2 · {{ "Control chart" | t(lang) }}</p>
    <fieldset class="dl-box">
      <legend class="kicker">{{ "What you are counting" | t(lang) }}</legend>
      <div class="dl-grid">
        <div class="field">
          <label for="cc-metric">{{ "Defect" | t(lang) }}</label>
          <input id="cc-metric" name="metric" placeholder="{{ 'e.g. Damaged units' | t(lang) }}" autocomplete="off" data-setting>
        </div>
        <div class="field">
          <label for="cc-unit">{{ "Out of" | t(lang) }}</label>
          <input id="cc-unit" name="unit" placeholder="{{ 'e.g. Units handled' | t(lang) }}" autocomplete="off" data-setting>
        </div>
        <div class="field">
          <label for="cc-baseline">{{ "Limits from the first" | t(lang) }} <span class="optional">{{ "days, optional" | t(lang) }}</span></label>
          <input id="cc-baseline" name="baseline" type="number" min="0" step="1" inputmode="numeric" placeholder="{{ 'All days' | t(lang) }}" data-setting>
        </div>
      </div>
    </fieldset>

    <form class="dl-box" data-entry>
      <fieldset>
        <legend class="kicker">{{ "Add a day" | t(lang) }}</legend>
        <div class="dl-grid">
          <div class="field">
            <label for="cc-date">{{ "Date" | t(lang) }}</label>
            <input id="cc-date" name="date" type="date" required>
          </div>
          <div class="field">
            <label for="cc-n">{{ "Handled" | t(lang) }}</label>
            <input id="cc-n" name="n" type="number" min="1" step="1" inputmode="numeric" required>
          </div>
          <div class="field">
            <label for="cc-d">{{ "Defects" | t(lang) }}</label>
            <input id="cc-d" name="d" type="number" min="0" step="1" inputmode="numeric" required>
          </div>
          <div class="field dl-wide">
            <label for="cc-note">{{ "Note" | t(lang) }} <span class="optional">{{ "optional" | t(lang) }}</span></label>
            <input id="cc-note" name="note" placeholder="{{ 'e.g. New stacking standard starts' | t(lang) }}" autocomplete="off">
          </div>
        </div>
        <div class="tool-actions">
          <button class="button-primary" type="submit">{{ "Add day" | t(lang) }}</button>
          <p class="form-note" data-entry-status aria-live="polite"></p>
        </div>
      </fieldset>
    </form>

    <details class="dl-box dl-paste">
      <summary class="kicker">{{ "Paste from Excel or CSV" | t(lang) }}</summary>
      <p class="form-note">{{ "One row per day, columns in this order:" | t(lang) }} <strong>{{ "date, handled, defects, note" | t(lang) }}</strong>{{ ". Tabs, semicolons or commas all work, and a header row is skipped. A date that is already in the chart is replaced." | t(lang) }}</p>
      <div class="field">
        <label class="visually-hidden" for="cc-paste">{{ "Rows to import" | t(lang) }}</label>
        <textarea id="cc-paste" rows="5" placeholder="{{ '2026-09-14' | t(lang) }}	2600	11"></textarea>
      </div>
      <div class="tool-actions">
        <button class="button-secondary" type="button" data-import>{{ "Import rows" | t(lang) }}</button>
        <p class="form-note" data-import-status aria-live="polite"></p>
      </div>
    </details>

    <div class="dl-box">
      <div class="dl-log-head">
        <p class="kicker">{{ "Days" | t(lang) }}</p>
        <p class="form-note" data-log-count></p>
      </div>
      <div class="dl-table-wrap" data-log-wrap hidden>
        <table class="dl-table">
          <thead><tr><th scope="col">{{ "Date" | t(lang) }}</th><th scope="col" class="num">{{ "Handled" | t(lang) }}</th><th scope="col" class="num">{{ "Defects" | t(lang) }}</th><th scope="col" class="num">{{ "Rate" | t(lang) }}</th><th scope="col">{{ "Note" | t(lang) }}</th><th scope="col"><span class="visually-hidden">{{ "Remove" | t(lang) }}</span></th></tr></thead>
          <tbody data-log></tbody>
        </table>
      </div>
      <p class="dl-empty" data-log-empty>{{ "No days yet. Add them above, paste from Excel, or" | t(lang) }} <button class="button-ghost" type="button" data-example>{{ "load an example month" | t(lang) }}</button>.</p>
      <div class="tool-actions">
        <button class="button-secondary" type="button" data-csv>{{ "Download CSV" | t(lang) }}</button>
        <button class="button-secondary" type="button" data-clear>{{ "Clear days" | t(lang) }}</button>
      </div>
    </div>
  </div>

  <aside class="tool-aside">
    <p class="kicker">{{ "How to read it" | t(lang) }}</p>
    <p>{{ "The centre line is your average defect rate. The limits show how far a day can move by normal noise alone, given how much was handled that day." | t(lang) }}</p>
    <ul class="tips">
      {%- for rule in cfg.rules %}
      <li><strong>{{ rule.name }}.</strong> {{ rule.text }}</li>
      {%- endfor %}
    </ul>
    <p>{{ 'Everything else is noise. Asking "what went wrong yesterday?" about a day inside the limits sends people looking for a cause that is not there.' | t(lang) }}</p>
    <p>{{ "When a signal is worse, take that day through" | t(lang) }} <a class="inline-link" href="{{ '/tools/five-whys/' | local(lang) }}">{{ "5 Whys" | t(lang) }}</a>{{ ". For daily numbers, use the rows from" | t(lang) }} <a class="inline-link" href="{{ '/tools/damage-control/' | local(lang) }}">{{ "Damage Control" | t(lang) }}</a> {{ "or" | t(lang) }} <a class="inline-link" href="{{ '/tools/incomplete-control/' | local(lang) }}">{{ "Incomplete Control" | t(lang) }}</a> {{ "per day." | t(lang) }}</p>
    <p class="privacy-note">{{ "Your numbers stay in this browser. Nothing is sent or uploaded, and you can clear them at any time." | t(lang) }}</p>
  </aside>
</section>

<section class="shell dl-results sc-results" data-results tabindex="-1" hidden></section>

<script type="application/json" id="sigma-chart-data">{{ cfg | dump | safe }}</script>
<script src="{{ '/js/tool-kit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/sigma-chart.js' | assetUrl }}" defer></script>

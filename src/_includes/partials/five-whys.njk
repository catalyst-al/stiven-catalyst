{#- The 5 Whys worksheet; five-whys.js does the rest. -#}
<section class="shell tool-layout">
  <form class="tool-panel worksheet" data-worksheet data-key="sc-five-whys{{ '-' + lang if lang and lang != 'en' }}">
    <div class="field">
      <label for="ws-problem">{{ "Problem" | t(lang) }}</label>
      <textarea id="ws-problem" name="problem" rows="3" placeholder="{{ 'What happened, where, when and how often? e.g. 14 late check-outs last week on the evening shift' | t(lang) }}" data-store></textarea>
    </div>

    <ol class="why-list" data-whys>
      {%- for i in range(1, 6) %}
      <li class="field why">
        <label for="ws-why-{{ i }}">{{ "Why {n}?" | t(lang) | replace("{n}", i) }}</label>
        <input id="ws-why-{{ i }}" name="why{{ i }}" autocomplete="off" data-store>
      </li>
      {%- endfor %}
    </ol>
    <button class="button-ghost" type="button" data-add-why>{{ "+ Add another why" | t(lang) }}</button>

    <div class="worksheet-grid">
      <div class="field wide">
        <label for="ws-cause">{{ "Root cause" | t(lang) }}</label>
        <textarea id="ws-cause" name="cause" rows="2" placeholder="{{ 'The last answer that you can act on' | t(lang) }}" data-store></textarea>
      </div>
      <div class="field wide">
        <label for="ws-action">{{ "Countermeasure" | t(lang) }}</label>
        <textarea id="ws-action" name="action" rows="2" placeholder="{{ 'One change to the process, not a reminder' | t(lang) }}" data-store></textarea>
      </div>
      <div class="field">
        <label for="ws-owner">{{ "Owner" | t(lang) }}</label>
        <input id="ws-owner" name="owner" autocomplete="off" data-store>
      </div>
      <div class="field">
        <label for="ws-due">{{ "Due date" | t(lang) }}</label>
        <input id="ws-due" name="due" type="date" data-store>
      </div>
      <div class="field wide">
        <label for="ws-check">{{ "How will you know it worked?" | t(lang) }}</label>
        <input id="ws-check" name="check" placeholder="{{ 'e.g. Late check-outs below 3 per week for four weeks' | t(lang) }}" autocomplete="off" data-store>
      </div>
    </div>

    <div class="tool-actions">
      <button class="button-primary" type="button" data-print>{{ "Print or save as PDF" | t(lang) }}</button>
      <button class="button-secondary" type="button" data-copy>{{ "Copy as text" | t(lang) }}</button>
      <button class="button-secondary" type="button" data-clear>{{ "Clear" | t(lang) }}</button>
    </div>
    <p class="form-note" data-status aria-live="polite">{{ "Your draft is kept only in this browser." | t(lang) }}</p>
  </form>

  <aside class="tool-aside">
    <p class="kicker">{{ "Good whys" | t(lang) }}</p>
    <ul class="tips">
      <li><strong>{{ "Facts, not guesses." | t(lang) }}</strong> {{ "Go and look before you answer." | t(lang) }}</li>
      <li><strong>{{ "Process, not people." | t(lang) }}</strong> {{ '“Anna forgot” is not a root cause. Why was it possible to forget?' | t(lang) }}</li>
      <li><strong>{{ "Stop at something you can change." | t(lang) }}</strong> {{ "Sometimes that is at why 3, sometimes at why 7." | t(lang) }}</li>
      <li><strong>{{ "Test it backwards." | t(lang) }}</strong> {{ 'Read from the root cause up with “therefore”. If the chain holds, you are close.' | t(lang) }}</li>
      <li><strong>{{ "A reminder is not a fix." | t(lang) }}</strong> {{ 'If the countermeasure is “tell people again”, ask one more why.' | t(lang) }}</li>
    </ul>
    <p class="privacy-note">{{ "Nothing you write is sent anywhere. It stays on this device until you clear it." | t(lang) }}</p>
  </aside>
</section>

<script src="{{ '/js/tool-kit.js' | assetUrl }}" defer></script>
<script src="{{ '/js/five-whys.js' | assetUrl }}" defer></script>

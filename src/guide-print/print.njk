{%- set lang = glang -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ toolsGuide[lang].title }}</title>
<style>
{% include "print/print-head.css" %}
{% include "print/guide.css" %}
</style>
</head>
<body class="tg">
{% include "print/guide-pages.njk" %}
</body>
</html>

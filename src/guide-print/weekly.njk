---
pagination:
  data: weekly.prints
  size: 1
  alias: weeklyPrint
---
{#- One issue of the monthly Management Review in one language, as A5 pages. scripts/weekly.mjs prints it to PDF;
    the published site never carries this page (guide-print.11tydata.js). The text is in lib/weekly/issues, the
    charts come ready from weekly.js (b.svg), and each page is drawn by print/weekly-page.njk, which the reader of
    the issue (pages/weekly-issue.njk) shares. -#}
{%- set lang = weeklyPrint.lang -%}
{%- set issue = weekly.issues | where("slug", weeklyPrint.slug) -%}
{%- set I = issue[lang] -%}
{%- set W = weekly[lang] -%}
{%- set L = W.labels -%}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ W.name }} · {{ L.no }} {{ issue.no }} · {{ I.heading }}</title>
<style>
{% include "print/print-head.css" %}
{% include "print/review-base.css" %}
{% include "print/weekly.css" %}
</style>
</head>
<body class="mr">
{%- for page in I.pages %}
{%- set n = loop.index %}
{% include "print/weekly-page.njk" %}
{%- endfor %}
</body>
</html>

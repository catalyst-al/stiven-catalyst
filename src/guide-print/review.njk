---
pagination:
  data: review.prints
  size: 1
  alias: print
---
{#- The Management Review in one language, as A5 pages. scripts/review.mjs prints it to PDF; the published site
    never carries this page (guide-print.11tydata.js). The text is in review.js. -#}
{%- set lang = print.lang -%}
{%- set R = review[lang] -%}
{%- set L = R.labels -%}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
{%- set roman = ["", "I", "II", "III"] -%}

{%- macro chrome(number, section) -%}
<header class="run"><span>{{ R.name }} · {{ R.date }}</span>{% if section %}<span class="run-section">{{ section }}</span>{% endif %}</header>
<footer class="foot"><span>stivencatalyst.com</span><span>Stiven Catalyst</span><span class="num">{{ number }}</span></footer>
{%- endmacro -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ R.name }} · {{ R.date }}</title>
<style>
@font-face { font-family: "Inter"; src: url("/guide-fonts/inter-latin-400-normal.woff2") format("woff2"); font-weight: 400; }
@font-face { font-family: "Inter"; src: url("/guide-fonts/inter-latin-500-normal.woff2") format("woff2"); font-weight: 500; }
@font-face { font-family: "Inter"; src: url("/guide-fonts/inter-latin-600-normal.woff2") format("woff2"); font-weight: 600; }
@font-face { font-family: "Inter"; src: url("/guide-fonts/inter-latin-700-normal.woff2") format("woff2"); font-weight: 700; }
@font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black-latin-400-normal.woff2") format("woff2"); }
@page { size: 148mm 210mm; margin: 0; }
:root { --paper: #060a10; --ink: #f6f7f4; --body: #d5dbe0; --muted: #a5b0b8; --line: rgba(255,255,255,.12); --blue: #4ab5f7; --red: #ff4b5c; --card: rgba(255,255,255,.035); }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: var(--paper); }
body { font-family: "Inter", sans-serif; color: var(--body); font-size: 8.6pt; line-height: 1.48; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.pg { width: 148mm; height: 210mm; position: relative; overflow: hidden; break-after: page; padding: 17mm 13mm 17mm; background: radial-gradient(110mm 70mm at 100% -10mm, rgba(255,75,92,.10), transparent 70%), radial-gradient(120mm 70mm at 0% -18mm, rgba(74,181,247,.12), transparent 70%), var(--paper); }
.run { position: absolute; top: 8.5mm; left: 13mm; right: 13mm; display: flex; justify-content: space-between; font-size: 6.2pt; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.run-section { color: var(--blue); }
.foot { position: absolute; bottom: 8mm; left: 13mm; right: 13mm; display: flex; justify-content: space-between; font-size: 6.5pt; color: var(--muted); border-top: .25mm solid var(--line); padding-top: 2.2mm; }
.foot .num { color: var(--ink); font-weight: 600; }
.kicker { font-size: 6.6pt; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; color: var(--red); margin-bottom: 2.2mm; }
h2 { font-family: "Archivo Black", sans-serif; font-weight: 400; color: var(--ink); font-size: 19pt; line-height: 1.04; letter-spacing: -.01em; margin-bottom: 3mm; }
h2 .accent { display: block; color: var(--red); }
h4 { color: var(--ink); font-weight: 700; font-size: 8.6pt; line-height: 1.3; margin-bottom: 1mm; }
p { margin-bottom: 2.2mm; }
.lead { font-family: Georgia, serif; font-size: 10.6pt; line-height: 1.42; color: var(--ink); margin-bottom: 4mm; }

/* Blocks */
.cards { display: grid; gap: 2.4mm; margin: 0 0 3.6mm; }
.cards.c1 { grid-template-columns: 1fr; } .cards.c2 { grid-template-columns: 1fr 1fr; } .cards.c3 { grid-template-columns: 1fr 1fr 1fr; }
.card { border: .25mm solid var(--line); border-radius: 2.4mm; padding: 3mm; background: var(--card); }
.card:nth-child(odd) { border-color: rgba(255,75,92,.38); } .card:nth-child(even) { border-color: rgba(74,181,247,.38); }
.card .cn { display: block; font-family: "Archivo Black"; font-size: 12pt; line-height: 1; color: var(--red); margin-bottom: 1.8mm; }
.card:nth-child(even) .cn { color: var(--blue); }
.card p { margin: 0; font-size: 7.8pt; line-height: 1.42; }
.cards.plain .card { text-align: center; padding: 3.4mm 2.4mm; }
.cards.plain h4 { font-size: 9pt; }
.cards.c1 .card { display: grid; grid-template-columns: 24mm 1fr; column-gap: 3mm; align-items: baseline; }
.cards.c1 .card .cn { font-size: 10pt; grid-row: span 2; }
.rows { list-style: none; margin: 0 0 4mm; counter-reset: r; }
.rows li { counter-increment: r; display: grid; grid-template-columns: 10mm 1fr; gap: 2mm; padding: 2.6mm 0; border-bottom: .25mm solid var(--line); }
.rows li::before { content: counter(r, decimal-leading-zero); font-family: "Archivo Black"; font-size: 12pt; color: var(--red); line-height: 1.1; }
.rows li:nth-child(even)::before { color: var(--blue); }
.rows p { margin: 0; font-size: 8pt; }
.box { border: .3mm solid rgba(74,181,247,.45); border-radius: 2.6mm; padding: 3.4mm 4mm; background: var(--card); }
.box h4 { font-family: "Archivo Black"; font-weight: 400; font-size: 11pt; margin-bottom: 2mm; }
.box ol { padding-left: 4.5mm; } .box li { margin-bottom: 1.2mm; font-family: Georgia, serif; font-size: 9.2pt; color: var(--ink); }
.stats { display: grid; gap: 2.4mm; margin: 0 0 3.6mm; }
.stats.c2 { grid-template-columns: 1fr 1fr; } .stats.c3 { grid-template-columns: 1fr 1fr 1fr; }
.stat { border: .25mm solid var(--line); border-radius: 2.4mm; padding: 3mm; background: var(--card); }
.stat b { display: block; font-family: "Archivo Black"; font-weight: 400; font-size: 18pt; line-height: 1; color: var(--red); }
.stat:nth-child(even) b { color: var(--blue); }
.stat span { display: block; font-size: 7.4pt; line-height: 1.38; margin-top: 1.6mm; color: var(--body); }
.stat i { display: block; font-style: normal; font-size: 6pt; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 1.4mm; }
.stats-label, .block-label { font-size: 6.6pt; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--muted); margin: 0 0 2mm; }
.wide-stat { display: grid; grid-template-columns: 22mm 1fr; gap: 3mm; align-items: center; border-top: .25mm solid var(--line); border-bottom: .25mm solid var(--line); padding: 3mm 0; margin-bottom: 3.6mm; }
.wide-stat b { font-family: "Archivo Black"; font-weight: 400; font-size: 22pt; color: var(--blue); line-height: 1; }
.wide-stat span { font-size: 7.8pt; }
.callout { border: .25mm solid rgba(74,181,247,.4); border-radius: 2.6mm; padding: 3.2mm 4mm; margin: 0 0 3.6mm; background: linear-gradient(100deg, rgba(74,181,247,.08), rgba(255,75,92,.12)); }
.callout .label { display: block; font-size: 6.4pt; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; color: var(--blue); margin-bottom: 1.2mm; }
.callout p { margin: 0; font-family: Georgia, serif; font-size: 9.6pt; line-height: 1.42; color: var(--ink); }
.quote { font-family: Georgia, serif; font-size: 12pt; line-height: 1.38; color: var(--ink); border-top: .3mm solid var(--line); padding-top: 3.6mm; margin: 1mm 0 3mm; }
.pull { font-family: Georgia, serif; font-size: 14pt; line-height: 1.3; color: var(--blue); font-weight: 700; }
.lists { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; margin-bottom: 3.6mm; }
.lists h4 { font-family: "Archivo Black"; font-weight: 400; font-size: 10pt; margin-bottom: 1mm; }
.lists h4 .hl { color: var(--red); } .lists .accent h4 .hl { color: var(--blue); }
.lists ul { list-style: none; } .lists li { padding: 1.7mm 0; border-bottom: .25mm solid var(--line); font-size: 8pt; color: var(--ink); }
.steps { list-style: none; counter-reset: s; margin: 0 0 3.6mm; }
.steps li { counter-increment: s; display: grid; grid-template-columns: 8mm 1fr; gap: 2.6mm; padding: 2.2mm 0; border-bottom: .25mm solid var(--line); align-items: start; }
.steps li::before { content: counter(s); width: 6.4mm; height: 6.4mm; border-radius: 50%; border: .3mm solid var(--blue); color: var(--blue); display: grid; place-items: center; font-weight: 700; font-size: 7.4pt; }
.steps li:nth-child(odd)::before { border-color: var(--red); color: var(--red); }
.steps h4 { margin: .4mm 0 .6mm; } .steps p { margin: 0; font-size: 7.9pt; }
.bars { margin: 0 0 3.6mm; }
.bar { display: grid; grid-template-columns: 11mm 1fr 11mm; gap: 2mm; align-items: center; margin-bottom: 1.8mm; font-size: 8pt; }
.bar .track { height: 4.6mm; border-radius: 2.3mm; background: rgba(255,255,255,.05); overflow: hidden; }
.bar .fill { height: 100%; border-radius: 2.3mm; background: var(--blue); }
.bar.alert .fill { background: var(--red); }
.bar b { color: var(--ink); text-align: right; }
.split { margin: 0 0 3.6mm; }
.split-bar { display: flex; height: 6mm; border-radius: 3mm; overflow: hidden; margin-bottom: 2.4mm; }
.split-bar span { display: block; background: var(--blue); } .split-bar span:nth-child(2) { background: rgba(74,181,247,.45); } .split-bar span.alert { background: var(--red); }
.split-legend { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2mm; }
.split-legend b { display: block; font-family: "Archivo Black"; font-weight: 400; font-size: 16pt; line-height: 1; color: var(--blue); }
.split-legend .alert b { color: var(--red); }
.split-legend span { font-size: 7.4pt; }
.table { display: grid; grid-template-columns: 30mm 1fr; gap: 4mm; margin: 0 0 3mm; align-items: start; }
.big { border: .25mm solid rgba(74,181,247,.4); border-radius: 2.6mm; padding: 5mm 2mm; text-align: center; background: var(--card); }
.big b { display: block; font-family: "Archivo Black"; font-weight: 400; font-size: 24pt; color: var(--blue); line-height: 1; }
.big span { display: block; font-size: 7.2pt; margin-top: 2mm; }
.table table { width: 100%; border-collapse: collapse; font-size: 8pt; }
.table th { text-align: left; font-size: 6.4pt; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 700; padding: 0 0 1.6mm; border-bottom: .25mm solid var(--line); }
.table td { padding: 1.9mm 0; border-bottom: .25mm solid var(--line); color: var(--ink); }
.table td:nth-child(2) { color: var(--blue); font-weight: 700; } .table td:nth-child(3) { color: var(--red); font-weight: 700; }
.table .note { font-size: 6.8pt; color: var(--muted); margin-top: 1.6mm; }
.figures { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2.4mm; margin: 0 0 4mm; }
.figures div { border: .25mm solid rgba(74,181,247,.4); border-radius: 2.4mm; padding: 2.6mm 3mm; background: var(--card); }
.figures b { display: block; font-family: "Archivo Black"; font-weight: 400; font-size: 18pt; color: var(--blue); line-height: 1; }
.figures span { display: block; font-size: 7.2pt; margin-top: 1.2mm; }
.body-text p { font-family: Georgia, serif; font-size: 9.2pt; line-height: 1.5; color: var(--body); }
.sign { font-size: 7pt; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
.pareto { display: flex; align-items: flex-end; gap: 2.4mm; height: 30mm; padding: 0 1mm; border-bottom: .3mm solid var(--line); margin-bottom: 1.4mm; }
.pareto span { flex: 1; border-radius: 1.2mm 1.2mm 0 0; background: linear-gradient(180deg, var(--blue), rgba(74,181,247,.35)); }
.pareto span.top { background: linear-gradient(180deg, var(--red), rgba(255,75,92,.35)); }
.pareto-keys { display: flex; gap: 2.4mm; padding: 0 1mm; margin-bottom: 1mm; }
.pareto-keys span { flex: 1; text-align: center; font-size: 7pt; color: var(--muted); }
.pareto-label { font-size: 6.4pt; color: var(--muted); margin-bottom: 3mm; font-style: italic; }
.bottom { position: absolute; left: 13mm; right: 13mm; bottom: 18.5mm; }
.source { font-size: 6.4pt; color: var(--muted); line-height: 1.4; }
.link { display: flex; justify-content: space-between; align-items: center; gap: 3mm; background: rgba(74,181,247,.08); border: .25mm solid rgba(74,181,247,.35); border-radius: 2.4mm; padding: 2.2mm 3.2mm; font-size: 7.4pt; margin-top: 1.8mm; }
.link b { color: var(--blue); font-weight: 600; white-space: nowrap; } .link span { color: var(--ink); text-align: right; }
.head-split { display: grid; grid-template-columns: 1fr 44mm; gap: 5mm; align-items: start; }
.head-split img { width: 44mm; height: 49mm; object-fit: cover; border-radius: 2.6mm; display: block; }

/* Cover */
.cover { padding: 13mm 13mm 12mm; display: flex; flex-direction: column; }
.mast { display: flex; justify-content: space-between; align-items: baseline; font-size: 6.6pt; letter-spacing: .2em; text-transform: uppercase; color: var(--ink); font-weight: 700; }
.mast span:last-child { color: var(--muted); font-weight: 600; }
.mast-rule { width: 12mm; height: .9mm; background: var(--red); margin-top: 1.6mm; }
.cover-main { display: grid; grid-template-columns: 1fr 46mm; gap: 5mm; margin-top: 16mm; align-items: start; }
.cover-main img { width: 46mm; height: 92mm; object-fit: cover; display: block; }
.masthead { font-family: "Archivo Black"; font-size: 27pt; line-height: .95; color: var(--ink); letter-spacing: -.01em; text-transform: uppercase; }
.masthead .accent { display: block; color: var(--red); }
.cover-tag { font-family: Georgia, serif; font-size: 11pt; color: var(--ink); margin-top: 2.6mm; }
.cover-rule { width: 12mm; height: .9mm; background: var(--red); margin: 6mm 0 5mm; }
.cover-theme { font-family: "Archivo Black"; font-size: 15pt; line-height: 1.05; color: var(--ink); text-transform: uppercase; }
.cover-theme .accent { display: block; color: var(--blue); }
.cover-sub { font-family: Georgia, serif; font-size: 9.6pt; line-height: 1.4; color: var(--body); margin-top: 2.6mm; }
.inside { margin-top: auto; }
.inside .k { font-size: 6.4pt; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding-bottom: 1.8mm; border-bottom: .25mm solid var(--line); }
.inside ol { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); }
.inside li { padding: 2.4mm 2mm 0 0; border-right: .25mm solid var(--line); margin-right: 2mm; font-size: 7pt; font-weight: 600; color: var(--ink); line-height: 1.3; }
.inside li:last-child { border-right: 0; margin-right: 0; }
.inside li b { display: block; font-family: "Archivo Black"; font-weight: 400; color: var(--red); font-size: 9pt; margin-bottom: 1mm; }
.cover-foot { margin-top: 7mm; font-size: 6.6pt; letter-spacing: .2em; text-transform: uppercase; color: var(--ink); font-weight: 700; }

/* Editor and contents */
.letter p { font-family: Georgia, serif; font-size: 10.4pt; line-height: 1.5; color: var(--body); margin-bottom: 3.4mm; }
.signature { font-family: Georgia, serif; font-style: italic; font-size: 15pt; color: var(--ink); margin-top: 6mm; }
.signature-role { font-size: 6.6pt; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-top: 1mm; }
.motto { position: absolute; left: 13mm; right: 13mm; bottom: 21mm; }
.motto i { display: block; width: 12mm; height: .9mm; background: var(--red); margin-bottom: 4mm; }
.motto p { font-family: Georgia, serif; font-size: 17pt; line-height: 1.2; color: var(--ink); margin: 0; }
.toc-part { font-size: 6.2pt; letter-spacing: .18em; text-transform: uppercase; color: var(--red); font-weight: 700; margin: 2.8mm 0 .4mm; }
.toc { list-style: none; }
.toc li { display: grid; grid-template-columns: 8mm 1fr; gap: 2mm; padding: .7mm 0; border-bottom: .25mm solid var(--line); align-items: baseline; font-size: 7.5pt; line-height: 1.3; color: var(--ink); }
.toc li b { font-family: "Archivo Black"; font-weight: 400; color: var(--blue); font-size: 9pt; }

/* Sources */
.src { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 2mm; margin-bottom: 3.6mm; }
.src li { border: .25mm solid var(--line); border-radius: 2mm; padding: 2.2mm 2.6mm; background: var(--card); font-size: 7pt; color: var(--ink); font-weight: 600; line-height: 1.32; }
.src li em { display: block; font-style: normal; color: var(--muted); font-weight: 400; margin-top: .6mm; }
.src li i { display: block; font-style: normal; color: var(--blue); font-weight: 400; font-size: 5.6pt; word-break: break-all; margin-top: .8mm; }

/* Back */
.back { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.back img { width: 34mm; height: 68mm; object-fit: cover; margin-bottom: 8mm; }
.back .masthead { font-size: 22pt; }
.back .cover-tag { margin-bottom: 8mm; }
.back p { color: var(--body); margin-bottom: 1mm; }
.back .monthly { font-family: "Archivo Black"; color: var(--ink); font-size: 13pt; text-transform: uppercase; margin: 1mm 0; }
.back .url { color: var(--blue); font-weight: 600; font-size: 9.6pt; margin-top: 5mm; }
.back .edition { position: absolute; left: 0; right: 0; bottom: 11mm; font-size: 6.8pt; color: var(--muted); }
</style>
</head>
<body>
{%- for page in R.pages %}
{%- set n = loop.index %}
{%- if page.type == "cover" %}
<section class="pg cover">
  <div class="mast"><span>Stiven Catalyst</span><span>{{ R.date }}</span></div>
  <div class="mast-rule"></div>
  <div class="cover-main">
    <div>
      <div class="masthead">Management<span class="accent">Review</span></div>
      <p class="cover-tag">{{ R.tagline }}</p>
      <div class="cover-rule"></div>
      <div class="cover-theme">{{ R.theme }}</div>
      <p class="cover-sub">{{ R.sub }}</p>
    </div>
    <img src="{{ R.cover.src }}" alt="">
  </div>
  <div class="inside">
    <p class="k">{{ L.inside }}</p>
    <ol>{% for id in R.inside %}{% set target = R.pages[review.pageOf[id] - 1] %}<li><b>{{ review.pageOf[id] | pad }}</b>{{ target.heading }}</li>{% endfor %}</ol>
  </div>
  <p class="cover-foot">stivencatalyst.com</p>
</section>
{%- elif page.type == "editor" %}
<section class="pg">
  {{ chrome(n) }}
  <p class="kicker">{{ R.editor.kicker }}</p>
  <h2>{{ R.editor.title }}</h2>
  <div class="letter">{% for para in R.editor.body %}<p>{{ para }}</p>{% endfor %}</div>
  <p class="signature">Stiven Janaqi</p>
  <p class="signature-role">{{ R.editor.role }} · Stiven Catalyst</p>
  <div class="motto"><i></i><p>{{ R.tagline }}</p></div>
</section>
{%- elif page.type == "contents" %}
<section class="pg">
  {{ chrome(n) }}
  <p class="kicker">{{ R.date }}</p>
  <h2>{{ L.contents }}</h2>
  {%- for part in R.parts %}{% if part %}
  {%- set partIndex = loop.index0 %}
  <p class="toc-part">{{ roman[partIndex] }} · {{ part }}</p>
  <ol class="toc">{% for item in R.pages %}{% if item.part == partIndex %}<li><b>{{ loop.index | pad }}</b>{{ item.heading }}</li>{% endif %}{% endfor %}</ol>
  {%- endif %}{% endfor %}
  <p class="toc-part">{{ L.sources }}</p>
  <ol class="toc"><li><b>{{ review.pageOf.sources | pad }}</b>{{ R.sourcesPage.kicker }}</li></ol>
</section>
{%- elif page.type == "sources" %}
<section class="pg">
  {{ chrome(n, L.sources) }}
  <p class="kicker">{{ R.sourcesPage.kicker }}</p>
  <h2>{{ R.sourcesPage.title[0] }}<span class="accent">{{ R.sourcesPage.title[1] }}</span></h2>
  <p class="lead">{{ R.sourcesPage.lead }}</p>
  <ol class="src">{% for s in review.sources %}<li>{{ s.title }}<em>{{ s.by }}</em><i>{{ s.url }}</i></li>{% endfor %}</ol>
  <div class="callout"><span class="label">{{ R.sourcesPage.method }}</span><p>{{ R.sourcesPage.methodText }}</p></div>
</section>
{%- elif page.type == "back" %}
<section class="pg back">
  <img src="{{ R.cover.src }}" alt="">
  <div class="masthead">Management<span class="accent">Review</span></div>
  <p class="cover-tag">{{ R.tagline }}</p>
  <p>{{ R.back.line }}</p>
  <p class="monthly">{{ magazine.names[lang].name }}</p>
  <p>{{ R.back.more }}</p>
  <p class="url">stivencatalyst.com{{ "/publications.html" | local(lang) }}</p>
  <p class="edition">{{ R.name }} · {{ R.date }} · Stiven Catalyst</p>
</section>
{%- else %}
<section class="pg">
  {{ chrome(n, R.parts[page.part]) }}
  {%- if page.image %}<div class="head-split"><div>{% endif %}
  <p class="kicker">{{ page.kicker }}</p>
  <h2>{{ page.title[0] }}<span class="accent">{{ page.title[1] }}</span></h2>
  {%- if page.lead %}<p class="lead">{{ page.lead }}</p>{% endif %}
  {%- if page.image %}</div><img src="{{ page.image.src }}" alt=""></div>{% endif %}
  {%- for b in page.blocks %}
  {%- if b.type == "p" %}<div class="body-text"><p>{{ b.text }}</p></div>
  {%- elif b.type == "cards" %}<div class="cards c{{ b.cols }}{{ ' plain' if b.plain }}">{% for c in b.items %}<div class="card">{% if not b.plain %}<span class="cn">{{ c.n or (loop.index | pad) }}</span>{% endif %}<h4>{{ c.h }}</h4><p>{{ c.p }}</p></div>{% endfor %}</div>
  {%- elif b.type == "rows" %}<ol class="rows">{% for r in b.items %}<li><div><h4>{{ r.h }}</h4><p>{{ r.p }}</p></div></li>{% endfor %}</ol>
  {%- elif b.type == "box" %}<div class="box"><h4>{{ b.title }}</h4><ol>{% for i in b.items %}<li>{{ i }}</li>{% endfor %}</ol></div>
  {%- elif b.type == "stats" %}{% if b.label %}<p class="stats-label">{{ b.label }}</p>{% endif %}<div class="stats c{{ b.cols }}">{% for s in b.items %}<div class="stat"><b>{{ s.n }}</b><span>{{ s.t }}</span>{% if s.by %}<i>{{ s.by }}</i>{% endif %}</div>{% endfor %}</div>
  {%- elif b.type == "stat" %}<div class="wide-stat"><b>{{ b.n }}</b><span>{{ b.t }}</span></div>
  {%- elif b.type == "callout" %}<div class="callout"><span class="label">{{ b.label }}</span><p>{{ b.text }}</p></div>
  {%- elif b.type == "quote" %}<p class="quote">“{{ b.text }}”</p>
  {%- elif b.type == "pull" %}<p class="pull">{{ b.text }}</p>
  {%- elif b.type == "lists" %}<div class="lists">{% for col in b.cols %}<div class="{{ 'accent' if col.accent }}"><h4><span class="hl">{{ col.h }}</span></h4><ul>{% for i in col.items %}<li>{{ i }}</li>{% endfor %}</ul></div>{% endfor %}</div>
  {%- elif b.type == "steps" %}<ol class="steps">{% for s in b.items %}<li><div><h4>{{ s.h }}</h4><p>{{ s.p }}</p></div></li>{% endfor %}</ol>
  {%- elif b.type == "bars" %}<p class="block-label">{{ b.label }}</p><div class="bars">{% for r in b.items %}<div class="bar{{ ' alert' if r.alert }}"><span>{{ r.k }}</span><span class="track"><span class="fill" style="display:block;width:{{ (r.v / b.max * 100) | round(1) }}%"></span></span><b>{{ r.n }}</b></div>{% endfor %}</div>
  {%- elif b.type == "split" %}<p class="block-label">{{ b.label }}</p><div class="split"><div class="split-bar">{% for s in b.items %}<span class="{{ 'alert' if s.alert }}" style="width:{{ s.v }}%"></span>{% endfor %}</div><div class="split-legend">{% for s in b.items %}<div class="{{ 'alert' if s.alert }}"><b>{{ s.n }}</b><span>{{ s.t }}</span></div>{% endfor %}</div></div>
  {%- elif b.type == "table" %}<p class="block-label">{{ b.label }}</p><div class="table"><div class="big"><b>{{ b.big.n }}</b><span>{{ b.big.t }}</span></div><div><table><thead><tr>{% for h in b.head %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for row in b.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table><p class="note">{{ b.note }}</p></div></div>
  {%- elif b.type == "figures" %}<div class="figures">{% for f in b.items %}<div><b>{{ f.n }}</b><span>{{ f.t }}</span></div>{% endfor %}</div>
  {%- elif b.type == "pareto" %}<div class="pareto">{% for h in [100, 64, 30, 18, 10] %}<span class="{{ 'top' if loop.index <= 2 }}" style="height:{{ h }}%"></span>{% endfor %}</div><div class="pareto-keys">{% for k in ["A", "B", "C", "D", "E"] %}<span>{{ k }}</span>{% endfor %}</div><p class="pareto-label">{{ b.label }}</p>
  {%- elif b.type == "sign" %}<p class="sign">Stiven Janaqi</p>
  {%- endif %}
  {%- endfor %}
  {%- if page.source or page.note or page.more or page.tool %}
  <div class="bottom">
    {%- if page.source %}<p class="source">{{ L.source }}: {{ page.source }}</p>{% endif %}
    {%- if page.note %}<p class="source">{{ page.note }}</p>{% endif %}
    {%- if page.more %}{% for essay in essays %}{% if essay.fileSlug.endsWith(page.more) %}<div class="link"><b>{{ L.more }}</b><span>{{ essay.data.title }}</span></div>{% endif %}{% endfor %}{% endif %}
    {%- if page.tool %}{% set tool = toolsGuide.tool[lang][page.tool] %}<div class="link"><b>{{ L.open }}: {{ tool.name }}</b><span>stivencatalyst.com{{ tool.url }}</span></div>{% endif %}
  </div>
  {%- endif %}
</section>
{%- endif %}
{%- endfor %}
</body>
</html>

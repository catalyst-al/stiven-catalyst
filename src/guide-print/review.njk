---
pagination:
  data: review.prints
  size: 1
  alias: print
---
{#- The Management Review of September 2026 in one language, as A5 pages. scripts/review.mjs prints it to PDF; the
    published site never carries this page (guide-print.11tydata.js). The text is in review.js; each page is drawn by
    print/review-page.njk, which the reader (pages/review.njk) shares. -#}
{%- set lang = print.lang -%}
{%- set R = review[lang] -%}
{%- set L = R.labels -%}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ R.name }} · {{ R.date }}</title>
<style>
{% include "print/print-head.css" %}
{% include "print/review-base.css" %}
</style>
</head>
<body class="mr">
{%- for page in R.pages %}
{%- set n = loop.index %}
{% include "print/review-page.njk" %}
{%- endfor %}
</body>
</html>

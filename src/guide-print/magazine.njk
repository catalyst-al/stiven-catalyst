---
pagination:
  data: magazine.prints
  size: 1
  alias: item
---
{#- One issue of the magazine in one language, as A5 pages. scripts/magazine.mjs prints it to PDF; the published
    site never carries this page (guide-print.11tydata.js). The text is in lib/floor (magazine.js); each page is drawn
    by print/weekly-page.njk under the name of the magazine, with the stylesheets of the Management Review, as the
    reader of the issue (pages/magazine-issue.njk) draws it. -#}
{%- set lang = item.lang -%}
{%- set issue = item.issue -%}
{%- set I = issue[lang] -%}
{%- set W = magazine.review[lang] -%}
{%- set L = W.labels -%}
{%- set essays = collections["insights" + (lang | langSuffix)] -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ magazine.names[lang].name }} · {{ magazine.labels[lang].issue }} {{ issue.number }}</title>
<style>
{% include "print/print-head.css" %}
{% include "print/review-base.css" %}
{% include "print/weekly.css" %}
</style>
</head>
<body class="mr">
{%- for page in I.pages %}
{%- set n = loop.index %}
{% include "print/weekly-page.njk" %}
{%- endfor %}
</body>
</html>

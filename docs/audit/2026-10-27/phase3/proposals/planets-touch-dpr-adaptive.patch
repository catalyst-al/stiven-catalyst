From 7419d5018e0b327aafdb2c44ac750ea1224b1cc6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 16:53:34 +0000
Subject: [PATCH] Planets hero on a touch screen: drawn at 2 pixels to the CSS
 pixel while the phone keeps up, 1.5 only once 30 frames average under 30 a
 second (audit PM-1, alternative to the fixed 1.5; needs author approval)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AtMYkgndrDbZkBjz8B5ny3
---
 src/js/cosmos.js | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/js/cosmos.js b/src/js/cosmos.js
index ce3d427e..6e90491d 100644
--- a/src/js/cosmos.js
+++ b/src/js/cosmos.js
@@ -157,6 +157,13 @@
   // fewer particles, a step at a time (1, then 0.75, then 0.5); a device that keeps up never changes.
   let quality = 1;
   const pace = { n: 0, slow: 0 };
+  // On a touch screen the canvas starts at 2 pixels to the CSS pixel, as everywhere, and stays there while the phone
+  // keeps up. If, after the warm-up, 30 frames in a row average more than 34 ms (under 30 a second; a single long frame
+  // counts as at most 100 ms), the density steps down once to 1.5, the particles unchanged; the quality steps below
+  // still follow if that is not enough. A phone that holds the frame rate keeps the sharp picture. (Audit PM-1.)
+  const coarse = Boolean(window.matchMedia?.("(pointer: coarse)").matches);
+  let densityCap = 2;
+  const budget = { n: 0, sum: 0 };
   let width = 0;
   // The scene is laid out on the whole hero (width x height, in canvas pixels), but drawn on three canvases: the planets'
   // band (this canvas: everything that moves around the light, with the stars behind it) and, where the hero is taller
@@ -231,7 +238,7 @@
   };
 
   const resize = () => {
-    dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2) * quality);
+    dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, densityCap) * quality);
     const box = root.getBoundingClientRect();
     const spot = anchor.getBoundingClientRect();
     width = Math.max(1, Math.round(box.width * dpr));
@@ -1028,6 +1035,15 @@
     const raw = now - last;
     const dt = Math.min(0.05, raw / 1000 || 0);
     last = now;
+    if (coarse && densityCap > 1.5 && time > 1.3) {
+      budget.n += 1;
+      budget.sum += Math.min(raw, 100);
+      if (budget.n >= 30) {
+        if (budget.sum / budget.n > 34) { densityCap = 1.5; resize(); pace.n = 0; pace.slow = 0; }
+        budget.n = 0;
+        budget.sum = 0;
+      }
+    }
     // Under 30 frames a second for most of a second, once the page has settled: a step down in quality.
     if (quality > 0.5 && time > 2) {
       pace.n += 1;
-- 
2.43.0

